<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_video_quality_item"
    android:paddingTop="11dp"
    android:paddingBottom="11dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="78dp"
    android:paddingStart="12dp"
    android:paddingEnd="10dp"
    android:layout_marginVertical="4dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/xhs_red"
                android:gravity="center"
                android:id="@+id/quality_badge"
                android:background="@drawable/bg_quality_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="36dp"
                android:includeFontPadding="false"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/resolution_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:ellipsize="end"
            android:id="@+id/desc_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/hint_text"
            android:ellipsize="end"
            android:id="@+id/meta_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:maxLines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/douyin_white"
        android:gravity="center"
        android:id="@+id/download_btn"
        android:background="@drawable/bg_btn_download"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="wrap_content"
        android:layout_height="34dp"
        android:minWidth="64dp"
        android:text="下载"
        android:includeFontPadding="false"
        android:layout_marginStart="12dp"
        android:paddingHorizontal="16dp"/>
</LinearLayout>
