<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="18dp"
    android:paddingEnd="18dp">
    <FrameLayout
        android:id="@+id/preview_image_panel"
        android:background="@drawable/bg_batch_preview_panel"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:clipToOutline="true">
        <ImageView
            android:id="@+id/preview_image"
            android:background="@drawable/bg_batch_image_placeholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:clipToOutline="true"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_white"
            android:gravity="center"
            android:layout_gravity="start|top"
            android:id="@+id/preview_live_badge"
            android:background="@drawable/bg_batch_live_badge"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:layout_margin="10dp"
            android:minWidth="46dp"
            android:text="实况"
            android:includeFontPadding="false"
            android:paddingHorizontal="9dp"/>
        <ImageView
            android:layout_gravity="start|center_vertical"
            android:id="@+id/preview_prev_btn"
            android:background="@drawable/bg_batch_preview_nav_btn"
            android:padding="11dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="42dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_batch_chevron_left"
            android:tint="@color/text_white"
            android:layout_marginStart="8dp"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/preview_next_btn"
            android:background="@drawable/bg_batch_preview_nav_btn"
            android:padding="11dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="42dp"
            android:layout_height="54dp"
            android:src="@drawable/ic_batch_chevron_right"
            android:tint="@color/text_white"
            android:layout_marginEnd="8dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:id="@+id/preview_info_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/xhs_red"
            android:gravity="center"
            android:id="@+id/preview_select_btn"
            android:background="@drawable/bg_batch_select_all_btn"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:minWidth="78dp"
            android:includeFontPadding="false"
            android:paddingHorizontal="14dp"/>
    </LinearLayout>
</LinearLayout>
