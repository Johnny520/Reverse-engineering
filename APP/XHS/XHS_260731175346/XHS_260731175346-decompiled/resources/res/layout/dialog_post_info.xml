<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/post_info_scroll"
    android:scrollbars="none"
    android:fadingEdgeLength="0dp"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="4dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/post_header_card"
            android:background="@drawable/bg_post_info_hero"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/xhs_red"
                android:gravity="center"
                android:background="@drawable/bg_post_info_badge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:text="笔记概览"
                android:includeFontPadding="false"
                android:paddingHorizontal="10dp"/>
            <TextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:id="@+id/post_title_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:includeFontPadding="false"
                android:textIsSelectable="true"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/post_author_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:includeFontPadding="false"
                android:textIsSelectable="true"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:id="@+id/post_red_id_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:includeFontPadding="false"
                android:textIsSelectable="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/post_stats_card"
            android:background="@drawable/bg_post_info_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingHorizontal="4dp"
            android:paddingVertical="8dp"
            android:clipToOutline="true">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/post_like_stat"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_post_info_like"
                    android:tint="@color/xhs_red"
                    android:contentDescription="点赞"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/post_like_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="点赞"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <View
                android:background="@color/divider_line"
                android:layout_width="1dp"
                android:layout_height="38dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/post_comment_stat"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_post_info_comment"
                    android:tint="@color/xhs_red"
                    android:contentDescription="评论"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/post_comment_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="评论"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <View
                android:background="@color/divider_line"
                android:layout_width="1dp"
                android:layout_height="38dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/post_share_stat"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_post_info_share"
                    android:tint="@color/xhs_red"
                    android:contentDescription="分享"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/post_share_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="分享"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <View
                android:background="@color/divider_line"
                android:layout_width="1dp"
                android:layout_height="38dp"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/post_collect_stat"
                android:layout_width="0dp"
                android:layout_height="72dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_post_info_collect"
                    android:tint="@color/xhs_red"
                    android:contentDescription="收藏"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/post_collect_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:maxLines="1"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="收藏"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="详细信息"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/post_details_container"
            android:background="@drawable/bg_post_info_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingVertical="4dp"
            android:clipToOutline="true"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="分享链接"
            android:includeFontPadding="false"
            android:layout_marginStart="4dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/post_share_link_card"
            android:background="@drawable/bg_post_info_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="68dp"
            android:paddingHorizontal="14dp"
            android:paddingVertical="12dp"
            android:clipToOutline="true">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_post_info_link"
                android:tint="@color/xhs_red"
                android:contentDescription="分享链接"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:ellipsize="end"
                android:id="@+id/post_share_link_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <ImageView
                android:id="@+id/post_share_link_copy"
                android:padding="7dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_post_info_copy"
                android:tint="@color/text_secondary"
                android:contentDescription="复制分享链接"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
