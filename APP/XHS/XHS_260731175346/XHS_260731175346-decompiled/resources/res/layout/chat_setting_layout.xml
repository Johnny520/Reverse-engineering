<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginTop="10dp"
    android:layout_marginRight="15dp">
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="15dp"
        android:paddingEnd="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="@color/text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="消息防撤回"/>
        </LinearLayout>
        <Switch
            android:id="@+id/disable_revoke"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:thumb="@drawable/switch_thumb"
            android:layout_centerVertical="true"
            android:track="@drawable/switch_track"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="55dp"
        android:layout_marginRight="20dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="15dp"
        android:paddingEnd="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="@color/text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="显示消息撤回痕迹"/>
        </LinearLayout>
        <Switch
            android:id="@+id/show_revoke_trace"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:thumb="@drawable/switch_thumb"
            android:layout_centerVertical="true"
            android:track="@drawable/switch_track"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="55dp"
        android:layout_marginRight="20dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="15dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="显示消息时间"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <Switch
            android:id="@+id/show_message_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:thumb="@drawable/switch_thumb"
            android:layout_centerVertical="true"
            android:track="@drawable/switch_track"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="55dp"
        android:layout_marginRight="20dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="15dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="消息时间格式"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/hint_text"
            android:id="@+id/message_time_format"
            android:background="@drawable/bg_douyin_edittext"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="yyyy-MM-dd HH:mm:ss"
            android:singleLine="true"
            android:inputType="text"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="示例：2026-07-16 17:11:42"/>
    </LinearLayout>
    <View
        android:background="@color/divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="55dp"
        android:layout_marginRight="20dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="15dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="隐藏正在输入状态"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <Switch
            android:id="@+id/disable_chat_typing_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/switch_thumb"
            android:layout_centerVertical="true"
            android:track="@drawable/switch_track"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="55dp"
        android:layout_marginRight="20dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="15dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="自动语音转文字"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <Switch
            android:id="@+id/auto_voice_to_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/switch_thumb"
            android:layout_centerVertical="true"
            android:track="@drawable/switch_track"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="55dp"
        android:layout_marginRight="20dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="15dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="无痕阅读私信"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <Switch
            android:id="@+id/private_read_messages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:thumb="@drawable/switch_thumb"
            android:layout_centerVertical="true"
            android:track="@drawable/switch_track"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/divider_line"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginLeft="55dp"
        android:layout_marginRight="20dp"/>
    <RelativeLayout
        android:gravity="center_vertical"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="15dp"
        android:paddingEnd="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="@color/text_primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="聊天语音转发"/>
        </LinearLayout>
        <Switch
            android:id="@+id/enable_forward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:thumb="@drawable/switch_thumb"
            android:layout_centerVertical="true"
            android:track="@drawable/switch_track"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
