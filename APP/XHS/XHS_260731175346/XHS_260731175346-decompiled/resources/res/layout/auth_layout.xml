<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_auth_dialog"
    android:paddingTop="22dp"
    android:paddingBottom="18dp"
    android:clipToPadding="false"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:paddingStart="22dp"
    android:paddingEnd="22dp">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="系统提示"
        android:includeFontPadding="false"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        android:ellipsize="middle"
        android:gravity="center"
        android:id="@+id/tv_account"
        android:background="@drawable/bg_auth_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="当前账号："
        android:maxLines="1"
        android:includeFontPadding="false"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/hint_text"
        android:gravity="start|top"
        android:id="@+id/et_input"
        android:background="@drawable/bg_auth_input"
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginTop="16dp"
        android:hint="请输入授权码"
        android:inputType="textNoSuggestions"
        android:textCursorDrawable="@null"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/warning_red"
        android:gravity="center"
        android:id="@+id/tv_warning"
        android:background="@drawable/bg_auth_warning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="免费模块请勿在国内平台传播"
        android:includeFontPadding="false"
        android:paddingHorizontal="12dp"
        android:paddingVertical="9dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp">
        <Button
            android:textSize="14sp"
            android:textColor="@color/text_primary"
            android:id="@+id/btn_cancel"
            android:background="@drawable/btn_auth_secondary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="关闭"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:paddingHorizontal="12dp"/>
        <Space
            android:layout_width="12dp"
            android:layout_height="match_parent"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/douyin_white"
            android:id="@+id/btn_confirm"
            android:background="@drawable/btn_auth_primary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="确认"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            android:backgroundTint="@null"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>
</LinearLayout>
