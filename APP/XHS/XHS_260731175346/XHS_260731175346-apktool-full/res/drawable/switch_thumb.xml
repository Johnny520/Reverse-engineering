<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="oval">
            <solid android:color="@color/switch_thumb_fill" />
            <stroke android:width="0.5dp" android:color="@color/xhs_red" />
            <size android:height="20.0dp" android:width="25.0dp" />
        </shape>
    </item>
    <item android:state_checked="false">
        <shape android:shape="oval">
            <solid android:color="@color/switch_thumb_fill" />
            <stroke android:width="0.5dp" android:color="@color/switch_thumb_stroke_off" />
            <size android:height="20.0dp" android:width="25.0dp" />
        </shape>
    </item>
</selector>
