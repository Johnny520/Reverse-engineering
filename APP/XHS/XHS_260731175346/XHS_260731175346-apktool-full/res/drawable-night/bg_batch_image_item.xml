<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="#1c1c1e" />
            <stroke android:width="2.0dp" android:color="@color/xhs_red" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1c1c1e" />
            <stroke android:width="1.0dp" android:color="#3a3a3c" />
            <corners android:radius="10.0dp" />
        </shape>
    </item>
</selector>
