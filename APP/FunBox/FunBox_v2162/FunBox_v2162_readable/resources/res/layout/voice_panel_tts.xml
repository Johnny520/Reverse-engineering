<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="28sp"
            android:textColor="@color/global_color_font"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="文字转语音"/>
        <RadioGroup
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/rg_tts_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textColor="@color/global_color_font"
                android:id="@+id/rb_type_system"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="系统TTS"/>
            <RadioButton
                android:textColor="@color/global_color_font"
                android:id="@+id/rb_type_plugin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="自定义脚本"/>
            <RadioButton
                android:textColor="@color/global_color_font"
                android:id="@+id/rb_type_yuanshen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="原神TTS"/>
            <RadioButton
                android:textColor="@color/global_color_font"
                android:id="@+id/rb_type_clone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="克隆配音"/>
        </RadioGroup>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/ll_input_area"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/global_color_font"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="转换的文字:"/>
            <EditText
                android:textColor="@color/global_color_font"
                android:gravity="top"
                android:id="@+id/input_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lines="3"
                android:layout_weight="1"
                android:contentDescription="输入转换的文字"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:id="@+id/ll_input_action"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:textSize="12sp"
                android:textColor="#ff4444"
                android:id="@+id/btn_clear_input_text"
                android:background="@drawable/text_underline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清除文字"/>
        </LinearLayout>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/global_color_font"
            android:gravity="center"
            android:id="@+id/btn_tts_ch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前配音员:"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:id="@+id/ll_switch_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="#5b01b5"
                android:id="@+id/btn_switch_character"
                android:background="@drawable/text_underline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="切换配音员"/>
            <TextView
                android:textColor="#5b01b5"
                android:id="@+id/btn_switch_engine"
                android:background="@drawable/text_underline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="切换引擎"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
        <TextView
            android:textColor="#fe1414"
            android:gravity="center_horizontal"
            android:id="@+id/tv_plugin_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="你当前使用的是第三方脚本提供的TTS转换,如有任何使用上的问题,请联系 脚本作者 ,请勿联系FunBox作者!"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"/>
        <Button
            android:layout_gravity="center_horizontal"
            android:id="@+id/btn_convert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="转换"/>
        <CheckBox
            android:layout_gravity="center_horizontal"
            android:id="@+id/cb_add_menu_msg_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="在文本消息长按菜单中添加转换"/>
        <CheckBox
            android:layout_gravity="center_horizontal"
            android:id="@+id/cb_add_menu_clone_voice_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="在语音消息长按菜单中添加克隆语音"/>
        <CheckBox
            android:layout_gravity="center_horizontal"
            android:id="@+id/cb_add_menu_input_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="在输入框中长按菜单中添加转换"/>
        <CheckBox
            android:layout_gravity="center_horizontal"
            android:id="@+id/cb_long_press_send_btn_tts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="长按发送按钮打开TTS发送"/>
        <View
            android:id="@+id/v_history_divider"
            android:background="@color/global_color_font"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:alpha="0.2"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_history_header"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/global_color_font"
                android:id="@+id/tv_history_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="历史记录"
                android:layout_weight="1"
                android:alpha="0.7"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#ff4444"
                android:id="@+id/btn_clear_history"
                android:background="@drawable/text_underline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清除记录"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_history"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
