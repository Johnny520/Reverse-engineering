<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/design_ui_radius_bg_4"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Switch
        android:id="@+id/sw_enable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="启用面板悬浮窗"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <TextView
        android:textColor="@color/global_color_desc"
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="进入 QQ 群聊时显示统一面板悬浮按钮，长按按钮可切换当前使用表情面板或语音面板。"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/global_color_font"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="悬浮图标"/>
            <ImageView
                android:id="@+id/iv_icon_preview"
                android:background="@drawable/design_ui_radius_bg_4_little_no_transparent"
                android:padding="6dp"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/float_voice_icon_def"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/btn_change_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="选择图标"
                android:textAllCaps="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
            <Button
                android:id="@+id/btn_reset_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minWidth="0dp"
                android:text="恢复默认"
                android:textAllCaps="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
