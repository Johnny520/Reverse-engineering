<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/global_color_font"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="表情包，语音包，脚本路径\10（点击路径修改）"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:foreground="@drawable/design_shape_radius">
        <TextView
            android:textSize="18dp"
            android:textColor="@color/global_color_font"
            android:gravity="top"
            android:id="@+id/outer_path_preview"
            android:background="#0000"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:hint="点击这里设置路径"
            android:contentDescription="点击这里设置路径"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"/>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/global_color_font"
        android:gravity="center"
        android:layout_gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="模块数据存储路径"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/global_color_font"
        android:gravity="top"
        android:id="@+id/common_path_preview"
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"/>
</LinearLayout>
