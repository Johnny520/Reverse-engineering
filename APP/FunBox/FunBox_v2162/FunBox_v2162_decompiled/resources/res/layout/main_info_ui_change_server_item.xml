<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="48dp">
    <TextView
        android:textSize="16sp"
        android:textColor="@color/global_color_font"
        android:id="@+id/main_info_ui_server_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CloudFlareCDN:"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:layout_toStartOf="@+id/main_info_ui_server_item_latency"/>
    <TextView
        android:textSize="16sp"
        android:textColor="@color/global_color_font"
        android:id="@+id/main_info_ui_server_item_latency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="110ms"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>
