<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/main_ui_background_container"
        android:scaleType="centerCrop"/>
    <LinearLayout
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/btn_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true">
                <ImageView
                    android:id="@+id/head_icon_left"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/app_design_icon"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="32sp"
                    android:typeface="serif"
                    android:textStyle="bold"
                    android:textColor="#aaaa11"
                    android:id="@+id/head_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FunBox"/>
                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:src="@drawable/app_design_icon"
                    android:layout_marginStart="6dp"/>
            </LinearLayout>
        </RelativeLayout>
        <HorizontalScrollView
            android:id="@+id/tab_scroll"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <FrameLayout
                android:id="@+id/tab_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <View
                    android:id="@+id/tab_indicator"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/tab_items_container"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
        </HorizontalScrollView>
        <ScrollView
            android:id="@+id/content_scroll"
            android:background="@drawable/design_ui_radius_bg_4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:fillViewport="true"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/container"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </LinearLayout>
    <fun.box001.ui.DandelionEffectView
        android:id="@+id/dandelion_effect"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <fun.box001.ui.MeteorEffectView
        android:id="@+id/meteor_effect"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
    <fun.box001.ui.RainEffectView
        android:id="@+id/rain_effect"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"/>
</RelativeLayout>
