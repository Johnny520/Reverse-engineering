<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="16.0sp" android:textColor="@color/global_color_font" android:padding="10.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="脚本ID:" />
            <EditText android:id="@id/ed_plugin_id" android:padding="10.0dp" android:layout_width="0.0dp" android:layout_height="wrap_content" android:hint="请输入脚本ID" android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="16.0sp" android:textColor="@color/global_color_font" android:padding="10.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="脚本名字:" />
            <EditText android:id="@id/ed_plugin_name" android:padding="10.0dp" android:layout_width="0.0dp" android:layout_height="wrap_content" android:hint="请输入脚本名字" android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="16.0sp" android:textColor="@color/global_color_font" android:padding="10.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="脚本作者:" />
            <EditText android:id="@id/ed_plugin_author" android:padding="10.0dp" android:layout_width="0.0dp" android:layout_height="wrap_content" android:hint="请输入脚本作者" android:layout_weight="1.0" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="16.0sp" android:textColor="@color/global_color_font" android:padding="10.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="脚本版本号:" />
            <EditText android:id="@id/ed_plugin_ver" android:padding="10.0dp" android:layout_width="0.0dp" android:layout_height="wrap_content" android:hint="请输入脚本版本号" android:layout_weight="1.0" />
        </LinearLayout>
        <TextView android:textSize="16.0sp" android:textColor="@color/global_color_font" android:padding="10.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="脚本描述:" />
        <EditText android:textSize="12.0sp" android:gravity="top" android:id="@id/ed_plugin_desc" android:padding="10.0dp" android:layout_width="match_parent" android:layout_height="180.0dp" android:hint="请输入脚本描述" />
        <TextView android:textSize="16.0sp" android:textColor="@color/global_color_font" android:padding="10.0dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="脚本类型" />
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <CheckBox android:id="@id/cb_type_tts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TTS文字转语音" />
            <CheckBox android:id="@id/cb_type_image_op" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="表情包预处理" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10.0dp">
            <CheckBox android:id="@id/cb_type_image_search" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="在线表情包搜索" />
            <CheckBox android:id="@id/cb_type_voice_search" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="在线语音搜索" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10.0dp">
            <CheckBox android:id="@id/cb_type_menu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="菜单消息处理" />
            <CheckBox android:id="@id/cb_type_translate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="聊天消息翻译" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
