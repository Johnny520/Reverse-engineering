<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/hidden_contact_item_root"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:ellipsize="end"
            android:id="@+id/hidden_contact_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hidden_contact_item_name"
            android:maxLines="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:ellipsize="middle"
            android:id="@+id/hidden_contact_item_identity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/hidden_contact_item_uid"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/dy_feed_green"
        android:id="@+id/hidden_contact_item_action"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/hidden_contact_item_add"
        android:includeFontPadding="false"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="8dp"/>
</LinearLayout>
