<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/spark_custom_renew_root"
    android:background="@color/dy_feed_bg"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/card_search"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/dy_feed_text_primary"
            android:textColorHint="@color/dy_feed_text_tertiary"
            android:id="@+id/et_search"
            android:background="@android:color/transparent"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="搜索昵称、UID 或会话 ID"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/sv_spark_custom_renew"
        android:background="@drawable/bg_feed_card_rounded"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="10dp"
        android:fillViewport="false"
        android:fadeScrollbars="false">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/list_container"
            android:background="@color/dy_feed_card_bg"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dy_feed_footnote"
        android:gravity="center"
        android:id="@+id/tv_spark_custom_renew_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="DyHelper · 勾选后会写入自定义续火人员规则"
        android:includeFontPadding="false"/>
</LinearLayout>
