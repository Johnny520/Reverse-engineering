<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/item_root"
    android:background="@color/dy_feed_card_bg"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:ellipsize="end"
            android:id="@+id/tv_author"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="用户"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_green"
            android:id="@+id/tv_tag"
            android:background="@drawable/bg_feed_badge"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="默认"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_blue"
            android:id="@+id/tv_status"
            android:background="@drawable/bg_feed_badge"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已关注"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/dy_feed_text_secondary"
        android:ellipsize="end"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="评论内容"
        android:maxLines="2"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/dy_feed_red"
        android:ellipsize="end"
        android:id="@+id/tv_new_reply_preview"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="新增回复预览"
        android:maxLines="2"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/dy_feed_text_tertiary"
        android:ellipsize="end"
        android:id="@+id/tv_remark"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="备注信息"
        android:maxLines="1"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dy_feed_text_tertiary"
        android:id="@+id/tv_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="点击查看新回复，长按删除"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_actions"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp">
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_view_replies"
            android:background="@drawable/bg_feed_btn_primary"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="查看回复"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_tertiary"
            android:gravity="center"
            android:id="@+id/btn_mark_read"
            android:background="@drawable/bg_feed_btn_secondary"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="标已读"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_tertiary"
            android:gravity="center"
            android:id="@+id/btn_jump"
            android:background="@drawable/bg_feed_btn_secondary"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="跳转"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
