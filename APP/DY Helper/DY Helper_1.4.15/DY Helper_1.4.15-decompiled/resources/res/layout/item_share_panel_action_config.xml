<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/share_action_item_root"
    android:background="@color/dy_feed_card_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="6dp"
    android:paddingEnd="6dp">
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="@color/dy_feed_text_secondary"
        android:id="@+id/share_action_item_category"
        android:paddingTop="10dp"
        android:paddingBottom="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/share_action_item_row"
        android:background="@color/dy_feed_card_bg"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="58dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">
        <CheckBox
            android:id="@+id/share_action_item_checkbox"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="24dp"
            android:minHeight="24dp"
            android:layout_marginEnd="7dp"
            android:buttonTint="@color/dy_feed_blue"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/dy_feed_text_primary"
                android:ellipsize="end"
                android:id="@+id/share_action_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/dy_feed_text_secondary"
                android:ellipsize="end"
                android:id="@+id/share_action_item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:maxLines="2"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
