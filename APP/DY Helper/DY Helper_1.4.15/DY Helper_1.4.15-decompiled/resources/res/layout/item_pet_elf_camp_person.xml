<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/camp_person_root"
    android:background="@color/dy_feed_card_bg"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?android:attr/selectableItemBackground"
    android:minHeight="76dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:ellipsize="end"
            android:id="@+id/camp_person_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/camp_person_badge"
            android:background="@drawable/bg_feed_badge"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/dy_feed_text_secondary"
        android:ellipsize="end"
        android:id="@+id/camp_person_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dy_feed_text_tertiary"
        android:ellipsize="end"
        android:id="@+id/camp_person_rule_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="1"/>
</LinearLayout>
