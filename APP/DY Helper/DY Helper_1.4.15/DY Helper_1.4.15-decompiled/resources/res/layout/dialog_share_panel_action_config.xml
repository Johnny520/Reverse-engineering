<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/share_action_config_root"
    android:background="@color/dy_feed_bg"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/share_action_config_top_bar"
        android:background="@color/dy_feed_card_bg"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:id="@+id/share_action_config_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="分享快捷按钮"
            android:includeFontPadding="false"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/share_action_config_close"
            android:background="@drawable/bg_feed_close_btn"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="×"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_blue"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/share_action_config_count"
            android:background="@drawable/bg_feed_badge"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:minWidth="56dp"
            android:text="已选 0 项"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </FrameLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/dy_feed_text_secondary"
        android:id="@+id/share_action_config_hint"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="快捷操作按目录顺序显示；预览会实时呈现当前草稿。"
        android:includeFontPadding="false"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/share_action_config_tabs"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="3dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:id="@+id/share_action_config_tab_config"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="配置"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/share_action_config_tab_preview"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="预览"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/share_action_config_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/share_action_config_list"
            android:background="@drawable/bg_feed_card_rounded"
            android:padding="2dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@color/dy_feed_divider"
            android:dividerHeight="1px"
            android:fadeScrollbars="false"/>
        <ScrollView
            android:id="@+id/share_action_config_preview_page"
            android:background="@color/dy_feed_card_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/share_action_config_preview_container"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="240dp"/>
        </ScrollView>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/share_action_config_bottom"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <Button
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/share_action_config_cancel"
            android:background="@drawable/bg_feed_btn_secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="取消"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:textAlignment="center"
            android:layout_marginEnd="4dp"/>
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/share_action_config_save"
            android:background="@drawable/bg_feed_btn_primary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="保存"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:textAlignment="center"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dy_feed_footnote"
        android:gravity="center"
        android:id="@+id/share_action_config_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="DyHelper · 分享面板"
        android:includeFontPadding="false"/>
</LinearLayout>
