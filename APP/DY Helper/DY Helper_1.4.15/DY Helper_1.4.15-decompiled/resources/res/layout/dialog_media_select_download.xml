<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/mediaSelectRoot"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="320dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/mediaSelectCard"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:id="@+id/tvDialogTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="选择要下载的内容"/>
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/tvSelectSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="已选 0/0 项"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/tvSelectMode"
                android:paddingLeft="9dp"
                android:paddingTop="4dp"
                android:paddingRight="9dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="多选"
                android:includeFontPadding="false"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="12dp">
            <ImageView
                android:id="@+id/ivMainPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"/>
            <ProgressBar
                android:layout_gravity="center"
                android:id="@+id/progressMainPreview"
                android:visibility="gone"
                android:layout_width="42dp"
                android:layout_height="42dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tvMainVideoHint"
                android:paddingLeft="14dp"
                android:paddingTop="8dp"
                android:paddingRight="14dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="动图资源"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:background="#aa000000"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:layout_width="match_parent"
                android:layout_height="56dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="#ffffff"
                        android:id="@+id/tvMainTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="第 1 页"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#dddddd"
                        android:id="@+id/tvMainType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="图片"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:layout_gravity="end|bottom"
                android:id="@+id/tvMainCheck"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginBottom="68dp"
                android:text="✓"
                android:includeFontPadding="false"
                android:layout_marginEnd="12dp"/>
        </FrameLayout>
        <HorizontalScrollView
            android:id="@+id/hsMediaThumbs"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_marginTop="10dp"
            android:fillViewport="false"
            android:overScrollMode="never">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llMediaThumbs"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"/>
        </HorizontalScrollView>
        <ScrollView
            android:id="@+id/svMediaGrid"
            android:paddingBottom="4dp"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="420dp"
            android:layout_marginTop="12dp"
            android:overScrollMode="never">
            <GridLayout
                android:orientation="horizontal"
                android:id="@+id/glMediaGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"/>
        </ScrollView>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="12dp">
            <Button
                android:textSize="13sp"
                android:gravity="center"
                android:id="@+id/btnSelectAll"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="全选"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:textAllCaps="false"/>
            <Space
                android:layout_width="8dp"
                android:layout_height="1dp"/>
            <Button
                android:textSize="13sp"
                android:gravity="center"
                android:id="@+id/btnInvertSelect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="反选"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:textAllCaps="false"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp">
            <Button
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="取消"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:textAllCaps="false"/>
            <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/btnDownloadSelected"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="下载"
                android:includeFontPadding="false"
                android:layout_weight="2"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
