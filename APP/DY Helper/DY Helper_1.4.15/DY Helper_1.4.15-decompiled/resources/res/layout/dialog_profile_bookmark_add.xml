<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/dialog_root"
    android:background="@color/dy_feed_bg"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <FrameLayout
        android:id="@+id/top_bar"
        android:background="@drawable/bg_feed_card_rounded"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:elevation="2dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="添加主页书签"
            android:includeFontPadding="false"
            android:textAlignment="center"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_close"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="取消"
            android:includeFontPadding="false"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/info_card"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:elevation="2dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:id="@+id/tv_nickname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="用户昵称"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:ellipsize="end"
            android:id="@+id/tv_signature"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="个性签名内容..."
            android:maxLines="2"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/form_card"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:elevation="2dp">
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_tertiary"
            android:id="@+id/tv_category_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择分类"
            android:includeFontPadding="false"/>
        <FrameLayout
            android:id="@+id/category_box"
            android:background="@drawable/bg_feed_input_bg"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="6dp">
            <Spinner
                android:id="@+id/spinner_category"
                android:background="@android:color/transparent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:spinnerMode="dropdown"
                android:alpha="0"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/dy_feed_text_primary"
                android:gravity="center_vertical"
                android:id="@+id/tv_category_value"
                android:background="@android:color/transparent"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="默认"
                android:includeFontPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="32dp"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/iv_category_arrow"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@android:drawable/arrow_down_float"
                android:contentDescription="dropdown"
                android:alpha="0.5"
                android:importantForAccessibility="no"
                android:layout_marginEnd="12dp"/>
        </FrameLayout>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_tertiary"
            android:id="@+id/tv_remark_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="备注 (可选)"
            android:includeFontPadding="false"/>
        <EditText
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_primary"
            android:textColorHint="@color/dy_feed_text_tertiary"
            android:gravity="start|top"
            android:id="@+id/et_remark"
            android:background="@drawable/bg_feed_input_bg"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:minHeight="42dp"
            android:hint="输入备注信息..."
            android:cursorVisible="true"
            android:maxLines="2"
            android:includeFontPadding="false"
            android:inputType="textMultiLine"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:importantForAutofill="no"/>
    </LinearLayout>
    <Button
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/btn_save"
        android:background="@drawable/bg_feed_btn_primary"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="保存书签"
        android:includeFontPadding="false"
        android:textAllCaps="false"
        android:textAlignment="center"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/dy_feed_footnote"
        android:gravity="center"
        android:id="@+id/tv_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="DyHelper · 添加书签后该用户发布新作品将通过系统通知提醒"
        android:includeFontPadding="false"/>
</LinearLayout>
