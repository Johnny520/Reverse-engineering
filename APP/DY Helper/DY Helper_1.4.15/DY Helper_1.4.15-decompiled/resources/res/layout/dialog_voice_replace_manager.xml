<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/voice_manager_root"
    android:background="@color/dy_feed_bg"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="520dp">
    <FrameLayout
        android:id="@+id/voice_manager_top_bar"
        android:background="@color/dy_feed_card_bg"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_voice_close"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="取消"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:id="@+id/tv_voice_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="音频管理器"
            android:includeFontPadding="false"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_green"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tv_voice_badge"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:minWidth="48dp"
            android:text="0 个"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"/>
    </FrameLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/dy_feed_text_secondary"
        android:id="@+id/tv_voice_hint"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="选择一个音频替换本次录音。评论区音频超过 30 秒会自动裁切。"
        android:includeFontPadding="false"/>
    <FrameLayout
        android:background="@drawable/bg_feed_card_rounded"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/list_voice_audio"
            android:padding="2dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@color/dy_feed_divider"
            android:dividerHeight="1px"
            android:fadeScrollbars="false"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/tv_voice_empty"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="暂无音频\10点击下方添加音频"
            android:includeFontPadding="false"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/panel_voice_playback"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:id="@+id/tv_voice_playback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="准备播放音频"
            android:includeFontPadding="false"/>
        <ProgressBar
            android:id="@+id/progress_voice_playback"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/panel_voice_progress"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="10dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:id="@+id/tv_voice_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="准备处理音频"
            android:includeFontPadding="false"/>
        <ProgressBar
            android:id="@+id/progress_voice_process"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="8dp"
            android:max="100"
            android:progress="0"
            android:indeterminate="false"
            style="?android:attr/progressBarStyleHorizontal"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <Button
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/btn_voice_add"
            android:background="@drawable/bg_feed_btn_secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="添加音频"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/btn_voice_original"
            android:background="@drawable/bg_feed_btn_secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="发送原音频"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dy_feed_footnote"
        android:gravity="center"
        android:id="@+id/tv_voice_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="DyHelper · Voice Replace"
        android:includeFontPadding="false"/>
</LinearLayout>
