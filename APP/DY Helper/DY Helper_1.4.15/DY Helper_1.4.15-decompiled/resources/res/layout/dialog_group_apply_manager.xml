<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/group_apply_dialog_root"
    android:paddingTop="8dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <TextView
            android:textSize="13sp"
            android:gravity="center"
            android:id="@+id/group_apply_tv_close"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:text="关闭"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/group_apply_tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="群管理"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/group_apply_tv_count"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:text="0"/>
    </LinearLayout>
    <View
        android:id="@+id/group_apply_top_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <TextView
        android:textSize="11sp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/group_apply_tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="42dp"
        android:text="正在加载可管理群"
        android:maxLines="2"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="340dp">
        <ListView
            android:id="@+id/group_apply_list"
            android:scrollbars="vertical"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:overScrollMode="never"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/group_apply_tv_empty"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="正在加载入群申请"/>
    </FrameLayout>
    <View
        android:id="@+id/group_apply_bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/group_apply_action_reload"
            android:layout_width="84dp"
            android:layout_height="38dp"
            android:text="刷新"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/group_apply_action_approve_all"
            android:layout_width="128dp"
            android:layout_height="40dp"
            android:text="一键通过 0 人"/>
    </LinearLayout>
</LinearLayout>
