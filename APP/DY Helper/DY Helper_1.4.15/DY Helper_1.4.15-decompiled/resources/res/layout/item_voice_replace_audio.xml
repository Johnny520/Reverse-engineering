<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/item_voice_root"
    android:background="@color/dy_feed_card_bg"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:ellipsize="middle"
            android:id="@+id/tv_audio_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:ellipsize="end"
            android:id="@+id/tv_audio_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <Button
        android:textSize="11sp"
        android:textColor="@color/dy_feed_blue"
        android:gravity="center"
        android:id="@+id/btn_audio_play"
        android:background="@drawable/bg_feed_btn_secondary"
        android:layout_width="52dp"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="播放"
        android:includeFontPadding="false"
        android:textAllCaps="false"
        android:layout_marginStart="8dp"/>
    <Button
        android:textSize="11sp"
        android:textColor="@color/dy_feed_red"
        android:gravity="center"
        android:id="@+id/btn_audio_delete"
        android:background="@drawable/bg_feed_btn_secondary"
        android:layout_width="52dp"
        android:layout_height="34dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="删除"
        android:includeFontPadding="false"
        android:textAllCaps="false"
        android:layout_marginStart="6dp"/>
</LinearLayout>
