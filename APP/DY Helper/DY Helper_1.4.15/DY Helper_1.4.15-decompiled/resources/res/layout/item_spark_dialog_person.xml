<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/row_spark_person_root"
    android:background="@color/dy_feed_card_bg"
    android:paddingTop="7dp"
    android:paddingBottom="7dp"
    android:focusable="true"
    android:clickable="true"
    android:longClickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:minHeight="52dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <TextView
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="@color/dy_feed_blue"
        android:gravity="center"
        android:id="@+id/tv_spark_day"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:text="0"
        android:includeFontPadding="false"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_primary"
            android:ellipsize="end"
            android:id="@+id/tv_spark_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="昵称"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dy_feed_text_tertiary"
            android:ellipsize="end"
            android:id="@+id/tv_spark_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="UID · 火花"
            android:maxLines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp">
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:id="@+id/tv_spark_state"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="状态"
            android:includeFontPadding="false"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:id="@+id/tv_spark_custom_badge"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="续火关"
            android:includeFontPadding="false"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"/>
    </LinearLayout>
</LinearLayout>
