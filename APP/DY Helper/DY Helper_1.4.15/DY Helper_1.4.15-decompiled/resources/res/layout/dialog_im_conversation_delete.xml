<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/im_delete_dialog_root"
    android:paddingTop="8dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <TextView
            android:textSize="13sp"
            android:gravity="center"
            android:id="@+id/im_delete_tv_close"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:text="关闭"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/im_delete_tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="批量删除会话"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/im_delete_tv_count"
            android:layout_width="48dp"
            android:layout_height="28dp"
            android:text="0/0"/>
    </LinearLayout>
    <View
        android:id="@+id/im_delete_top_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <EditText
        android:textSize="14sp"
        android:id="@+id/im_delete_et_search"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp"
        android:hint="搜索名称、UID、会话 ID"
        android:singleLine="true"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:importantForAutofill="no"/>
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:fillViewport="true"
        android:overScrollMode="never">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/im_delete_filter_group"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="2dp"
            android:paddingEnd="2dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/im_delete_filter_all"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:text="全部"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/im_delete_filter_fan"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:text="粉丝"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/im_delete_filter_stranger"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:text="陌生人"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/im_delete_filter_mutual"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:text="互关"
                android:layout_marginStart="4dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:id="@+id/im_delete_filter_following"
                android:layout_width="72dp"
                android:layout_height="32dp"
                android:text="已关注"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </HorizontalScrollView>
    <TextView
        android:textSize="11sp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/im_delete_tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="34dp"
        android:text="正在加载会话"
        android:maxLines="2"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="310dp">
        <ListView
            android:id="@+id/im_delete_list"
            android:scrollbars="vertical"
            android:fadingEdge="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:overScrollMode="never"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/im_delete_tv_empty"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="正在加载会话"/>
    </FrameLayout>
    <View
        android:id="@+id/im_delete_bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/im_delete_action_select_all"
            android:layout_width="64dp"
            android:layout_height="38dp"
            android:text="全选"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/im_delete_action_invert"
            android:layout_width="64dp"
            android:layout_height="38dp"
            android:text="反选"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/im_delete_action_stop"
            android:visibility="gone"
            android:layout_width="96dp"
            android:layout_height="38dp"
            android:text="停止后续删除"/>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/im_delete_action_delete"
            android:layout_width="112dp"
            android:layout_height="40dp"
            android:text="删除 0 个"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/im_delete_action_clear_interactive"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="2dp"
        android:text="清理全部互动消息"/>
</LinearLayout>
