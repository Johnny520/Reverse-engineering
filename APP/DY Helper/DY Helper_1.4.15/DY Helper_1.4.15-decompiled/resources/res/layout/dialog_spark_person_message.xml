<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/spark_person_message_scroll"
    android:background="@color/dy_feed_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">
    <FrameLayout
        android:id="@+id/spark_person_message_scroll_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/spark_person_message_root"
            android:background="@color/dy_feed_bg"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/person_message_top_bar"
                android:background="@color/dy_feed_card_bg"
                android:layout_width="match_parent"
                android:layout_height="42dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_text_primary"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_person_title"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="人员续火消息"
                    android:includeFontPadding="false"
                    android:paddingEnd="52dp"/>
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_blue"
                    android:gravity="center"
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/btn_person_message_help"
                    android:background="@drawable/bg_feed_btn_secondary"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="!"
                    android:includeFontPadding="false"/>
            </FrameLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/dy_feed_text_secondary"
                android:id="@+id/tv_person_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="可给该人员单独设置固定文本或 API 消息源"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_person_source"
                android:background="@drawable/bg_feed_card_rounded"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="消息来源"
                    android:includeFontPadding="false"/>
                <RadioGroup
                    android:orientation="vertical"
                    android:id="@+id/rg_message_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <RadioButton
                        android:textSize="13sp"
                        android:textColor="@color/dy_feed_text_primary"
                        android:id="@+id/rb_source_default"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="跟随全局"/>
                    <RadioButton
                        android:textSize="13sp"
                        android:textColor="@color/dy_feed_text_primary"
                        android:id="@+id/rb_source_custom"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="固定文本"/>
                    <RadioButton
                        android:textSize="13sp"
                        android:textColor="@color/dy_feed_text_primary"
                        android:id="@+id/rb_source_hitokoto"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="一言"/>
                    <RadioButton
                        android:textSize="13sp"
                        android:textColor="@color/dy_feed_text_primary"
                        android:id="@+id/rb_source_jinrishici"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:text="今日诗词"/>
                </RadioGroup>
            </LinearLayout>
            <EditText
                android:textSize="13sp"
                android:textColor="@color/dy_feed_text_primary"
                android:textColorHint="@color/dy_feed_text_tertiary"
                android:gravity="start|top"
                android:id="@+id/et_person_message"
                android:background="@drawable/bg_feed_card_rounded"
                android:padding="12dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="10dp"
                android:hint="输入该人员专属固定文本"
                android:maxLength="80"
                android:inputType="textMultiLine"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_fake_spark_days"
                android:background="@drawable/bg_feed_card_rounded"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_text_primary"
                    android:id="@+id/tv_fake_days_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="伪装火花天数"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/dy_feed_text_secondary"
                    android:id="@+id/tv_fake_days_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="留空表示不伪装，仅影响本地显示"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="@color/dy_feed_text_primary"
                    android:textColorHint="@color/dy_feed_text_tertiary"
                    android:gravity="center_vertical"
                    android:id="@+id/et_fake_spark_days"
                    android:background="@drawable/bg_feed_btn_secondary"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:hint="例如 520"
                    android:maxLength="4"
                    android:inputType="number"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btn_test_send_spark_renew"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:text="测试发送续火消息"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btn_complete_pet_task"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="完成火星任务"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/dy_feed_footnote"
                android:gravity="center"
                android:id="@+id/tv_person_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="DyHelper · API 获取失败时会回退全局固定文本"/>
        </LinearLayout>
    </FrameLayout>
</ScrollView>
