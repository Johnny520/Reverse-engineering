<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/camp_seed_root"
    android:background="@drawable/bg_feed_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/camp_seed_close"
            android:background="@drawable/bg_feed_close_btn"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="×"
            android:contentDescription="关闭"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="选择固定种子"
            android:paddingStart="48dp"
            android:paddingEnd="48dp"/>
    </FrameLayout>
    <View
        android:background="@color/dy_feed_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/camp_seed_hint_card"
            android:background="@drawable/bg_feed_card_rounded"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/dy_feed_text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="可选种子"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/dy_feed_text_secondary"
                android:id="@+id/camp_seed_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="仅显示当前等级已解锁且仍在商店出售的种子"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/camp_seed_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:text="暂无可选择的种子\10请先刷新营地等级或等待作物目录更新"
            android:layout_weight="1"/>
        <ListView
            android:id="@+id/camp_seed_list"
            android:background="@drawable/bg_feed_card_rounded"
            android:padding="2dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:divider="@color/dy_feed_divider"
            android:dividerHeight="1px"
            android:layout_weight="1"
            android:fadeScrollbars="false"/>
        <TextView
            android:textSize="10sp"
            android:textColor="@color/dy_feed_footnote"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="选择后立即保存到当前人员，种地前仍会实时校验"/>
    </LinearLayout>
</LinearLayout>
