<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/noticeRoot"
    android:background="@drawable/bg_beta_notice_dialog"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true">
    <FrameLayout
        android:id="@+id/noticeHeader"
        android:background="@drawable/bg_beta_notice_header"
        android:layout_width="match_parent"
        android:layout_height="44dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:id="@+id/tvNoticeTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="DYHelper 公告"
            android:includeFontPadding="false"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"/>
        <ImageButton
            android:layout_gravity="start|center_vertical"
            android:id="@+id/btnClose"
            android:background="@drawable/bg_beta_notice_close"
            android:padding="8dp"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/ic_op_close"
            android:scaleType="centerInside"
            android:tint="@color/dy_feed_text_secondary"
            android:contentDescription="关闭公告"
            android:layout_marginStart="5dp"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_blue"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tvNoticeHeaderBadge"
            android:background="@drawable/bg_beta_notice_badge"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="内测"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="10dp"/>
    </FrameLayout>
    <ScrollView
        android:id="@+id/noticeScroll"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fillViewport="false"
        android:fadeScrollbars="false"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/noticeLatestCard"
                android:background="@drawable/bg_beta_notice_card"
                android:padding="14dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/dy_feed_text_primary"
                        android:id="@+id/tvNoticeLatestTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="最新公告"
                        android:includeFontPadding="false"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="@color/dy_feed_blue"
                        android:id="@+id/tvNoticeDate"
                        android:background="@drawable/bg_beta_notice_badge"
                        android:paddingTop="3dp"
                        android:paddingBottom="3dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:includeFontPadding="false"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"/>
                </LinearLayout>
                <View
                    android:id="@+id/noticeContentDivider"
                    android:background="@color/dy_feed_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginTop="10dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/dy_feed_text_primary"
                    android:id="@+id/tvNoticeContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text=""
                    android:lineSpacingExtra="5dp"
                    android:textIsSelectable="true"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_text_primary"
                    android:id="@+id/tvNoticeHistoryTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="历史公告"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_blue"
                    android:id="@+id/tvHistoryCount"
                    android:background="@drawable/bg_beta_notice_badge"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="暂无"
                    android:includeFontPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/historyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/dy_feed_text_secondary"
                android:gravity="center"
                android:id="@+id/tvEmptyHistory"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="暂无历史公告"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp">
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/btnCopy"
            android:background="@drawable/bg_beta_notice_secondary_button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="复制公告"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginEnd="8dp"/>
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_bg"
            android:gravity="center"
            android:id="@+id/btnKnown"
            android:background="@drawable/bg_beta_notice_primary_button"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="我知道了"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dy_feed_footnote"
        android:gravity="center"
        android:id="@+id/tvNoticeFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="DYHelper · 内测公告"
        android:includeFontPadding="false"/>
</LinearLayout>
