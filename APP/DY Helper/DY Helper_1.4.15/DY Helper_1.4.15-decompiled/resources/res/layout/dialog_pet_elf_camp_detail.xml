<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/camp_detail_root"
    android:background="@drawable/bg_feed_dialog_root"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:ellipsize="end"
            android:id="@+id/camp_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="营地详情"
            android:maxLines="1"
            android:layout_weight="1"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/camp_detail_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="×"
            android:contentDescription="关闭"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/dy_feed_text_secondary"
        android:id="@+id/camp_detail_status"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_primary"
            android:id="@+id/camp_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textIsSelectable="true"
            android:paddingStart="2dp"
            android:paddingEnd="2dp"/>
    </ScrollView>
</LinearLayout>
