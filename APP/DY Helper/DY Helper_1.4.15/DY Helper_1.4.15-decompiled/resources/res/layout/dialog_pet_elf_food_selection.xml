<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/pet_food_root"
    android:paddingTop="20dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="19sp"
        android:textStyle="bold"
        android:id="@+id/pet_food_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="选择自动投喂食物"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <TextView
        android:textSize="12sp"
        android:id="@+id/pet_food_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"/>
    <ScrollView
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioGroup
                android:orientation="vertical"
                android:id="@+id/pet_food_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="13sp"
                android:gravity="center"
                android:id="@+id/pet_food_empty"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:text="暂无食物目录"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/pet_food_refresh"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="72dp"
            android:text="更新列表"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/pet_food_cancel"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="56dp"
            android:text="取消"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:id="@+id/pet_food_confirm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="56dp"
            android:text="确定"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
</LinearLayout>
