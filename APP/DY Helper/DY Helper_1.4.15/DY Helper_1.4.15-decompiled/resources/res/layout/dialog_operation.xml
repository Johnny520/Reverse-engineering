<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/op_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/op_handle"
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="4dp"/>
    <RelativeLayout
        android:id="@+id/op_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <ImageView
            android:id="@+id/op_iv_close"
            android:padding="13dp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="fitCenter"
            android:contentDescription="@string/operation_close"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center_vertical"
            android:id="@+id/op_tv_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/operation_title"
            android:layout_marginStart="16dp"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/op_tv_mode"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:layout_centerVertical="true"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="9dp"
            android:layout_toStartOf="@+id/op_iv_close"
            android:layout_toEndOf="@+id/op_tv_title"/>
        <View
            android:id="@+id/op_bar_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <FrameLayout
        android:id="@+id/op_summary_host"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/op_quick_header"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:id="@+id/op_quick_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/operation_quick_title"
            android:layout_weight="1"/>
        <TextView
            android:textSize="11sp"
            android:gravity="center"
            android:id="@+id/op_quick_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="42dp"
            android:text="1 / 1"/>
        <ImageView
            android:id="@+id/op_quick_edit"
            android:padding="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/operation_quick_customize"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/op_quick_pager"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp">
        <ImageView
            android:id="@+id/op_quick_previous"
            android:padding="8dp"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:contentDescription="@string/operation_quick_previous"/>
        <FrameLayout
            android:id="@+id/op_quick_viewport"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/op_quick_actions"
                android:layout_width="match_parent"
                android:layout_height="72dp"/>
        </FrameLayout>
        <ImageView
            android:id="@+id/op_quick_next"
            android:padding="8dp"
            android:layout_width="36dp"
            android:layout_height="48dp"
            android:contentDescription="@string/operation_quick_next"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/op_tab_container"
        android:padding="3dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">
        <TextView
            android:textSize="13sp"
            android:gravity="center"
            android:id="@+id/op_tab_work"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/operation_tab_work"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:gravity="center"
            android:id="@+id/op_tab_tools"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/operation_tab_tools"
            android:layout_weight="1"/>
    </LinearLayout>
    <ScrollView
        android:id="@+id/op_scroll"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/op_content"
            android:paddingTop="4dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </ScrollView>
    <View
        android:id="@+id/op_bottom_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/op_settings_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:paddingStart="18dp"
        android:paddingEnd="12dp">
        <ImageView
            android:id="@+id/op_settings_icon"
            android:padding="2dp"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/operation_settings"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:id="@+id/op_settings_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/operation_settings"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:id="@+id/op_settings_chevron"
            android:padding="7dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@string/operation_settings_open"/>
    </LinearLayout>
</LinearLayout>
