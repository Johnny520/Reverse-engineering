<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/settings_top"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="30sp"
                android:textStyle="bold"
                android:id="@+id/settings_tv_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="设置"
                android:layout_weight="1"/>
            <TextView
                android:textSize="22sp"
                android:gravity="center"
                android:id="@+id/settings_tv_close"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:text="×"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:id="@+id/settings_tv_subtitle"
            android:paddingTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DY Helper · 分类、搜索与高级选项"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/settings_search_wrap"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/settings_search_inner"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="11dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="18sp"
                android:gravity="center"
                android:id="@+id/settings_tv_search_icon"
                android:layout_width="24dp"
                android:layout_height="36dp"
                android:text="⌕"/>
            <EditText
                android:textSize="15sp"
                android:id="@+id/settings_et_search"
                android:background="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:cursorVisible="true"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionSearch"/>
            <TextView
                android:textSize="14sp"
                android:gravity="center"
                android:id="@+id/settings_tv_clear"
                android:visibility="gone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:text="×"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/settings_tab_wrap"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/settings_tab_container"
            android:padding="3dp"
            android:layout_width="match_parent"
            android:layout_height="38dp">
            <TextView
                android:textSize="12sp"
                android:gravity="center"
                android:id="@+id/settings_tab_all"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="全部"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center"
                android:id="@+id/settings_tab_video"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="视频"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center"
                android:id="@+id/settings_tab_comment"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="评论"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center"
                android:id="@+id/settings_tab_appearance"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="外观"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center"
                android:id="@+id/settings_tab_tools"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="工具"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:gravity="center"
                android:id="@+id/settings_tab_im"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="私信"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
    <ScrollView
        android:id="@+id/settings_scroll"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/settings_content"
            android:paddingTop="8dp"
            android:paddingBottom="36dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
    </ScrollView>
</LinearLayout>
