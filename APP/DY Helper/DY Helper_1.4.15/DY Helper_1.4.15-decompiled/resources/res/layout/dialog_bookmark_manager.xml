<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/dialog_root"
    android:background="@color/dy_feed_bg"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="580dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_feed_card_rounded"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:elevation="2dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_tertiary"
            android:id="@+id/tv_close"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关闭"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="书签管理器"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_red"
            android:id="@+id/tv_clear_all"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="12dp"
        android:elevation="2dp">
        <TextView
            android:textSize="14sp"
            android:gravity="center"
            android:id="@+id/tab_video"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="作品"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:gravity="center"
            android:id="@+id/tab_comment"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="评论"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:gravity="center"
            android:id="@+id/tab_profile"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="主页"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:elevation="2dp">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/dy_feed_blue"
                android:id="@+id/tv_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/dy_feed_text_secondary"
                android:id="@+id/tv_count_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="总书签"/>
        </LinearLayout>
        <View
            android:background="@color/dy_feed_divider"
            android:layout_width="1px"
            android:layout_height="24dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/dy_feed_red"
                android:id="@+id/tv_new_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/dy_feed_text_secondary"
                android:id="@+id/tv_new_count_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="有新动态"/>
        </LinearLayout>
    </LinearLayout>
    <ListView
        android:id="@+id/list_bookmarks"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="2dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:divider="@color/dy_feed_divider"
        android:dividerHeight="1px"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:elevation="2dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/dy_feed_text_secondary"
        android:gravity="center"
        android:id="@+id/tv_empty"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="暂无记录"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp">
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_query_all"
            android:background="@drawable/bg_feed_btn_primary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="主动查询"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_tertiary"
            android:gravity="center"
            android:id="@+id/btn_close_bottom"
            android:background="@drawable/bg_feed_btn_secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="关闭"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dy_feed_footnote"
        android:gravity="center"
        android:id="@+id/tv_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="DyHelper · 点击未读项查看详情"/>
</LinearLayout>
