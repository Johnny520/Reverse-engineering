<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/clean_misc_item_root"
    android:background="@drawable/bg_feed_card_rounded"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:id="@+id/clean_misc_item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <Switch
            android:id="@+id/clean_misc_item_enabled"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:showText="false"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/dy_feed_text_secondary"
        android:id="@+id/clean_misc_item_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <View
        android:background="@color/dy_feed_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:layout_marginTop="10dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/clean_misc_alpha_label"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_green"
            android:gravity="end"
            android:id="@+id/clean_misc_item_alpha_value"
            android:layout_width="52dp"
            android:layout_height="wrap_content"/>
    </LinearLayout>
    <SeekBar
        android:id="@+id/clean_misc_item_alpha"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:max="100"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:splitTrack="false"
        android:progressTint="@color/dy_feed_green"
        android:progressBackgroundTint="@color/dy_feed_divider"
        android:thumbTint="@color/dy_feed_green"
        android:min="0"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dy_feed_text_primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/clean_misc_follow_restore"/>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/dy_feed_text_tertiary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/clean_misc_follow_restore_description"/>
        </LinearLayout>
        <Switch
            android:id="@+id/clean_misc_item_follow_restore"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:showText="false"/>
    </LinearLayout>
</LinearLayout>
