<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/gesture_config_root"
    android:background="@color/dy_feed_bg"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">
    <FrameLayout
        android:id="@+id/gesture_top_bar"
        android:background="@color/dy_feed_card_bg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_gesture_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="手势配置"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/tv_gesture_close"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="关闭"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/tv_gesture_status"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未配置"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </FrameLayout>
    <View
        android:background="@color/dy_feed_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <ScrollView
        android:id="@+id/sv_gesture_content"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:layout_weight="1"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/gesture_content_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/card_gesture_stats"
                android:background="@color/dy_feed_card_bg"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textColor="@color/dy_feed_blue"
                        android:id="@+id/tv_stat_configured_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/DYText.StatValue"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="已配置"
                        style="@style/DYText.StatLabel"/>
                </LinearLayout>
                <View
                    android:background="@color/dy_feed_divider"
                    android:layout_width="1px"
                    android:layout_height="24dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textColor="@color/dy_feed_red"
                        android:id="@+id/tv_stat_double_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/DYText.StatValue"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="双击"
                        style="@style/DYText.StatLabel"/>
                </LinearLayout>
                <View
                    android:background="@color/dy_feed_divider"
                    android:layout_width="1px"
                    android:layout_height="24dp"/>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textColor="@color/dy_feed_blue"
                        android:id="@+id/tv_stat_long_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        style="@style/DYText.StatValue"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="长按"
                        style="@style/DYText.StatLabel"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_gesture_switch"
                android:background="@color/dy_feed_card_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/row_gesture_switch"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@color/dy_feed_text_primary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Feed手势总开关"
                            android:includeFontPadding="false"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/dy_feed_text_secondary"
                            android:id="@+id/tv_gesture_summary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="未配置任何区域动作时不会触发"
                            android:includeFontPadding="false"/>
                    </LinearLayout>
                    <Switch
                        android:id="@+id/sw_gesture_enabled"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:showText="false"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_gesture_hint"
                android:background="@color/dy_feed_card_bg"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="区域配置说明"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/dy_feed_text_secondary"
                    android:id="@+id/tv_gesture_hint_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="点击下方任意区域后配置双击或长按动作。当前预览区已全部划入可配置手势区域。"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/card_gesture_area"
                android:background="@color/dy_feed_card_bg"
                android:padding="5dp"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:layout_marginTop="5dp">
                <FrameLayout
                    android:id="@+id/gesture_area_container"
                    android:background="@color/dy_feed_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/selected_area_info"
        android:background="@color/dy_feed_card_bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="当前配置区域"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:ellipsize="end"
            android:id="@+id/tv_area_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="区域名称：未选择"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dy_feed_text_secondary"
                android:ellipsize="end"
                android:id="@+id/tv_double_tap_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="双击动作：未设置"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dy_feed_text_secondary"
                android:ellipsize="end"
                android:id="@+id/tv_long_press_action"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="长按动作：未设置"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp">
            <Button
                android:id="@+id/btn_config_double_tap"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="配置双击"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                style="@style/DYButton.Compact"/>
            <Button
                android:id="@+id/btn_config_long_press"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="配置长按"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                style="@style/DYButton.Compact"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/card_gesture_bottom"
        android:background="@color/dy_feed_card_bg"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp">
        <Button
            android:id="@+id/btn_reset"
            android:layout_width="0dp"
            android:layout_height="@dimen/dy_compact_button_height"
            android:text="重置默认"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            style="@style/DYButton.Compact"/>
        <Button
            android:id="@+id/btn_preview_position"
            android:layout_width="0dp"
            android:layout_height="@dimen/dy_compact_button_height"
            android:text="预览位置"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            style="@style/DYButton.Compact"/>
        <Button
            android:id="@+id/btn_save"
            android:layout_width="0dp"
            android:layout_height="@dimen/dy_compact_button_height"
            android:text="保存配置"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            style="@style/DYButton.Compact"/>
    </LinearLayout>
    <TextView
        android:id="@+id/tv_gesture_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="DyHelper · 全区域可配置，未设置动作时不会触发"
        style="@style/DYText.Footnote"/>
</LinearLayout>
