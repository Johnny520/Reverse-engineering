<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/imtl_root"
    android:background="@drawable/bg_feed_dialog_root"
    android:padding="@dimen/dy_dialog_padding"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dy_dialog_top_bar_height">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="start|center_vertical"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/imtl_tv_close"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="@string/im_time_label_dialog_close"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="@dimen/dy_text_dialog_title"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:id="@+id/imtl_tv_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/im_time_label_dialog_title"
            android:includeFontPadding="false"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"/>
        <TextView
            android:textSize="@dimen/dy_text_badge"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_green"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/imtl_tv_badge"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/im_time_label_dialog_live_preview"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </FrameLayout>
    <View
        android:id="@+id/imtl_top_divider"
        android:background="@color/dy_feed_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <ScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/imtl_card_preview"
                android:background="@drawable/bg_feed_card_rounded"
                android:padding="@dimen/dy_card_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/imtl_tv_preview_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/im_time_label_dialog_preview_title"
                    style="@style/DYText.SectionTitle"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/dy_feed_text_secondary"
                    android:ellipsize="end"
                    android:gravity="start|center_vertical"
                    android:id="@+id/imtl_tv_preview"
                    android:background="@drawable/bg_feed_input_bg"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="48dp"
                    android:text="@string/im_time_label_dialog_preview_sample"
                    android:maxLines="4"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/imtl_card_template"
                android:background="@drawable/bg_feed_card_rounded"
                android:padding="@dimen/dy_card_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:id="@+id/imtl_tv_template_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/im_time_label_dialog_text_title"
                    style="@style/DYText.SectionTitle"/>
                <TextView
                    android:id="@+id/imtl_tv_template_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/im_time_label_dialog_text_description"
                    style="@style/DYText.Caption"/>
                <EditText
                    android:textSize="@dimen/dy_text_body"
                    android:textColor="@color/dy_feed_text_primary"
                    android:textColorHighlight="@color/dy_feed_green_bg"
                    android:textColorHint="@color/dy_feed_text_tertiary"
                    android:gravity="start|top"
                    android:id="@+id/imtl_et_template"
                    android:background="@drawable/bg_feed_input_bg"
                    android:padding="12dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:scrollbars="vertical"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:minHeight="92dp"
                    android:hint="@string/im_time_label_dialog_text_hint"
                    android:maxLines="6"
                    android:scrollHorizontally="false"
                    android:singleLine="false"
                    android:inputType="textNoSuggestions"
                    android:imeOptions="flagNoEnterAction"
                    android:importantForAutofill="no"/>
                <TextView
                    android:gravity="end"
                    android:id="@+id/imtl_tv_template_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    style="@style/DYText.Micro"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp">
                    <Button
                        android:textColor="@color/dy_feed_text_secondary"
                        android:id="@+id/imtl_btn_insert_time"
                        android:background="@drawable/bg_feed_btn_secondary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/im_time_label_dialog_insert_time"
                        android:layout_weight="1"
                        style="@style/DYButton.Compact"/>
                    <Button
                        android:textColor="@color/dy_feed_text_secondary"
                        android:id="@+id/imtl_btn_insert_line"
                        android:background="@drawable/bg_feed_btn_secondary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/im_time_label_dialog_insert_line"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        style="@style/DYButton.Compact"/>
                    <Button
                        android:textColor="@color/dy_feed_text_secondary"
                        android:id="@+id/imtl_btn_reset"
                        android:background="@drawable/bg_feed_btn_secondary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/im_time_label_dialog_reset"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        style="@style/DYButton.Compact"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/imtl_card_pattern"
                android:background="@drawable/bg_feed_card_rounded"
                android:padding="@dimen/dy_card_padding"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/imtl_tv_pattern_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/im_time_label_dialog_pattern_title"
                        android:layout_weight="1"
                        style="@style/DYText.SectionTitle"/>
                    <TextView
                        android:textColor="@color/dy_feed_green"
                        android:id="@+id/imtl_tv_pattern_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/im_time_label_dialog_pattern_valid"
                        style="@style/DYText.Badge"/>
                </LinearLayout>
                <EditText
                    android:textColor="@color/dy_feed_text_primary"
                    android:textColorHighlight="@color/dy_feed_green_bg"
                    android:textColorHint="@color/dy_feed_text_tertiary"
                    android:id="@+id/imtl_et_pattern"
                    android:background="@drawable/bg_feed_input_bg"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_marginTop="8dp"
                    android:hint="@string/im_time_label_dialog_pattern_hint"
                    android:importantForAutofill="no"
                    style="@style/DYDialog.EditText"/>
                <TextView
                    android:id="@+id/imtl_tv_pattern_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/im_time_label_dialog_pattern_guide"
                    style="@style/DYText.Micro"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="34dp"
                    android:layout_marginTop="8dp">
                    <Button
                        android:textColor="@color/dy_feed_text_secondary"
                        android:id="@+id/imtl_btn_pattern_full"
                        android:background="@drawable/bg_feed_btn_secondary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/im_time_label_dialog_pattern_full"
                        android:layout_weight="1"
                        style="@style/DYButton.Compact"/>
                    <Button
                        android:textColor="@color/dy_feed_text_secondary"
                        android:id="@+id/imtl_btn_pattern_short"
                        android:background="@drawable/bg_feed_btn_secondary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/im_time_label_dialog_pattern_short"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        style="@style/DYButton.Compact"/>
                    <Button
                        android:textColor="@color/dy_feed_text_secondary"
                        android:id="@+id/imtl_btn_pattern_time"
                        android:background="@drawable/bg_feed_btn_secondary"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/im_time_label_dialog_pattern_time_only"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        style="@style/DYButton.Compact"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dy_button_height"
        android:layout_marginTop="@dimen/dy_space_md">
        <Button
            android:id="@+id/imtl_btn_save"
            android:layout_width="0dp"
            android:text="@string/im_time_label_dialog_save"
            android:layout_weight="1"
            style="@style/DYButton.Primary"/>
        <Button
            android:id="@+id/imtl_btn_cancel"
            android:layout_width="0dp"
            android:text="@string/im_time_label_dialog_cancel"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dy_space_sm"
            style="@style/DYButton.Secondary"/>
    </LinearLayout>
</LinearLayout>
