<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dp_scroll"
    android:background="@android:color/transparent"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:fadeScrollbars="false"
    android:overScrollMode="never">
    <LinearLayout
        android:id="@+id/dp_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/DYDialog.Panel">
        <FrameLayout
            android:id="@+id/dp_top_bar"
            android:layout_width="match_parent"
            style="@style/DYDialog.TopBar">
            <TextView
                android:gravity="center"
                android:id="@+id/dp_tv_title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="下载路径"
                android:paddingStart="72dp"
                android:paddingEnd="72dp"
                style="@style/DYText.DialogTitle"/>
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/dy_feed_text_secondary"
                android:gravity="center"
                android:layout_gravity="start|center_vertical"
                android:id="@+id/dp_tv_close"
                android:layout_width="@dimen/dy_dialog_close_size"
                android:layout_height="@dimen/dy_dialog_close_size"
                android:text="×"
                android:includeFontPadding="false"/>
            <TextView
                android:textColor="@color/dy_feed_green"
                android:layout_gravity="end|center_vertical"
                android:id="@+id/dp_tv_badge"
                android:background="@color/dy_feed_green_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="模板"
                style="@style/DYText.Badge"/>
        </FrameLayout>
        <LinearLayout
            android:id="@+id/dp_card_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            style="@style/DYDialog.Card">
            <TextView
                android:id="@+id/dp_tv_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="最后一段会作为文件名，不需要填写扩展名"
                style="@style/DYText.Note"/>
            <TextView
                android:textColor="@color/dy_feed_text_tertiary"
                android:id="@+id/dp_tv_current_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="当前配置"
                style="@style/DYText.Caption"/>
            <TextView
                android:textColor="@color/dy_feed_blue"
                android:id="@+id/dp_tv_preview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="预览："
                style="@style/DYText.Note"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dp_card_template"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/DYDialog.Card">
            <TextView
                android:id="@+id/dp_tv_template_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="保存路径模板"
                style="@style/DYText.SectionTitle"/>
            <TextView
                android:id="@+id/dp_tv_template_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="例如：/sdcard/Download/DYHelper/{nickname}_{currentTime}"
                style="@style/DYText.Caption"/>
            <EditText
                android:gravity="start|top"
                android:id="@+id/dp_et_template"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:layout_marginTop="10dp"
                android:hint="输入保存路径模板"
                android:maxLines="6"
                android:minLines="4"
                android:singleLine="false"
                android:inputType="textNoSuggestions"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                style="@style/DYDialog.EditText"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/dp_template_action_row"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="10dp">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_blue"
                    android:gravity="center"
                    android:id="@+id/dp_btn_pick_dir"
                    android:background="@color/dy_feed_blue_bg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="选择目录"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_red"
                    android:gravity="center"
                    android:id="@+id/dp_btn_clear_template"
                    android:background="@color/dy_feed_red_bg"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="清空模板"
                    android:includeFontPadding="false"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dp_card_tokens"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/DYDialog.Card">
            <TextView
                android:id="@+id/dp_tv_token_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="可用占位符"
                style="@style/DYText.SectionTitle"/>
            <TextView
                android:id="@+id/dp_tv_token_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="点击下方标签插入到光标位置"
                style="@style/DYText.Caption"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dp_chip_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/dp_card_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            style="@style/DYDialog.Card">
            <TextView
                android:id="@+id/dp_tv_date_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="日期格式"
                style="@style/DYText.SectionTitle"/>
            <TextView
                android:id="@+id/dp_tv_date_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="用于 {createTime} 和 {currentTime}"
                style="@style/DYText.Caption"/>
            <EditText
                android:id="@+id/dp_et_date_format"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:hint="yyyy-MM-dd_HH-mm-ss"
                style="@style/DYDialog.EditText"/>
            <TextView
                android:id="@+id/dp_tv_date_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="示例：2026-05-22_14-30-00"
                style="@style/DYText.Micro"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/dp_date_chip_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
            <View
                android:id="@+id/dp_divider_options_1"
                android:background="@color/dy_feed_divider"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginTop="12dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/dp_row_notify"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="54dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/dy_feed_text_primary"
                        android:id="@+id/dp_tv_notify_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="通知栏下载"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/dy_feed_text_secondary"
                        android:id="@+id/dp_tv_notify_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="下载时在通知栏显示进度"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/dp_sw_notify"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false"/>
            </LinearLayout>
            <View
                android:id="@+id/dp_divider_options_2"
                android:background="@color/dy_feed_divider"
                android:layout_width="match_parent"
                android:layout_height="1px"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/dp_row_confirm"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="54dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/dy_feed_text_primary"
                        android:id="@+id/dp_tv_confirm_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="保存时确认文件名"
                        android:includeFontPadding="false"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/dy_feed_text_secondary"
                        android:id="@+id/dp_tv_confirm_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="保存前弹出对话框确认最终文件名"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/dp_sw_confirm_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:showText="false"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/dp_bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dy_button_height"
            android:layout_marginTop="12dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/dy_feed_text_secondary"
                android:gravity="center"
                android:id="@+id/dp_btn_reset"
                android:background="@color/dy_feed_grey_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="恢复默认"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/dy_feed_text_secondary"
                android:gravity="center"
                android:id="@+id/dp_btn_cancel"
                android:background="@color/dy_feed_grey_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="取消"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#ffffff"
                android:gravity="center"
                android:id="@+id/dp_btn_save"
                android:background="@color/dy_feed_green"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="保存"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:id="@+id/dp_tv_footer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="DyHelper · 下载路径模板"
            style="@style/DYText.Footnote"/>
    </LinearLayout>
</ScrollView>
