<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/op_row_root"
    android:paddingTop="9dp"
    android:paddingBottom="9dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="60dp"
    android:paddingStart="12dp"
    android:paddingEnd="8dp">
    <FrameLayout
        android:id="@+id/op_icon_box"
        android:layout_width="36dp"
        android:layout_height="36dp">
        <ImageView
            android:id="@+id/op_iv_icon"
            android:padding="9dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/op_text_col"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <TextView
            android:textSize="14sp"
            android:ellipsize="end"
            android:id="@+id/op_tv_row_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
        <TextView
            android:textSize="11sp"
            android:ellipsize="end"
            android:id="@+id/op_tv_row_subtitle"
            android:paddingTop="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:id="@+id/op_tv_row_badge"
        android:paddingTop="3dp"
        android:paddingBottom="3dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:layout_marginStart="6dp"/>
    <ImageView
        android:id="@+id/op_iv_more"
        android:padding="9dp"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@string/operation_action_more"
        android:layout_marginStart="2dp"/>
    <ImageView
        android:id="@+id/op_iv_chevron"
        android:padding="7dp"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:contentDescription="@string/operation_action_execute"
        android:layout_marginStart="2dp"/>
</LinearLayout>
