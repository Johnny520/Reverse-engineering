<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/im_item_root"
    android:background="@color/dy_feed_card_bg"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:focusable="false"
    android:clickable="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">
    <CheckBox
        android:id="@+id/im_cb_select"
        android:focusable="false"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/im_text_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:ellipsize="end"
            android:id="@+id/im_tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="会话名称"
            android:maxLines="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:ellipsize="end"
            android:id="@+id/im_tv_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="UID / CID"
            android:maxLines="1"/>
    </LinearLayout>
</LinearLayout>
