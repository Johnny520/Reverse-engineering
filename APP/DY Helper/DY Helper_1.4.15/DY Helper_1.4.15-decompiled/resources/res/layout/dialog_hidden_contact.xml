<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/hidden_contact_root"
    android:background="@drawable/bg_feed_dialog_root"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="12dp"
    android:paddingEnd="12dp">
    <FrameLayout
        android:id="@+id/hidden_contact_header"
        android:background="@color/dy_feed_card_bg"
        android:layout_width="match_parent"
        android:layout_height="42dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/hidden_contact_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/hidden_contact_title"
            android:maxLines="1"
            android:includeFontPadding="false"
            android:paddingStart="72dp"
            android:paddingEnd="72dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/hidden_contact_close"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="@string/hidden_contact_close"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_blue"
            android:layout_gravity="end|center_vertical"
            android:id="@+id/hidden_contact_count_badge"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hidden_contact_count_zero"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"/>
    </FrameLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/hidden_contact_tabs"
        android:background="@color/dy_feed_card_bg"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:id="@+id/hidden_contact_tab_add"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:text="@string/hidden_contact_tab_add"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/hidden_contact_tab_manage"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:text="@string/hidden_contact_tab_manage"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/hidden_contact_search_card"
        android:background="@drawable/bg_feed_card_rounded"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/dy_feed_text_primary"
            android:textColorHint="@color/dy_feed_text_tertiary"
            android:id="@+id/hidden_contact_search"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:hint="@string/hidden_contact_search_hint"
            android:cursorVisible="true"
            android:singleLine="true"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:importantForAutofill="no"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/hidden_contact_progress"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:indeterminate="true"
                style="?android:attr/progressBarStyleSmall"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/dy_feed_text_secondary"
                android:ellipsize="end"
                android:id="@+id/hidden_contact_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/hidden_contact_loading"
                android:maxLines="2"
                android:layout_weight="1"
                android:layout_marginStart="6dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/hidden_contact_list_card"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">
        <ListView
            android:id="@+id/hidden_contact_list"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:cacheColorHint="@android:color/transparent"
            android:divider="@color/dy_feed_divider"
            android:dividerHeight="1px"
            android:fadeScrollbars="false"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/hidden_contact_empty"
            android:padding="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/hidden_contact_empty"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="6dp">
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/hidden_contact_manual"
            android:background="@drawable/bg_feed_btn_primary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/hidden_contact_manual"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:id="@+id/hidden_contact_clear"
            android:background="@drawable/bg_feed_btn_secondary"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="@string/hidden_contact_clear"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dy_feed_footnote"
        android:gravity="center"
        android:id="@+id/hidden_contact_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="@string/hidden_contact_footer"/>
</LinearLayout>
