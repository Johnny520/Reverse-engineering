<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/dialog_reply_detail_root"
    android:background="@color/dy_feed_bg"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="520dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_feed_card_rounded"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:elevation="2dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:id="@+id/tv_detail_close"
            android:padding="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关闭"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:id="@+id/tv_detail_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="新增回复"
            android:layout_weight="1"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_red"
            android:background="@drawable/bg_feed_badge"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="未读"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/card_original"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:elevation="2dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="原评论"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:id="@+id/tv_original_comment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="原评论内容"/>
    </LinearLayout>
    <ScrollView
        android:background="@drawable/bg_feed_card_rounded"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:elevation="2dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/container_replies"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/dy_feed_text_tertiary"
        android:gravity="center"
        android:id="@+id/tv_empty_replies"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="暂无回复内容"
        android:elevation="2dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp">
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/btn_detail_mark_read"
            android:background="@drawable/bg_feed_btn_primary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="标记已读"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_tertiary"
            android:gravity="center"
            android:id="@+id/btn_detail_jump"
            android:background="@drawable/bg_feed_btn_secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="跳转查看"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_tertiary"
            android:gravity="center"
            android:id="@+id/btn_detail_close"
            android:background="@drawable/bg_feed_btn_secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="关闭"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dy_feed_footnote"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="DyHelper · 查看不会自动已读，需手动点击标记已读"/>
</LinearLayout>
