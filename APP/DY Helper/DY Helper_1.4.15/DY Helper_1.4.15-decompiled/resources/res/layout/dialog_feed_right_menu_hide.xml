<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/feed_right_menu_hide_root"
    android:background="@color/dy_feed_bg"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/feed_right_menu_top_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="2dp"
        android:paddingEnd="2dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/tv_feed_right_menu_close"
            android:background="@drawable/bg_feed_close_btn"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:text="✕"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:id="@+id/tv_feed_right_menu_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="屏蔽 Feed 右侧控件"
            android:layout_centerInParent="true"/>
        <TextView
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:background="@drawable/bg_feed_badge"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:text="设置"
            android:layout_centerVertical="true"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/card_feed_right_menu_info"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:elevation="2dp">
        <View
            android:layout_gravity="center_vertical"
            android:background="@drawable/bg_feed_info_accent"
            android:layout_width="3dp"
            android:layout_height="32dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/dy_feed_text_primary"
                android:id="@+id/tv_discovered_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="已发现右侧控件：0 个"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/dy_feed_text_secondary"
                android:id="@+id/tv_feed_right_menu_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="勾选后点击保存即可生效"/>
        </LinearLayout>
    </LinearLayout>
    <ListView
        android:id="@+id/lv_feed_right_menu_items"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="2dp"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:divider="@color/dy_feed_divider"
        android:dividerHeight="1px"
        android:layout_weight="1"
        android:fadeScrollbars="false"
        android:elevation="2dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/card_feed_right_menu_bottom"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:elevation="2dp">
        <Button
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/btn_clear_scan_cache"
            android:background="@drawable/bg_feed_btn_secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="清空缓存"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:textAlignment="center"
            android:layout_marginEnd="4dp"/>
        <Button
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:id="@+id/btn_show_all"
            android:background="@drawable/bg_feed_btn_secondary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="全部显示"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:textAlignment="center"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_save"
            android:background="@drawable/bg_feed_btn_primary"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="保存"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:textAlignment="center"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
