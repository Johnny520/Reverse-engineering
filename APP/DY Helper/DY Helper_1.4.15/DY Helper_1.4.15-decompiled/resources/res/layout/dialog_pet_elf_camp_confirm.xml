<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/camp_confirm_root"
    android:background="@drawable/bg_feed_dialog_root"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/dy_feed_text_primary"
        android:gravity="center"
        android:id="@+id/camp_confirm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <ScrollView
        android:id="@+id/camp_confirm_card"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxHeight="360dp"
        android:fillViewport="true">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:id="@+id/camp_confirm_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </ScrollView>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dy_feed_footnote"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="操作会再次确认实时营地状态，并按安全间隔串行执行"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp">
        <Button
            android:textSize="12sp"
            android:gravity="center"
            android:id="@+id/camp_confirm_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="取消"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginEnd="4dp"/>
        <Button
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:gravity="center"
            android:id="@+id/camp_confirm_execute"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="确认执行"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:textAllCaps="false"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
