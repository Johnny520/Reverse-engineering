<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/geo_names_database_root"
    android:background="@color/dy_feed_bg"
    android:padding="14dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/include_dialog_top_bar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/geo_names_info_card"
        android:background="@drawable/bg_feed_card_rounded"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dy_feed_text_primary"
            android:id="@+id/tv_geo_names_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="国外地区编码数据库用于显示国家、省州和城市名称。"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/geo_names_stats_card"
            android:background="@color/dy_feed_grey_bg"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/dy_feed_text_secondary"
                    android:id="@+id/tv_geo_names_download_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="预计下载"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_blue"
                    android:id="@+id/tv_geo_names_download_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="177.0 MB"/>
            </LinearLayout>
            <View
                android:layout_gravity="center_vertical"
                android:background="@color/dy_feed_divider"
                android:layout_width="1px"
                android:layout_height="32dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp">
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/dy_feed_text_secondary"
                    android:id="@+id/tv_geo_names_storage_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="解压后占用"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_green"
                    android:id="@+id/tv_geo_names_storage_size"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="536.5 MB"/>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:id="@+id/tv_geo_names_source_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="下载源"
            android:includeFontPadding="false"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/geo_names_source_selector"
            android:background="@color/dy_feed_grey_bg"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/dy_feed_text_primary"
                android:ellipsize="end"
                android:id="@+id/tv_geo_names_source_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="GitHub 原站"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="20sp"
                android:textColor="@color/dy_feed_text_secondary"
                android:id="@+id/tv_geo_names_source_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progress_geo_names_download"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="14dp"
            android:max="1000"
            android:progress="0"
            style="?android:attr/progressBarStyleHorizontal"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:id="@+id/tv_geo_names_status"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="准备下载"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/geo_names_action_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <Button
            android:id="@+id/btn_geo_names_cancel"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:text="取消且不再提示"
            android:layout_weight="1"
            style="@style/DYButton.Secondary"/>
        <Button
            android:id="@+id/btn_geo_names_retry"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:text="重试"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/DYButton.Secondary"/>
        <Button
            android:id="@+id/btn_geo_names_download"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:text="下载"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            style="@style/DYButton.Primary"/>
    </LinearLayout>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/dy_feed_footnote"
        android:gravity="center"
        android:id="@+id/tv_geo_names_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="下载完成后会校验分卷、压缩包和 SQLite 数据库完整性。"
        android:includeFontPadding="false"/>
</LinearLayout>
