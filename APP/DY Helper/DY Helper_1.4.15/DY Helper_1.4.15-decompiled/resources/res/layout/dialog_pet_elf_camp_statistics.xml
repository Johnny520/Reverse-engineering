<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/camp_statistics_root"
    android:background="@drawable/bg_feed_dialog_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/dy_feed_text_secondary"
            android:gravity="center"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/camp_statistics_close"
            android:background="@drawable/bg_feed_close_btn"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="@string/camp_statistics_close_symbol"
            android:contentDescription="@string/camp_statistics_close"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_text_primary"
            android:gravity="center"
            android:id="@+id/camp_statistics_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/camp_statistics_title"
            android:paddingStart="64dp"
            android:paddingEnd="64dp"/>
        <TextView
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/dy_feed_blue"
            android:gravity="center"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_feed_badge"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:text="@string/camp_statistics_period"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"/>
    </FrameLayout>
    <View
        android:background="@color/dy_feed_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <ScrollView
        android:paddingTop="10dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/camp_statistics_summary_card"
                android:background="@drawable/bg_feed_card_rounded"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/dy_feed_text_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/camp_statistics_today"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="@color/dy_feed_text_secondary"
                        android:id="@+id/camp_statistics_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dy_feed_green"
                            android:id="@+id/camp_statistics_income"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/camp_statistics_zero"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/dy_feed_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/camp_statistics_coin_income"/>
                    </LinearLayout>
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@color/dy_feed_divider"
                        android:layout_width="1px"
                        android:layout_height="42dp"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#e07b39"
                            android:id="@+id/camp_statistics_investment"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/camp_statistics_zero"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/dy_feed_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/camp_statistics_coin_investment"/>
                    </LinearLayout>
                </LinearLayout>
                <View
                    android:background="@color/dy_feed_divider"
                    android:layout_width="match_parent"
                    android:layout_height="1px"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/dy_feed_blue"
                            android:id="@+id/camp_statistics_plant_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/camp_statistics_zero"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/dy_feed_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/camp_statistics_plant_count"/>
                    </LinearLayout>
                    <View
                        android:layout_gravity="center_vertical"
                        android:background="@color/dy_feed_divider"
                        android:layout_width="1px"
                        android:layout_height="42dp"/>
                    <LinearLayout
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="8dp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="#7b68c8"
                            android:id="@+id/camp_statistics_water_count"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/camp_statistics_zero"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/dy_feed_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="@string/camp_statistics_water_count"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/camp_statistics_coin_card"
                android:background="@drawable/bg_feed_card_rounded"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_statistics_coin_chart_title"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/dy_feed_text_secondary"
                    android:id="@+id/camp_statistics_coin_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/camp_statistics_coin_legend"/>
                <FrameLayout
                    android:id="@+id/camp_statistics_coin_chart"
                    android:layout_width="match_parent"
                    android:layout_height="196dp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/camp_statistics_action_card"
                android:background="@drawable/bg_feed_card_rounded"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/dy_feed_text_primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/camp_statistics_action_chart_title"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/dy_feed_text_secondary"
                    android:id="@+id/camp_statistics_action_legend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/camp_statistics_action_legend"/>
                <FrameLayout
                    android:id="@+id/camp_statistics_action_chart"
                    android:layout_width="match_parent"
                    android:layout_height="196dp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/dy_feed_footnote"
                android:gravity="center"
                android:id="@+id/camp_statistics_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
