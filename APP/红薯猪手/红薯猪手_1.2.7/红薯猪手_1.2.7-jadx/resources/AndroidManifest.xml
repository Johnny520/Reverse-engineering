<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="32"
    android:versionName="1.2.7"
    android:compileSdkVersion="34"
    android:compileSdkVersionCodename="14"
    package="com.skyhand.redbookhelper"
    platformBuildVersionCode="34"
    platformBuildVersionName="14">
    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <queries>
        <package android:name="com.xingin.xhs"/>
    </queries>
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:extractNativeLibs="false"
        android:roundIcon="@mipmap/ic_launcher_round">
        <meta-data
            android:name="xposedmodule"
            android:value="true"/>
        <meta-data
            android:name="xposeddescription"
            android:value="借猪之手，还你干净的生活分享区~"/>
        <meta-data
            android:name="xposedminversion"
            android:value="30"/>
        <meta-data
            android:name="xposedscope"
            android:value="com.xingin.xhs"/>
        <activity
            android:name="com.skyhand.redbookhelper.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="de.robv.android.xposed.category.MODULE_SETTINGS"/>
            </intent-filter>
        </activity>
        <activity-alias
            android:name="com.skyhand.redbookhelper.MainActivityAlias"
            android:exported="true"
            android:targetActivity="com.skyhand.redbookhelper.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
        <service
            android:name="androidx.room.MultiInstanceInvalidationService"
            android:exported="false"
            android:directBootAware="true"/>
    </application>
</manifest>
