<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_troop_avatar"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@mipmap/ic_launcher_round"
        android:layout_centerVertical="true"
        android:contentDescription="avatar"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="16sp"
        android:textColor="#000000"
        android:id="@+id/tv_troop_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="群名称"
        android:layout_alignParentTop="true"
        android:layout_marginStart="15dp"
        android:layout_toEndOf="@+id/iv_troop_avatar"/>
    <TextView
        android:textSize="14sp"
        android:textColor="#000000"
        android:id="@+id/tv_troop_uin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="32838203473"
        android:layout_below="@+id/tv_troop_name"
        android:layout_alignStart="@+id/tv_troop_name"/>
    <CheckBox
        android:theme="@style/Theme.MyAppTheme"
        android:id="@+id/cb_troop_select"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:buttonTint="#000000"/>
</RelativeLayout>
