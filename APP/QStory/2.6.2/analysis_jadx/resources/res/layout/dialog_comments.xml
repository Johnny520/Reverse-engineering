<?xml version="1.0" encoding="utf-8"?>
<top.suzhelan.plugin.sdk.online.widget.FollowLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/AppTheme"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/tv_comment_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="脚本: 评论数："/>
    <ProgressBar
        android:id="@+id/pb_loading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <top.suzhelan.plugin.sdk.online.widget.CustomRecycleView
        android:id="@+id/rv_comment_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:id="@+id/et_comment_content"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="善语结善缘 恶语伤人心"
            android:maxLines="2"
            android:layout_weight="1"
            style="@style/Widget.Material3.TextInputEditText.FilledBox"/>
        <Button
            android:id="@+id/btn_send_comment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="评论"
            style="@style/Widget.Material3.Button.OutlinedButton"/>
    </LinearLayout>
</top.suzhelan.plugin.sdk.online.widget.FollowLinearLayout>
