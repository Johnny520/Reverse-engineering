<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/AppTheme"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="其他设置"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_keep_open"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/sticker_dir_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="发送表情后不关闭面板"
            android:layout_weight="1"/>
        <top.suzhelan.qstory.p015ui.views.CustomMaterialSwitch
            android:id="@+id/switch_keep_open"
            android:layout_width="36dp"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"/>
    </LinearLayout>
    <top.suzhelan.plugin.sdk.online.widget.CustomMaterialButton
        android:textSize="14sp"
        android:id="@+id/btn_organize_stickers"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:text="一键整理(为图片添加后缀)"
        style="@style/Widget.Material3.Button.TonalButton"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:text="文件夹排序"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_dir_sort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cb_dir_name_asc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <top.suzhelan.qstory.p015ui.views.CustomMaterialCheckBox
                android:id="@+id/cb_dir_name_asc_box"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/sticker_dir_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="文件名 A → Z"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cb_dir_name_desc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <top.suzhelan.qstory.p015ui.views.CustomMaterialCheckBox
                android:id="@+id/cb_dir_name_desc_box"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/sticker_dir_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="文件名 Z → A"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cb_dir_time_asc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <top.suzhelan.qstory.p015ui.views.CustomMaterialCheckBox
                android:id="@+id/cb_dir_time_asc_box"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/sticker_dir_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="修改时间 旧 → 新"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cb_dir_time_desc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <top.suzhelan.qstory.p015ui.views.CustomMaterialCheckBox
                android:id="@+id/cb_dir_time_desc_box"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/sticker_dir_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="修改时间 新 → 旧"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="表情排序"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_file_sort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cb_file_recent_usage"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <top.suzhelan.qstory.p015ui.views.CustomMaterialCheckBox
                android:id="@+id/cb_file_recent_usage_box"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/sticker_dir_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="最近使用"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cb_file_name_asc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <top.suzhelan.qstory.p015ui.views.CustomMaterialCheckBox
                android:id="@+id/cb_file_name_asc_box"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/sticker_dir_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="文件名 A → Z"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cb_file_name_desc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <top.suzhelan.qstory.p015ui.views.CustomMaterialCheckBox
                android:id="@+id/cb_file_name_desc_box"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/sticker_dir_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="文件名 Z → A"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cb_file_time_asc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <top.suzhelan.qstory.p015ui.views.CustomMaterialCheckBox
                android:id="@+id/cb_file_time_asc_box"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/sticker_dir_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="修改时间 旧 → 新"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/cb_file_time_desc"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">
            <top.suzhelan.qstory.p015ui.views.CustomMaterialCheckBox
                android:id="@+id/cb_file_time_desc_box"
                android:layout_width="22dp"
                android:layout_height="22dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/sticker_dir_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="修改时间 新 → 旧"
                android:layout_weight="1"
                android:layout_marginStart="12dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:gravity="center"
        android:id="@+id/tv_confirm"
        android:background="@drawable/bg_sticker_dir_select"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="12dp"
        android:text="确定"/>
</LinearLayout>
