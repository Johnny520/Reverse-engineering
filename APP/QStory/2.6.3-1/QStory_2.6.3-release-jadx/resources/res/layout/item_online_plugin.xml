<?xml version="1.0" encoding="utf-8"?>
<com.lihang.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:hl_cornerRadius="8dp"
    app:hl_layoutBackground="@android:color/transparent"
    app:hl_shadowColor="@color/online_plugin_glow_shadow"
    app:hl_shadowLimit="10dp">
    <top.suzhelan.plugin.sdk.online.widget.CustomCard
        android:theme="@style/AppTheme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/online_plugin_card_bg"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">
        <LinearLayout
            android:orientation="vertical"
            android:padding="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/pluginIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_plugin_icon"
                    android:scaleType="centerCrop"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp">
                    <TextView
                        android:textAppearance="?attr/textAppearanceTitleSmall"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:id="@+id/pluginName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"/>
                    <TextView
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:ellipsize="end"
                        android:id="@+id/pluginAuthor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textIsSelectable="true"/>
                </LinearLayout>
            </LinearLayout>
            <TextView
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:ellipsize="end"
                android:id="@+id/pluginDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:maxLines="3"/>
            <HorizontalScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <LinearLayout
                    android:orientation="horizontal"
                    android:id="@+id/previewsContainer"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="120dp"/>
            </HorizontalScrollView>
            <top.suzhelan.plugin.sdk.online.widget.CustomChipGroup
                android:id="@+id/pluginTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:chipSpacingHorizontal="2dp"
                app:maxRows="2"
                app:singleLine="false"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:ellipsize="end"
                        android:id="@+id/downloadCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="下载：8993"
                        android:maxLines="1"/>
                    <TextView
                        android:textAppearance="?attr/textAppearanceLabelSmall"
                        android:textColor="?android:attr/textColorSecondary"
                        android:id="@+id/tv_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2025-12-1"
                        android:layout_marginEnd="4dp"/>
                </LinearLayout>
                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <top.suzhelan.plugin.sdk.online.widget.CustomMaterialButton
                    android:textSize="12sp"
                    android:id="@+id/commentButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="评论"
                    style="@style/Widget.Material3.Button.TextButton"/>
                <top.suzhelan.plugin.sdk.online.widget.CustomMaterialButton
                    android:textSize="12sp"
                    android:id="@+id/installButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="安装"
                    style="@style/Widget.Material3.Button.TextButton"/>
            </LinearLayout>
        </LinearLayout>
    </top.suzhelan.plugin.sdk.online.widget.CustomCard>
</com.lihang.ShadowLayout>
