<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textColor="@color/text_color"
        android:gravity="center_vertical"
        android:id="@+id/base_item_left_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="23dp"
        android:text="Item测试文本效果"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/item_tip_color"
        android:id="@+id/base_item_left_tips_text"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="假如这个View要附带说明信息的话"
        android:layout_marginEnd="20dp"
        app:layout_constraintStart_toStartOf="@+id/base_item_left_text"
        app:layout_constraintTop_toBottomOf="@+id/base_item_left_text"/>
</androidx.constraintlayout.widget.ConstraintLayout>
