<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Md.SeaBreeze"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_search_input"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_search"
            android:contentDescription="search"
            android:layout_marginEnd="8dp"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/text_color"
            android:textColorHint="@android:color/darker_gray"
            android:id="@+id/et_search"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="36dp"
            android:hint="搜索昵称/QQ号/备注..."
            android:layout_weight="1"/>
        <ImageView
            android:id="@+id/iv_clear"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:contentDescription="clear"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/grey"
        android:id="@+id/tv_selected_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="已选: 0"
        android:layout_marginStart="16dp"/>
    <top.suzhelan.qstory.p015ui.views.DialogXRecycleView
        android:id="@+id/rv_friend_list"
        android:layout_width="match_parent"
        android:layout_height="450dp"
        android:layout_marginTop="4dp"
        android:overScrollMode="never"/>
    <Button
        android:enabled="false"
        android:textSize="15sp"
        android:textColor="@color/dialog_btn_danger_text"
        android:id="@+id/btn_delete"
        android:background="@drawable/bg_dialog_btn_danger"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="4dp"
        android:minHeight="0dp"
        android:text="删除选中 (0)"
        android:alpha="0.5"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"/>
</LinearLayout>
