<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pictop"
    android:background="#80585eaa"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textColor="@color/___res_0x2406047c"
        android:id="@+id/type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="私聊消息 "
        android:layout_marginStart="35dp"/>
    <TextView
        android:textSize="18sp"
        android:textColor="@color/___res_0x2406047c"
        android:id="@+id/pic_send_uin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="发送者 : 言 (2376738596)"
        android:layout_alignTop="@+id/type"
        android:layout_toEndOf="@+id/type"/>
    <TextView
        android:textColor="@color/___res_0x2406047c"
        android:id="@+id/pic_group_uin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"
        android:text="来自群组 : 0000"
        android:layout_below="@+id/type"
        android:layout_alignStart="@+id/type"/>
</RelativeLayout>
