<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/mcp_config_dialog_background"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/mcp_config_title"
        android:id="@+id/tv_mcp_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MCP 服务配置"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/mcp_config_subtitle"
        android:id="@+id/tv_mcp_dialog_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="按需启用工具，并将常用能力拖到更靠前的位置。"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/mcp_config_summary_text"
        android:id="@+id/tv_mcp_enabled_summary"
        android:background="@drawable/mcp_config_summary_background"
        android:paddingLeft="12dp"
        android:paddingTop="8dp"
        android:paddingRight="12dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/mcp_config_subtitle"
        android:id="@+id/tv_mcp_copy_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="MCP 客户端配置，点击下方 JSON 代码块即可复制"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/mcp_config_title"
        android:id="@+id/tv_mcp_client_config"
        android:background="@drawable/mcp_config_code_block_background"
        android:padding="14dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="112dp"
        android:lineSpacingExtra="2dp"
        android:fontFamily="monospace"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/mcp_config_secondary_text"
            android:gravity="center"
            android:id="@+id/btn_mcp_enable_all"
            android:background="@drawable/mcp_config_action_secondary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="全部启用"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/mcp_config_secondary_text"
            android:gravity="center"
            android:id="@+id/btn_mcp_disable_all"
            android:background="@drawable/mcp_config_action_secondary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="全部停用"
            android:layout_weight="1"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <top.suzhelan.qstory.p015ui.views.DialogXRecycleView
        android:id="@+id/rv_mcp_config"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="16dp"/>
    <LinearLayout
        android:gravity="end"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/mcp_config_secondary_text"
            android:gravity="center"
            android:id="@+id/btn_mcp_cancel"
            android:background="@drawable/mcp_config_action_secondary"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="88dp"
            android:text="取消"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/mcp_config_primary_text"
            android:gravity="center"
            android:id="@+id/btn_mcp_save"
            android:background="@drawable/mcp_config_action_primary"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="96dp"
            android:text="保存配置"/>
    </LinearLayout>
</LinearLayout>
