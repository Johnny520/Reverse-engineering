<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/pluginIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_plugin_icon"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp">
                <TextView
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:id="@+id/plugin_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="plugin name"
                    android:maxLines="1"
                    android:textIsSelectable="true"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary"
                    android:ellipsize="end"
                    android:id="@+id/plugin_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="plugin version"
                    android:maxLines="1"/>
                <TextView
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?android:attr/textColorSecondary"
                    android:ellipsize="end"
                    android:id="@+id/plugin_author"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="plugin author"
                    android:maxLines="1"/>
            </LinearLayout>
            <Switch
                android:layout_gravity="center_vertical"
                android:id="@+id/plugin_switch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/switch_custom_thumb_shape"
                android:track="@drawable/switch_custom_track_shape"
                android:showText="false"/>
            <ProgressBar
                android:layout_gravity="center_vertical"
                android:id="@+id/plugin_progress_bar"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminateDrawable="@drawable/record_progress"/>
        </LinearLayout>
        <TextView
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:ellipsize="end"
            android:id="@+id/plugin_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="plugin description"
            android:maxLines="3"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">
            <TextView
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="?android:attr/textColorSecondary"
                android:ellipsize="end"
                android:id="@+id/plugin_create_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="创建时间"
                android:maxLines="1"/>
            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <Button
                android:textSize="12sp"
                android:id="@+id/btn_menu"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="菜单"
                style="@style/Widget.Material3.Button.TextButton"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
