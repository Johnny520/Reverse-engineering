<?xml version="1.0" encoding="utf-8"?>
<com.lihang.ShadowLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="3dp"
    app:hl_cornerRadius="8dp"
    app:hl_layoutBackground="@android:color/transparent"
    app:hl_shadowColor="@color/online_plugin_glow_shadow"
    app:hl_shadowLimit="10dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/message_card"
        android:background="@color/online_plugin_card_bg"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_message_type_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_message_notification"
            android:contentDescription="消息类型图标"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:id="@+id/tv_message_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="消息类型"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="end"
                    android:id="@+id/tv_message_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="时间"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:id="@+id/tv_message_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="消息标题"
                android:maxLines="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="?android:attr/textColorSecondary"
                android:ellipsize="end"
                android:id="@+id/tv_message_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="消息内容"
                android:maxLines="2"/>
        </LinearLayout>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_unread_indicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:src="@drawable/ic_unread_dot"
            android:contentDescription="未读指示器"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</com.lihang.ShadowLayout>
