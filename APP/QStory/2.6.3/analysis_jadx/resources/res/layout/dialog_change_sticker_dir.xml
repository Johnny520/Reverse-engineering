<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/AppTheme"
    android:orientation="vertical"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="表情包名称"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/sticker_dir_text"
        android:id="@+id/et_dir_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="输入表情包名称"
        android:maxLines="1"
        android:inputType="text"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="标签"/>
    <top.suzhelan.qstory.ui.views.CustomChipGroup
        android:id="@+id/chip_group_tags"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/sticker_dir_text"
            android:id="@+id/et_tag_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="输入标签后添加"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="text"/>
        <top.suzhelan.plugin.sdk.online.widget.CustomMaterialButton
            android:textSize="13sp"
            android:id="@+id/btn_add_tag"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="60dp"
            android:text="添加"
            android:layout_marginStart="8dp"
            style="@style/Widget.Material3.Button.TonalButton"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="介绍"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/sticker_dir_text"
        android:id="@+id/et_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="表情包介绍（可选）"
        android:maxLines="3"
        android:minLines="2"
        android:inputType="textMultiLine"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="作者"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/sticker_dir_text"
        android:id="@+id/et_author"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="作者名"
        android:maxLines="1"
        android:inputType="text"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="版本号"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/sticker_dir_text"
        android:id="@+id/et_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="版本号"
        android:maxLines="1"
        android:inputType="number"/>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="封面"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_cover_preview"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">
        <ImageView
            android:id="@+id/iv_cover_preview"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:scaleType="centerCrop"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/sticker_dir_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="点击选择封面"
            android:layout_weight="1"
            android:layout_marginStart="12dp"/>
        <ImageView
            android:id="@+id/iv_cover_arrow"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/arrow_down_float"/>
    </LinearLayout>
    <top.suzhelan.qstory.ui.views.DialogXRecycleView
        android:id="@+id/rv_cover_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="8dp"/>
    <View
        android:background="#1a000000"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_btn_danger_text"
            android:gravity="center"
            android:id="@+id/tv_delete"
            android:background="@drawable/bg_dialog_btn_danger"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="6dp"
            android:text="删除"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_btn_danger_text"
            android:gravity="center"
            android:id="@+id/btn_upload"
            android:background="@drawable/bg_dialog_btn_primary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="6dp"
            android:text="上传"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_btn_danger_text"
            android:gravity="center"
            android:id="@+id/tv_save"
            android:background="@drawable/bg_dialog_btn_neutral"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="6dp"
            android:text="保存"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
