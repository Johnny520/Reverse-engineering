<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/AppTheme"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textAppearance="?attr/textAppearanceTitleSmall"
        android:textStyle="bold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="新建目录"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <EditText
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:textColorHint="?android:attr/textColorHint"
            android:id="@+id/et_new_dir_name"
            android:background="@drawable/bg_download_dir_input"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:hint="输入目录名称"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="text"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
        <top.suzhelan.sticker.sdk.widget.CustomMaterialButton
            android:textSize="13sp"
            android:id="@+id/btn_create_and_download"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="80dp"
            android:text="下载"
            android:layout_marginStart="8dp"
            style="@style/Widget.Material3.Button.TonalButton"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp">
        <View
            android:background="#1a000000"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="或选择已有目录"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <View
            android:background="#1a000000"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
    </LinearLayout>
    <top.suzhelan.sticker.sdk.widget.CustomRecycleView
        android:id="@+id/rv_dir_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="240dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:id="@+id/tv_empty_hint"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="暂无本地目录"/>
</LinearLayout>
