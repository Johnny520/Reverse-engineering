<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/AppTheme"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="13sp"
        android:textColor="@color/sticker_dir_text"
        android:id="@+id/tv_upload_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="标题"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/sticker_dir_text"
        android:id="@+id/tv_upload_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:id="@+id/label_upload_author"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="作者"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/sticker_dir_text"
        android:id="@+id/tv_upload_author"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:id="@+id/label_upload_tags"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="标签"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/sticker_dir_text"
        android:id="@+id/tv_upload_tags"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:id="@+id/label_upload_desc"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="描述"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/sticker_dir_text"
        android:id="@+id/tv_upload_desc"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="版本号"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/sticker_dir_text"
        android:id="@+id/tv_upload_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="封面"/>
    <ImageView
        android:id="@+id/iv_upload_cover"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="4dp"
        android:scaleType="fitCenter"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/sticker_dir_selected_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="附加上传信息"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_upload_uin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:paddingVertical="6dp">
        <top.suzhelan.qstory.ui.views.CustomMaterialCheckBox
            android:id="@+id/cb_upload_uin"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="上传自己的QQ号"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_upload_nickname"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="6dp">
        <top.suzhelan.qstory.ui.views.CustomMaterialCheckBox
            android:id="@+id/cb_upload_nickname"
            android:focusable="false"
            android:clickable="false"
            android:layout_width="28dp"
            android:layout_height="28dp"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/text_color"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="上传自己的QQ昵称"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</LinearLayout>
