<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_douyin_dialog"
    android:paddingTop="6dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <ScrollView
        android:fadingEdgeLength="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_douyin_edittext"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="32dp">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center_vertical"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:text="❤️ 获赞"
                        android:includeFontPadding="false"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/douyin_white"
                            android:gravity="center"
                            android:id="@+id/diggModeDirect"
                            android:background="@drawable/douyin_button_primary2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="直接修改"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/primary_text"
                            android:gravity="center"
                            android:id="@+id/diggModeAdd"
                            android:background="@drawable/douyin_button_secondary2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="原有增减"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/diggMinus"
                        android:background="@drawable/douyin_button_secondary2"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:text="−"
                        android:includeFontPadding="false"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center"
                        android:id="@+id/diggValue"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:hint="输入数值"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:selectAllOnFocus="true"
                        android:layout_weight="1"
                        android:inputType="numberSigned"
                        android:layout_marginHorizontal="8dp"
                        android:paddingHorizontal="10dp"/>
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/diggPlus"
                        android:background="@drawable/douyin_button_secondary2"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:text="+"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_douyin_edittext"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="32dp">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center_vertical"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:text="�� 互关"
                        android:includeFontPadding="false"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/douyin_white"
                            android:gravity="center"
                            android:id="@+id/mutualModeDirect"
                            android:background="@drawable/douyin_button_primary2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="直接修改"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/primary_text"
                            android:gravity="center"
                            android:id="@+id/mutualModeAdd"
                            android:background="@drawable/douyin_button_secondary2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="原有增减"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/mutualMinus"
                        android:background="@drawable/douyin_button_secondary2"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:text="−"
                        android:includeFontPadding="false"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center"
                        android:id="@+id/mutualValue"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:hint="输入数值"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:selectAllOnFocus="true"
                        android:layout_weight="1"
                        android:inputType="numberSigned"
                        android:layout_marginHorizontal="8dp"
                        android:paddingHorizontal="10dp"/>
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/mutualPlus"
                        android:background="@drawable/douyin_button_secondary2"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:text="+"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_douyin_edittext"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="32dp">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center_vertical"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:text="➕ 关注"
                        android:includeFontPadding="false"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/douyin_white"
                            android:gravity="center"
                            android:id="@+id/followingModeDirect"
                            android:background="@drawable/douyin_button_primary2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="直接修改"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/primary_text"
                            android:gravity="center"
                            android:id="@+id/followingModeAdd"
                            android:background="@drawable/douyin_button_secondary2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="原有增减"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/followingMinus"
                        android:background="@drawable/douyin_button_secondary2"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:text="−"
                        android:includeFontPadding="false"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center"
                        android:id="@+id/followingValue"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:hint="输入数值"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:selectAllOnFocus="true"
                        android:layout_weight="1"
                        android:inputType="numberSigned"
                        android:layout_marginHorizontal="8dp"
                        android:paddingHorizontal="10dp"/>
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/followingPlus"
                        android:background="@drawable/douyin_button_secondary2"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:text="+"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_douyin_edittext"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="32dp">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center_vertical"
                        android:layout_width="64dp"
                        android:layout_height="match_parent"
                        android:text="�� 粉丝"
                        android:includeFontPadding="false"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp">
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/douyin_white"
                            android:gravity="center"
                            android:id="@+id/fansModeDirect"
                            android:background="@drawable/douyin_button_primary2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="直接修改"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/primary_text"
                            android:gravity="center"
                            android:id="@+id/fansModeAdd"
                            android:background="@drawable/douyin_button_secondary2"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:text="原有增减"
                            android:includeFontPadding="false"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/fansMinus"
                        android:background="@drawable/douyin_button_secondary2"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:text="−"
                        android:includeFontPadding="false"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center"
                        android:id="@+id/fansValue"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:hint="输入数值"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:selectAllOnFocus="true"
                        android:layout_weight="1"
                        android:inputType="numberSigned"
                        android:layout_marginHorizontal="8dp"
                        android:paddingHorizontal="10dp"/>
                    <TextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/fansPlus"
                        android:background="@drawable/douyin_button_secondary2"
                        android:layout_width="40dp"
                        android:layout_height="match_parent"
                        android:text="+"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <Button
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:id="@+id/btnCancel"
            android:background="@drawable/douyin_button_secondary2"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:text="取消"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/douyin_white"
            android:id="@+id/btnSave"
            android:background="@drawable/douyin_button_primary2"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:text="保存"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
