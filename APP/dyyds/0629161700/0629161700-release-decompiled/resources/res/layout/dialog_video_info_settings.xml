<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bottom_sheet_background"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/secondary_text"
            android:paddingTop="12dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="展示方式"
            android:paddingStart="15dp"
            android:paddingEnd="20dp"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/videoInfoDialogTypeGroup"
            android:paddingBottom="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="15dp"
            android:paddingEnd="20dp">
            <RadioButton
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:gravity="center_vertical"
                android:id="@+id/videoInfoBottomDialogRadio"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:text="底部弹窗"
                android:layout_weight="1"
                android:buttonTint="@color/douyin_primary"/>
            <RadioButton
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:gravity="center_vertical"
                android:id="@+id/videoInfoMessageDialogRadio"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:text="弹窗"
                android:layout_weight="1"
                android:buttonTint="@color/douyin_primary"/>
        </RadioGroup>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="20dp"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/secondary_text"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示项目"
            android:paddingStart="15dp"
            android:paddingEnd="20dp"/>
        <Switch
            android:id="@+id/showLocationSwitch"
            android:text="发布地址"
            style="@style/VideoInfoSettingSwitch"/>
        <Switch
            android:id="@+id/showPublishTimeSwitch"
            android:text="发布时间"
            style="@style/VideoInfoSettingSwitch"/>
        <Switch
            android:id="@+id/showDurationSwitch"
            android:text="视频时长"
            style="@style/VideoInfoSettingSwitch"/>
        <Switch
            android:id="@+id/showStatisticsSwitch"
            android:text="点赞 / 评论 / 收藏 / 分享"
            style="@style/VideoInfoSettingSwitch"/>
        <Switch
            android:id="@+id/showVideoSwitch"
            android:text="视频信息下载"
            style="@style/VideoInfoSettingSwitch"/>
        <Switch
            android:id="@+id/showCoverSwitch"
            android:text="封面图片"
            style="@style/VideoInfoSettingSwitch"/>
        <Switch
            android:id="@+id/showCurrentImageSwitch"
            android:text="当前图片"
            style="@style/VideoInfoSettingSwitch"/>
        <Switch
            android:id="@+id/showMusicSwitch"
            android:text="音乐信息下载"
            style="@style/VideoInfoSettingSwitch"/>
        <Switch
            android:id="@+id/showDescriptionSwitch"
            android:text="视频文案"
            style="@style/VideoInfoSettingSwitch"/>
        <Switch
            android:id="@+id/showCopyDescriptionSwitch"
            android:text="复制文案按钮"
            style="@style/VideoInfoSettingSwitch"/>
    </LinearLayout>
</ScrollView>
