<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_douyin_dialog"
    android:padding="20dp"
    android:layout_width="340dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="设置文件名称"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="保存路径"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_douyin_edittext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:gravity="top"
            android:id="@+id/et_folder_path"
            android:background="@null"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:hint="请输入文件夹路径"
            android:maxLines="4"
            android:lines="2"
            android:layout_weight="1"
            android:inputType="textMultiLine"
            android:paddingVertical="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_folder_shortcuts"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <HorizontalScrollView
            android:scrollbars="none"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:overScrollMode="never">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <Button
                    android:textSize="12sp"
                    android:textColor="@color/primary_text"
                    android:id="@+id/btn_folder_default"
                    android:background="@drawable/douyin_button_secondary2"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="默认"
                    android:layout_marginEnd="6dp"
                    android:translationZ="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="4dp"/>
                <Button
                    android:textSize="12sp"
                    android:textColor="@color/primary_text"
                    android:id="@+id/btn_folder_download"
                    android:background="@drawable/douyin_button_secondary2"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="下载"
                    android:layout_marginEnd="6dp"
                    android:translationZ="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="4dp"/>
                <Button
                    android:textSize="12sp"
                    android:textColor="@color/primary_text"
                    android:id="@+id/btn_folder_dcim"
                    android:background="@drawable/douyin_button_secondary2"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="相册"
                    android:layout_marginEnd="6dp"
                    android:translationZ="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="4dp"/>
                <Button
                    android:textSize="12sp"
                    android:textColor="@color/primary_text"
                    android:id="@+id/btn_folder_pictures"
                    android:background="@drawable/douyin_button_secondary2"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="图片"
                    android:layout_marginEnd="6dp"
                    android:translationZ="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="4dp"/>
                <Button
                    android:textSize="12sp"
                    android:textColor="@color/primary_text"
                    android:id="@+id/btn_folder_movies"
                    android:background="@drawable/douyin_button_secondary2"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="视频"
                    android:layout_marginEnd="6dp"
                    android:translationZ="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="4dp"/>
                <Button
                    android:textSize="12sp"
                    android:textColor="@color/primary_text"
                    android:id="@+id/btn_folder_music"
                    android:background="@drawable/douyin_button_secondary2"
                    android:layout_width="64dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="音乐"
                    android:layout_marginEnd="6dp"
                    android:translationZ="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="4dp"/>
                <Button
                    android:textSize="12sp"
                    android:textColor="@color/primary_text"
                    android:id="@+id/btn_select_folder"
                    android:background="@drawable/douyin_button_secondary2"
                    android:layout_width="88dp"
                    android:layout_height="32dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="系统选择"
                    android:translationZ="0dp"
                    android:elevation="0dp"
                    android:stateListAnimator="@null"
                    android:paddingHorizontal="4dp"/>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="文件名称"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_douyin_edittext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:gravity="top"
            android:id="@+id/et_file_name"
            android:background="@null"
            android:scrollbars="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="40dp"
            android:hint="请输入文件名称"
            android:maxLines="4"
            android:lines="2"
            android:layout_weight="1"
            android:inputType="textMultiLine"
            android:paddingVertical="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/hint_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="提示:文件名需要包含扩展名(如.mp4/.mp3)"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <Button
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:id="@+id/btn_cancel"
            android:background="@drawable/douyin_button_secondary2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="取消"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/douyin_white"
            android:id="@+id/btn_confirm"
            android:background="@drawable/douyin_button_primary2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="确定"
            android:layout_weight="1"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
