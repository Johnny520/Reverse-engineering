<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_douyin_dialog"
    android:paddingBottom="20dp"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:id="@+id/tvWardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="插眼"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"/>
        <ImageView
            android:id="@+id/ivClose"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/close"
            android:tint="@color/primary_text"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/userHistoryCard"
            android:background="@drawable/bg_douyin_edittext"
            android:padding="14dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/ivUserAvatar"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/dihua"
                    android:scaleType="centerCrop"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:ellipsize="end"
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="用户昵称"
                        android:maxLines="1"
                        android:fontFamily="sans-serif-medium"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:id="@+id/tvUserStats"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="首次插眼此用户"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layoutHistoryCategories"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <View
                    android:background="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="10dp"
                    android:alpha="0.1"/>
                <HorizontalScrollView
                    android:scrollbars="none"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:overScrollMode="never">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/layoutHistoryCategoryTags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分类"
                android:layout_centerVertical="true"
                android:alpha="0.8"
                android:fontFamily="sans-serif-medium"
                android:layout_alignParentStart="true"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/douyin_primary"
                android:id="@+id/btnManageCategory"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="管理"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/primary_text"
            android:gravity="center_vertical"
            android:id="@+id/spinnerCategory"
            android:background="@drawable/bg_ward_input"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="24dp"
            android:text=""
            android:hint="请选择分类"
            android:singleLine="true"
            android:drawableEnd="@mipmap/img_drawable_down"
            android:paddingStart="16dp"
            android:paddingEnd="6dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="备注"
            android:alpha="0.8"
            android:fontFamily="sans-serif-medium"/>
        <EditText
            android:textSize="15sp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:gravity="start|top"
            android:id="@+id/etRemark"
            android:background="@drawable/bg_ward_input"
            android:padding="16dp"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginBottom="28dp"
            android:hint="请输入备注信息..."
            android:maxLength="100"
            android:lineSpacingExtra="2dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:id="@+id/btnWardCancel"
            android:background="@drawable/douyin_button_secondary2"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:text="取消"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btnWardSave"
            android:background="@drawable/douyin_button_primary"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:text="保存"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>
