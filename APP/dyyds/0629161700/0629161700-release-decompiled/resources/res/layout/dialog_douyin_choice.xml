<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/dialog_root"
    android:background="@drawable/bg_douyin_dialog"
    android:paddingTop="24dp"
    android:paddingBottom="20dp"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/dialog_title_color"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/dialog_message_color"
        android:gravity="center"
        android:id="@+id/dialog_message"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="4dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"/>
    <ScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioGroup
                android:orientation="vertical"
                android:id="@+id/radio_group"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/checkbox_layout"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"/>
        </FrameLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/dialog_button_secondary_text"
            android:gravity="center"
            android:id="@+id/button_left"
            android:background="@drawable/bg_douyin_button_secondary"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"/>
        <View
            android:id="@+id/button_divider"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/button_right"
            android:background="@drawable/bg_douyin_button_primary"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
