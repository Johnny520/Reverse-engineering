<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/dialog_bg_mask"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/layoutDialogContent"
        android:background="@drawable/bg_douyin_dialog"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="40dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="20dp"
            android:paddingEnd="12dp">
            <TextView
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:id="@+id/tvDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="消息内容"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/douyin_primary"
                android:id="@+id/tvMessageType"
                android:background="@drawable/bg_json_type_tag"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="类型 7"
                android:layout_centerVertical="true"
                android:fontFamily="sans-serif"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginStart="10dp"
                android:layout_toEndOf="@+id/tvDialogTitle"/>
            <ImageView
                android:id="@+id/ivCloseJson"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_close"
                android:tint="@color/secondary_text"
                android:layout_centerVertical="true"
                android:contentDescription="关闭"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ScrollView
                android:id="@+id/scrollViewJson"
                android:background="@color/json_background"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxHeight="300dp"
                android:minHeight="180dp"
                android:fadeScrollbars="false">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/primary_text"
                    android:id="@+id/tvJsonContent"
                    android:padding="18dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:lineSpacingExtra="3dp"
                    android:textIsSelectable="true"
                    android:fontFamily="monospace"/>
            </ScrollView>
            <TextView
                android:textSize="10sp"
                android:textColor="@color/secondary_text"
                android:layout_gravity="end"
                android:background="@drawable/bg_json_type_tag"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:text="JSON"
                android:alpha="0.6"
                android:fontFamily="monospace"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
        </FrameLayout>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/secondary_text"
                android:gravity="center"
                android:id="@+id/btnSaveEmoji"
                android:background="?android:attr/selectableItemBackground"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="保存表情"
                android:layout_weight="1"
                android:fontFamily="sans-serif"/>
            <View
                android:id="@+id/dividerEmoji"
                android:background="@color/divider_color"
                android:visibility="gone"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/secondary_text"
                android:gravity="center"
                android:id="@+id/btnSaveJson"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="保存"
                android:layout_weight="1"
                android:fontFamily="sans-serif"/>
            <View
                android:background="@color/divider_color"
                android:layout_width="0.5dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/douyin_primary"
                android:gravity="center"
                android:id="@+id/btnCopy"
                android:background="?android:attr/selectableItemBackground"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:text="复制"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
