<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/surface_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="本地备份"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/secondary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="导出为本地文件，或从本地文件恢复配置与插眼数据。"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:gravity="center"
                    android:background="@drawable/bg_opacity_value"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="全"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="完整备份"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="模块配置 + 插眼数据"/>
                </LinearLayout>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:gravity="center"
                    android:background="@drawable/bg_opacity_value"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:text="ZIP"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/dialog_button_secondary_text"
                    android:gravity="center"
                    android:id="@+id/btn_import"
                    android:background="@drawable/bg_douyin_button_secondary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:text="导入"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/btn_export"
                    android:background="@drawable/bg_douyin_button_primary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:text="导出"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:gravity="center"
                    android:background="@drawable/bg_opacity_value"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="配"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="模块配置"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="开关、筛选、样式等模块设置"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/dialog_button_secondary_text"
                    android:gravity="center"
                    android:id="@+id/btn_import_config"
                    android:background="@drawable/bg_douyin_button_secondary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:text="导入配置"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/btn_export_config"
                    android:background="@drawable/bg_douyin_button_primary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:text="导出配置"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:gravity="center"
                    android:background="@drawable/bg_opacity_value"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:text="眼"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="插眼数据"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="插眼记录、分类和备注"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/dialog_button_secondary_text"
                    android:gravity="center"
                    android:id="@+id/btn_import_ward"
                    android:background="@drawable/bg_douyin_button_secondary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:text="导入插眼"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/btn_export_ward"
                    android:background="@drawable/bg_douyin_button_primary"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:text="导出插眼"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
