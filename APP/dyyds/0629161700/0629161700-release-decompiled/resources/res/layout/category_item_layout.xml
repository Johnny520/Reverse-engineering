<?xml version="1.0" encoding="utf-8"?>
<com.android.app.CustomCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:id="@+id/btnDragCategory"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="☰"
            android:alpha="0.45"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:id="@+id/tvCategoryName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="�� 重要内容"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:gravity="center"
            android:id="@+id/btnEditCategory"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="visible"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="✏️"
            android:alpha="0.6"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="14sp"
            android:gravity="center"
            android:id="@+id/btnDeleteCategory"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:visibility="visible"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="��️"
            android:alpha="0.6"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
</com.android.app.CustomCardView>
