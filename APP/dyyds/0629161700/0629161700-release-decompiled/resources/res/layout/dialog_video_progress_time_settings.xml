<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_toast_bg"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:minWidth="120dp"
    android:minHeight="120dp">
    <FrameLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp">
        <TextView
            android:textColor="@android:color/white"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:text="视频进度条时间设置"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btnClose"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_close"/>
    </FrameLayout>
    <View
        android:background="#ececec"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <TextView
                android:textColor="@android:color/white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="总开关"
                android:layout_weight="1"/>
            <Switch
                android:id="@+id/switchLeftTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textColor="@android:color/white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="始终显示进度条时间"
                android:layout_weight="1"/>
            <Switch
                android:id="@+id/alwaysShowProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textColor="@android:color/white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="跟随进度条显示隐藏"
                android:layout_weight="1"/>
            <Switch
                android:id="@+id/switchLeftTimeFollowVisibility"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/leftColorLayout"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textColor="@android:color/white"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="字体颜色"
                android:layout_weight="1"/>
            <View
                android:id="@+id/viewLeftColorPreview"
                android:background="@drawable/bg_color_preview"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textColor="@android:color/white"
                android:id="@+id/tvLeftColorValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="65dp"
                android:text="#FFFFFF"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="字大小"/>
            <SeekBar
                android:id="@+id/seekbarLeftTimeSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="20"
                android:progress="8"
                android:layout_weight="1"
                android:min="6"/>
            <TextView
                android:textColor="@android:color/white"
                android:id="@+id/tvLeftTimeSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:text="8sp"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btnLeftTimeSizeMinus"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:text="-"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btnLeftTimeSizePlus"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:text="+"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="透明度"/>
            <SeekBar
                android:id="@+id/seekbarLeftTimeAlpha"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="100"
                android:progress="100"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@android:color/white"
                android:id="@+id/tvLeftTimeAlpha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:text="100"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btnLeftTimeAlphaMinus"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:text="-"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btnLeftTimeAlphaPlus"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:text="+"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="左边距"/>
            <SeekBar
                android:id="@+id/seekbarLeftTimeMarginStart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="80"
                android:progress="52"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@android:color/white"
                android:id="@+id/tvLeftTimeMarginStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:text="12dp"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btnLeftTimeMarginStartMinus"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:text="-"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btnLeftTimeMarginStartPlus"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:text="+"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textColor="@android:color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="下边距"/>
            <SeekBar
                android:id="@+id/seekbarLeftTimeMarginBottom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:max="80"
                android:progress="30"
                android:layout_weight="1"/>
            <TextView
                android:textColor="@android:color/white"
                android:id="@+id/tvLeftTimeMarginBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="40dp"
                android:text="30dp"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btnLeftTimeMarginBottomMinus"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:text="-"/>
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:gravity="center"
                android:id="@+id/btnLeftTimeMarginBottomPlus"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="25dp"
                android:layout_height="wrap_content"
                android:text="+"
                android:layout_marginStart="5dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
