<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_setting_group_card"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="基础设置"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="隐藏回复按钮"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/hideReply"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="隐藏底部输入栏"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/hideBottomInputBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="禁用点击评论事件"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/disableItemClick"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="复制评论去除艾特"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/disableCopyAt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="开启评论语音替换"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/replaceAudioComment"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/primary_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="打开评论时自动暂停视频"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/secondary_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="关闭评论时恢复播放"/>
                    </LinearLayout>
                    <Switch
                        android:id="@+id/commentPauseVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="禁止打开评论时缩放视频"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/disableCommentScaleVideo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="隐藏评论区左上角广告，相关搜索"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/hideCommentHeaderAd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/commentMenuHiddenLayout"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="评论区菜单项隐藏"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:id="@+id/commentMenuHiddenCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未设置"/>
                </LinearLayout>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/commentDialogMenuLayout"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="评论弹窗模块显示项"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:id="@+id/commentDialogMenuCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已显示 8 项"/>
                </LinearLayout>
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="禁止没有评论时弹出输入框"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/disableCommentEmptyInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_setting_group_card"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="点赞设置"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="隐藏点赞按钮"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/hideDigg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
                <View
                    android:id="@+id/diggAlertView"
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/diggAlertRl"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="点赞添加提示"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/diggAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_setting_group_card"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="踩设置"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="隐藏踩按钮"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/hideBury"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
                <View
                    android:id="@+id/buryAlertView"
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/buryAlertRl"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="踩添加确认提示"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/buryAlert"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_setting_group_card"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="时间显示"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="评论显示具体时间"
                        android:layout_weight="1"/>
                    <Switch
                        android:id="@+id/showTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/showTimePatternRl"
                    android:paddingTop="8dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="30dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:text="时间显示模板"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:id="@+id/showTimeTemplate"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="例如: ${originalText} ${time}"
                        android:maxLines="1"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:imeActionLabel="保存"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"/>
                    <LinearLayout
                        android:gravity="start"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/hint_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="占位符: "/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/douyin_primary"
                            android:id="@+id/placeholderOriginalText"
                            android:background="?android:attr/selectableItemBackground"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="${originalText}"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/hint_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 原文,  "/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/douyin_primary"
                            android:id="@+id/placeholderTime"
                            android:background="?android:attr/selectableItemBackground"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="${time}"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"/>
                        <TextView
                            android:textSize="11sp"
                            android:textColor="@color/hint_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" 时间"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:text="日期格式"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:id="@+id/showTimePattern"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:hint="例如: yyyy-MM-dd HH:mm"
                        android:maxLines="1"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:imeActionLabel="保存"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_setting_group_card"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="文字设置"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:paddingTop="8dp"
                    android:paddingBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp">
                        <TextView
                            android:textSize="14sp"
                            android:textColor="@color/primary_text"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="评论文字颜色"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingStart="15dp"
                        android:paddingEnd="0dp">
                        <EditText
                            android:textSize="14sp"
                            android:textColor="@color/primary_text"
                            android:textColorHint="@color/hint_text"
                            android:gravity="center_vertical"
                            android:id="@+id/commentTextColorEditText"
                            android:background="@drawable/round_edit_bg"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:hint="例如: #FFFFFF 或留空使用默认"
                            android:maxLines="1"
                            android:layout_weight="1"
                            android:inputType="text"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"/>
                        <View
                            android:id="@+id/commentColorPreview"
                            android:background="@drawable/round_edit_bg"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="40dp"
                            android:layout_height="38dp"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_setting_group_card"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="背景设置"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/commentBgSettingLayout"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="评论区背景"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:id="@+id/commentBgSettingValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="未启用"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_setting_group_card"
                android:paddingTop="8dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="过滤设置"
                    android:layout_marginStart="16dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/commentFilterLayout"
                    android:background="?android:attr/selectableItemBackground"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="评论文字过滤"
                        android:layout_weight="1"/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:id="@+id/commentFilterCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="已设置 0 个"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
