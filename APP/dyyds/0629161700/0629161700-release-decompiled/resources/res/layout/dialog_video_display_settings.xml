<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/round_edit_bg"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:id="@+id/showPublishTimeLayout"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/primary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="显示发布时间"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"/>
                <Switch
                    android:id="@+id/showPublishTimeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:thumb="@drawable/switch_thumb"
                    android:layout_centerVertical="true"
                    android:track="@drawable/switch_track"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/round_edit_bg"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/timeFormatInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="时间格式"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center_vertical"
                    android:id="@+id/timeFormatEditText"
                    android:background="@drawable/round_edit_bg"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:hint="yyyy-MM-dd HH:mm"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/displayTemplateInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="显示模板"/>
                    <EditText
                        android:textSize="13sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center_vertical"
                        android:id="@+id/displayTemplateEditText"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:hint="{time} 发布地: {location}"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginStart="12dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="快捷插入："/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/douyin_primary"
                        android:id="@+id/insertTimePlaceholderText"
                        android:background="@drawable/round_edit_bg"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="时间"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/douyin_primary"
                        android:id="@+id/insertLocationPlaceholderText"
                        android:background="@drawable/round_edit_bg"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="地址"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/round_edit_bg"
            android:padding="12dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/textSizeInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="字体大小"/>
                    <EditText
                        android:textSize="13sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center_vertical"
                        android:id="@+id/textSizeEditText"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="0dp"
                        android:layout_height="42dp"
                        android:hint="sp"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:inputType="number"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/colorfulDisplayLayout"
                    android:background="?android:attr/selectableItemBackground"
                    android:clickable="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="多彩显示"/>
                    <Switch
                        android:id="@+id/colorfulDisplaySwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:thumb="@drawable/switch_thumb"
                        android:track="@drawable/switch_track"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/textColorInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="文字颜色"/>
                <EditText
                    android:textSize="13sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center_vertical"
                    android:id="@+id/textColorEditText"
                    android:background="@drawable/round_edit_bg"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:hint="#FFFFFF 或留空"
                    android:maxLines="1"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_marginStart="12dp"/>
                <View
                    android:id="@+id/colorPreview"
                    android:background="@drawable/round_edit_bg"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
