<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/download_dialog_root"
    android:background="@drawable/bg_douyin_dialog"
    android:paddingTop="22dp"
    android:paddingBottom="20dp"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    android:paddingStart="22dp"
    android:paddingEnd="22dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_title_color"
            android:id="@+id/tv_download_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="文件下载"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/douyin_primary"
            android:id="@+id/tv_download_badge"
            android:background="@drawable/bg_download_status_chip"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="准备中"
            android:includeFontPadding="false"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:layout_marginEnd="10dp"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:id="@+id/btn_close_download"
            android:background="@drawable/bg_download_close_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="×"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_download_file_card"
        android:background="@drawable/bg_download_info_card"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/secondary_text"
            android:id="@+id/tv_download_file_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存文件"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_item_text"
            android:ellipsize="middle"
            android:id="@+id/tv_download_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dialog_message_color"
            android:ellipsize="middle"
            android:id="@+id/tv_download_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_item_text"
            android:id="@+id/tv_download_progress_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="下载进度"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/douyin_primary"
            android:id="@+id/tv_download_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <ProgressBar
        android:id="@+id/progress_download"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:max="1000"
        android:progress="0"
        android:indeterminate="false"
        android:progressDrawable="@drawable/download_progress_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_download_info_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginEnd="8dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="已下载"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/dialog_item_text"
                android:ellipsize="end"
                android:id="@+id/tv_downloaded_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="0 B"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_download_info_card"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="8dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="文件大小"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/dialog_item_text"
                android:ellipsize="end"
                android:id="@+id/tv_total_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="未知"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btn_cancel_download"
        android:background="@drawable/bg_download_cancel_button"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="22dp"
        android:text="取消下载"
        android:includeFontPadding="false"/>
</LinearLayout>
