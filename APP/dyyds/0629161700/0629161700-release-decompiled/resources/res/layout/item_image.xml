<?xml version="1.0" encoding="utf-8"?>
<com.android.app.CustomCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/media_container"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:clipToOutline="true">
            <ImageView
                android:id="@+id/iv_media"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="图片"/>
            <TextView
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/douyin_white"
                android:gravity="center"
                android:id="@+id/tv_sequence_number"
                android:background="@drawable/sequence_number_background"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:minWidth="15dp"
                android:minHeight="15dp"
                android:text="1"
                android:layout_alignParentTop="true"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="5dp"
                android:layout_alignParentStart="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"/>
            <CheckBox
                android:textSize="11sp"
                android:textColor="@color/douyin_white"
                android:id="@+id/checkbox_select"
                android:background="@drawable/sequence_number_background"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="选择"
                android:layout_alignParentTop="true"
                android:paddingStart="6dp"
                android:paddingEnd="8dp"
                android:layout_marginEnd="5dp"
                android:layout_alignParentEnd="true"
                android:buttonTint="@color/douyin_white"/>
            <LinearLayout
                android:orientation="horizontal"
                android:id="@+id/button_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="5dp"
                android:layout_alignParentBottom="true"
                android:layout_marginEnd="5dp"
                android:layout_alignParentEnd="true">
                <Button
                    android:textSize="10sp"
                    android:textColor="@color/douyin_white"
                    android:id="@+id/btn_save_gif"
                    android:background="@drawable/douyin_button_save_gif"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="保存实况"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
                <Button
                    android:textSize="10sp"
                    android:textColor="@color/douyin_white"
                    android:id="@+id/btn_save_video"
                    android:background="@drawable/douyin_button_secondary"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="保存视频"
                    android:layout_marginEnd="4dp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
                <Button
                    android:textSize="10sp"
                    android:textColor="@color/douyin_white"
                    android:id="@+id/btn_save_image"
                    android:background="@drawable/douyin_button_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="保存图片"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</com.android.app.CustomCardView>
