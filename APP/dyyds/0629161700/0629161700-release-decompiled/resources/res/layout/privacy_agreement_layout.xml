<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_douyin_dialog"
    android:padding="20dp"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/dialog_title_color"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="隐私协议"/>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/primary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="本模块为免费模块，严禁任何形式的售卖。如在咸鱼，酷安等平台付费获取，请立即退款。\10本模块仅供个人学习研究使用，严禁用于商业用途，请于24小时内删除，请勿将本模块分享到国内任何平台（包括但不限于咸鱼、微信、QQ、微博、抖音、快手、酷安、B站等）。\10请您认真阅读并同意以上条款。"
        android:lineSpacingExtra="6dp"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/primary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="请在下方输入框输入以下承诺后再同意：免费模块我承诺不倒卖我承诺不在国内传播我承诺不用于商业用途及非法用途"
        android:lineSpacingExtra="2dp"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/primary_text"
        android:textColorHint="@color/secondary_text"
        android:gravity="start|top"
        android:id="@+id/et_commitment_input"
        android:background="@drawable/bg_privacy_commitment_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="请输入：免费模块我承诺不倒卖我承诺不在国内传播我承诺不用于商业用途及非法用途"
        android:maxLines="4"
        android:minLines="2"
        android:inputType="textMultiLine"
        android:imeOptions="actionDone"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <Button
            android:textSize="14sp"
            android:textColor="@color/dialog_button_secondary_text"
            android:id="@+id/btn_cancel"
            android:background="@drawable/douyin_button_secondary2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="朕不同意"
            android:layout_weight="1"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <Space
            android:layout_width="10dp"
            android:layout_height="wrap_content"/>
        <Button
            android:enabled="false"
            android:textSize="14sp"
            android:textColor="@color/douyin_white"
            android:id="@+id/btn_confirm"
            android:background="@drawable/douyin_button_primary2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="朕同意 (5)"
            android:layout_weight="1"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
