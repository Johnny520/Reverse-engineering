<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_video_preview_button"
    android:paddingLeft="12dp"
    android:paddingTop="10dp"
    android:paddingRight="12dp"
    android:paddingBottom="10dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">
    <TextView
        android:textSize="11sp"
        android:textColor="#8fe4e9ef"
        android:id="@+id/tv_menu_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="点击预览"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#f4f6f8"
        android:id="@+id/tv_menu_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@+id/tv_menu_status"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#a6d7dce3"
        android:id="@+id/tv_menu_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/tv_menu_name"
        android:layout_alignParentStart="true"/>
    <TextView
        android:textSize="10sp"
        android:textColor="#bfd7dce3"
        android:id="@+id/tv_menu_class"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:layout_below="@+id/tv_menu_meta"
        android:layout_alignParentStart="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_item_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_below="@+id/tv_menu_class"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="10sp"
            android:textColor="#bfd7dce3"
            android:id="@+id/tv_menu_visibility"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#bfd7dce3"
            android:id="@+id/tv_alpha_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_below="@+id/layout_item_state"
        android:layout_alignParentStart="true">
        <TextView
            android:textSize="11sp"
            android:textColor="#eef2f6"
            android:gravity="center"
            android:id="@+id/btn_toggle_visibility"
            android:background="@drawable/bg_video_preview_button"
            android:paddingLeft="10dp"
            android:paddingTop="6dp"
            android:paddingRight="10dp"
            android:paddingBottom="6dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:text="隐藏"/>
        <SeekBar
            android:id="@+id/seekbar_alpha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="100"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:progressTint="@color/douyin_primary"
            android:progressBackgroundTint="#24ffffff"
            android:thumbTint="@color/douyin_primary"/>
    </LinearLayout>
</RelativeLayout>
