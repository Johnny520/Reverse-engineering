<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_douyin_dialog"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="编辑分组"/>
    <ScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="分组名称"/>
            <EditText
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:id="@+id/et_group_name"
                android:background="@drawable/bg_douyin_edittext"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="请输入分组名称"
                android:inputType="text"
                android:paddingHorizontal="12dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="延迟区间（毫秒）"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="轮询发送消息时每条消息的延迟间隔"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center"
                    android:id="@+id/et_delay_start"
                    android:background="@drawable/bg_douyin_edittext"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:hint="2000"
                    android:layout_weight="1"
                    android:inputType="number"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="至"
                    android:layout_marginHorizontal="8dp"/>
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center"
                    android:id="@+id/et_delay_end"
                    android:background="@drawable/bg_douyin_edittext"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:hint="4000"
                    android:layout_weight="1"
                    android:inputType="number"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="到点发送"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/switch_scheduled_send"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="开启后启动时不会立即发送，只有到了设置时间且抖音正在前台运行时才会发送"/>
            <EditText
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:gravity="center_vertical"
                android:id="@+id/et_scheduled_send_time"
                android:background="@drawable/bg_douyin_edittext"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:hint="16:48"
                android:maxLength="5"
                android:inputType="text"
                android:paddingHorizontal="12dp"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="随机消息内容（一行一条）"/>
            <EditText
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:gravity="start|top"
                android:id="@+id/et_messages"
                android:background="@drawable/bg_douyin_edittext"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="8dp"
                android:hint="[续火花吧]"
                android:maxLines="8"
                android:inputType="textMultiLine"
                android:paddingHorizontal="12dp"
                android:paddingVertical="12dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="使用每日一言"
                    android:layout_weight="1"/>
                <Switch
                    android:id="@+id/switch_hitokoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:thumb="@drawable/switch_thumb"
                    android:track="@drawable/switch_track"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="开启后将调用每日一言API获取消息内容"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_hitokoto_config"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="句子分类"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/hint_text"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_hitokoto_categories"
                    android:background="@drawable/bg_douyin_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="点击选择分类"
                    android:paddingHorizontal="12dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="消息模板"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/hint_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="可用变量：{hitokoto} {from} {from_who} {type}"/>
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:id="@+id/et_hitokoto_template"
                    android:background="@drawable/bg_douyin_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:hint="{hitokoto}"
                    android:inputType="text"
                    android:paddingHorizontal="12dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="获取失败时"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_fail_strategy"
                    android:background="@drawable/bg_douyin_edittext"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="使用随机文本"
                    android:paddingHorizontal="12dp"/>
            </LinearLayout>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="白名单时间段（可选）"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="仅在设置的时间段内发送消息，不设置则不限制"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center"
                    android:id="@+id/et_time_start"
                    android:background="@drawable/bg_douyin_edittext"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:hint="08:00"
                    android:maxLength="5"
                    android:layout_weight="1"
                    android:inputType="text"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="至"
                    android:layout_marginHorizontal="8dp"/>
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center"
                    android:id="@+id/et_time_end"
                    android:background="@drawable/bg_douyin_edittext"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:hint="21:00"
                    android:maxLength="5"
                    android:layout_weight="1"
                    android:inputType="text"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <Button
            android:textSize="14sp"
            android:textColor="@color/warning_red"
            android:id="@+id/btn_delete"
            android:background="@drawable/douyin_button_secondary2"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="删除"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:id="@+id/btn_cancel"
            android:background="@drawable/douyin_button_secondary2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="取消"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/douyin_white"
            android:id="@+id/btn_save"
            android:background="@drawable/douyin_button_primary2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="保存"
            android:layout_weight="1"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
