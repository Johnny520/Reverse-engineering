<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_toast_bg"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:minWidth="120dp"
    android:minHeight="120dp">
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/header_drag_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#f4f6f8"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:text="视频控件预览"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_window_list_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_close"/>
    </FrameLayout>
    <View
        android:background="#20ffffff"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="15dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="11sp"
                android:textColor="#eef2f6"
                android:gravity="center"
                android:id="@+id/btn_previous"
                android:background="@drawable/bg_video_preview_button"
                android:paddingLeft="10dp"
                android:paddingTop="7dp"
                android:paddingRight="10dp"
                android:paddingBottom="7dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="上一个"
                android:layout_weight="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#eef2f6"
                android:gravity="center"
                android:id="@+id/btn_next"
                android:background="@drawable/bg_video_preview_button"
                android:paddingLeft="10dp"
                android:paddingTop="7dp"
                android:paddingRight="10dp"
                android:paddingBottom="7dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="下一个"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="#eef2f6"
                android:gravity="center"
                android:id="@+id/btn_refresh"
                android:background="@drawable/bg_video_preview_button"
                android:paddingLeft="10dp"
                android:paddingTop="7dp"
                android:paddingRight="10dp"
                android:paddingBottom="7dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="刷新列表"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/sv_video_menu_list"
            android:background="@drawable/bg_video_preview_panel"
            android:padding="8dp"
            android:layout_width="match_parent"
            android:layout_height="280dp"
            android:layout_marginTop="10dp"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_video_menu_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_empty"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="14sp"
                android:textColor="#f4f6f8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无可预览控件"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#99d3d7dd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="先进入一个视频页面，等待控件完成注册"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
