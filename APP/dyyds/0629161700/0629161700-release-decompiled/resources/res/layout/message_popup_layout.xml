<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="15dp">
    <RelativeLayout
        android:id="@+id/mark_read"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="54dp">
        <ImageView
            android:id="@+id/icon_general"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/dog"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清除未读"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/icon_general"/>
    </RelativeLayout>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <RelativeLayout
        android:id="@+id/user_profile"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="54dp">
        <ImageView
            android:id="@+id/user_profile_icon_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/dog"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_text"
            android:id="@+id/user_profile_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="uid打开主页"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/user_profile_icon_iv"/>
    </RelativeLayout>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
    <RelativeLayout
        android:id="@+id/module_setting"
        android:background="?android:attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="54dp">
        <ImageView
            android:id="@+id/icon_iv"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/dog"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_text"
            android:id="@+id/module_setting_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="模块设置"
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/icon_iv"/>
    </RelativeLayout>
</LinearLayout>
