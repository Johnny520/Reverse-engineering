<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/surface_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_white"
                    android:gravity="center"
                    android:background="@drawable/bg_ward_filter_selected"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="#"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="文案关键词"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="一行一个关键词，支持正则表达式"/>
                </LinearLayout>
            </LinearLayout>
            <EditText
                android:scrollbarStyle="insideInset"
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:gravity="start|top"
                android:id="@+id/et_content"
                android:background="@drawable/round_edit_bg"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="118dp"
                android:layout_marginTop="12dp"
                android:hint="广告\10推广\10.*直播间.*"
                android:scrollHorizontally="false"
                android:singleLine="false"
                android:inputType="textMultiLine"
                android:overScrollMode="always"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_white"
                    android:gravity="center"
                    android:background="@drawable/bg_ward_filter_selected"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="D"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="发布时间"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="超过指定天数的视频会被过滤，0 表示关闭"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:background="@drawable/bg_save_path_placeholder"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:paddingStart="12dp"
                android:paddingEnd="10dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="发布距今天数"
                    android:layout_weight="1"/>
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center"
                    android:id="@+id/et_publish_days"
                    android:background="@drawable/round_edit_bg"
                    android:layout_width="112dp"
                    android:layout_height="36dp"
                    android:hint="0"
                    android:inputType="number"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:padding="14dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_white"
                    android:gravity="center"
                    android:background="@drawable/bg_ward_filter_selected"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:text="N"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="互动数量"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="低于对应数量的视频会被过滤，0 表示关闭"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_save_path_placeholder"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="点赞"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center_vertical"
                        android:id="@+id/et_low_likes"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:hint="100"
                        android:inputType="number"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_save_path_placeholder"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="评论"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center_vertical"
                        android:id="@+id/et_low_comments"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:hint="20"
                        android:inputType="number"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_save_path_placeholder"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="收藏"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center_vertical"
                        android:id="@+id/et_low_favorites"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:hint="50"
                        android:inputType="number"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:background="@drawable/bg_save_path_placeholder"
                    android:padding="10dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="转发"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center_vertical"
                        android:id="@+id/et_low_shares"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:layout_marginTop="6dp"
                        android:hint="10"
                        android:inputType="number"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
