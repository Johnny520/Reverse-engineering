<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_setting_group_card"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:id="@+id/abEditorTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="添加 A/B 覆盖"/>
    <ScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实验 Key"/>
            <EditText
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:id="@+id/abEditorKey"
                android:background="@drawable/round_edit_bg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:hint="例如 profile_show_search_entrance_v3"
                android:maxLines="1"
                android:inputType="textNoSuggestions"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:importantForAutofill="no"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="返回类型"/>
            <Spinner
                android:id="@+id/abEditorType"
                android:background="@drawable/round_edit_bg"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="5dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="覆盖值"/>
            <EditText
                android:textSize="13sp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:gravity="start|top"
                android:id="@+id/abEditorValue"
                android:background="@drawable/round_edit_bg"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:layout_marginTop="5dp"
                android:inputType="textNoSuggestions"
                android:importantForAutofill="no"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/secondary_text"
                android:id="@+id/abEditorHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"/>
            <Switch
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:gravity="center_vertical"
                android:id="@+id/abEditorEnabled"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:thumb="@drawable/switch_thumb"
                android:text="启用此覆盖"
                android:track="@drawable/switch_track"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/warning_red"
                android:id="@+id/abEditorError"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="end|center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/warning_red"
            android:gravity="center"
            android:id="@+id/abEditorDelete"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="删除覆盖"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:id="@+id/abEditorCancel"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="取消"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/douyin_primary"
            android:gravity="center"
            android:id="@+id/abEditorSave"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="保存"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"/>
    </LinearLayout>
</LinearLayout>
