<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/surface_bg"
    android:paddingTop="8dp"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/secondary_text"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="互动功能"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_setting_group_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/customDiceLayout"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:importantForAccessibility="no"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="自定义骰子/猜拳"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="可以自定义点数和猜拳结果"
                    android:lineSpacingExtra="1dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/customDiceSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumb="@drawable/switch_thumb"
                android:contentDescription="自定义骰子和猜拳，可以自定义点数和猜拳结果"
                android:track="@drawable/switch_track"/>
        </LinearLayout>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/chatSwipeReplyLayout"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:importantForAccessibility="no"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="侧滑消息快捷回复"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="向左或向右滑动消息即可快捷回复"
                    android:lineSpacingExtra="1dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/chatSwipeReplySwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:thumb="@drawable/switch_thumb"
                android:contentDescription="侧滑消息快捷回复，向左或向右滑动消息即可回复"
                android:track="@drawable/switch_track"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/secondary_text"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="消息时间"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_setting_group_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/alwaysShowTimeLayout"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:importantForAccessibility="no"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="始终显示每条消息时间"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="显示抖音原有的消息时间提示"
                    android:lineSpacingExtra="1dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/alwaysShowTimeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumb="@drawable/switch_thumb"
                android:contentDescription="始终显示每条消息时间，显示抖音原有的消息时间提示"
                android:track="@drawable/switch_track"/>
        </LinearLayout>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/showChatMessageTimeLayout"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:importantForAccessibility="no"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="消息下方显示发送时间"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="对方消息左对齐，自己消息右对齐"
                    android:lineSpacingExtra="1dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/showChatMessageTimeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumb="@drawable/switch_thumb"
                android:contentDescription="消息下方显示发送时间，对方消息左对齐，自己消息右对齐"
                android:track="@drawable/switch_track"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/chatMessageTimeStyleLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="消息时间样式"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="字体大小"
                    android:layout_weight="1"
                    android:labelFor="@+id/chatMessageTimeTextSizeEditText"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:gravity="center"
                    android:id="@+id/chatMessageTimeTextSizeMinus"
                    android:background="@drawable/bg_douyin_button_secondary"
                    android:padding="0dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="32dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="−"
                    android:contentDescription="减小字体大小"/>
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center"
                    android:id="@+id/chatMessageTimeTextSizeEditText"
                    android:background="@drawable/round_edit_bg"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="56dp"
                    android:layout_height="36dp"
                    android:minHeight="0dp"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:maxLength="3"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:layout_marginStart="4dp"/>
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:gravity="center"
                    android:id="@+id/chatMessageTimeTextSizePlus"
                    android:background="@drawable/bg_douyin_button_secondary"
                    android:padding="0dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="32dp"
                    android:layout_height="36dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:contentDescription="增大字体大小"
                    android:layout_marginStart="4dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sp"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/chatMessageTimeTextColorLayout"
                android:background="?android:attr/selectableItemBackground"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:contentDescription="选择消息时间文字颜色">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="文字颜色"
                    android:layout_weight="1"
                    android:importantForAccessibility="no"/>
                <View
                    android:id="@+id/chatMessageTimeTextColorPreview"
                    android:background="@drawable/bg_color_preview"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/chatTimeFormatBottomDivider"
            android:background="@color/divider_color"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/chatTimeFormatInputLayout"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="时间格式"
                android:labelFor="@+id/chatTimeFormatEditText"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="两种时间显示方式共用"/>
            <EditText
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:gravity="center_vertical"
                android:id="@+id/chatTimeFormatEditText"
                android:background="@drawable/round_edit_bg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:minHeight="48dp"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:inputType="text"
                android:imeOptions="actionDone"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/secondary_text"
        android:paddingBottom="7dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="隐私保护"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_setting_group_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToOutline="true">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/blockChatScreenshotReportLayout"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="false"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:importantForAccessibility="no"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:importantForAccessibility="noHideDescendants"
                android:layout_marginEnd="12dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="阻止聊天截屏上报"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="不提示对方，也不发送截屏系统消息"
                    android:lineSpacingExtra="1dp"/>
            </LinearLayout>
            <Switch
                android:id="@+id/blockChatScreenshotReportSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"
                android:thumb="@drawable/switch_thumb"
                android:contentDescription="阻止聊天截屏上报，不提示对方，也不发送截屏系统消息"
                android:track="@drawable/switch_track"/>
        </LinearLayout>
    </LinearLayout>
    <RelativeLayout
        android:gravity="center_vertical"
        android:id="@+id/chatBubbleBgLayout"
        android:background="@drawable/bg_setting_group_card"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="60dp"
        android:contentDescription="聊天气泡背景，设置自己和对方气泡文件"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            android:layout_marginEnd="12dp"
            android:layout_toStartOf="@+id/chatBubbleArrow"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="聊天气泡背景"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="设置自己和对方气泡文件"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/chatBubbleArrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_right"
            android:layout_centerVertical="true"
            android:importantForAccessibility="no"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</LinearLayout>
