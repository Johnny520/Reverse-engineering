<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/layout_recipient_item"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="78dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:paddingHorizontal="12dp"
    android:paddingVertical="10dp">
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:gravity="center"
            android:id="@+id/tv_recipient_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="友"/>
        <ImageView
            android:id="@+id/iv_recipient_avatar"
            android:visibility="gone"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerCrop"
            android:contentDescription="头像"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/primary_text"
                android:ellipsize="end"
                android:id="@+id/tv_recipient_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="联系人"
                android:maxLines="1"
                android:layout_weight="1"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/hint_text"
                android:id="@+id/tv_recipient_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/secondary_text"
            android:ellipsize="end"
            android:id="@+id/tv_recipient_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="抖音号"
            android:maxLines="1"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/hint_text"
            android:ellipsize="end"
            android:id="@+id/tv_recipient_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="1"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/douyin_white"
        android:gravity="center"
        android:id="@+id/tv_recipient_selection"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="10dp"/>
</LinearLayout>
