<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="15dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="1dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/textColor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="好友id"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/textColor"
            android:id="@+id/uid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-"
            android:textIsSelectable="true"/>
    </LinearLayout>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="15dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/keep_fire_layout"
        android:background="?android:attr/selectableItemBackground"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="1dp"
        android:minHeight="56dp"
        android:paddingVertical="10dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/textColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="续火花"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/keep_fire_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/kuku"
                    android:layout_marginEnd="6dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/douyin_primary"
                    android:id="@+id/keep_fire_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="添加自动续火"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="end"
                android:orientation="vertical"
                android:id="@+id/keep_fire_details"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:id="@+id/keep_fire_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="连续 0 天"/>
                <TextView
                    android:textSize="11sp"
                    android:textColor="@color/hint_text"
                    android:id="@+id/keep_fire_last_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="上次: 今天"/>
            </LinearLayout>
        </LinearLayout>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_right"
            android:tint="@color/hint_text"/>
    </LinearLayout>
</LinearLayout>
