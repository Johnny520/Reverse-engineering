<?xml version="1.0" encoding="utf-8"?>
<com.android.app.CustomCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/input_border"
    app:strokeWidth="1dp">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/emoji_card_content"
        android:background="?android:attr/selectableItemBackground"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/emoji_image"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/image"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/douyin_primary"
            android:gravity="center"
            android:id="@+id/save_icon"
            android:background="@drawable/button_bg_rounded"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="保存"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
</com.android.app.CustomCardView>
