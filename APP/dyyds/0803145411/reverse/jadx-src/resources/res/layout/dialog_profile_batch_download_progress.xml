<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/bg_download_panel"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:clipChildren="false"
        android:layout_width="328dp"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/dialog_title_color"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="批量下载"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/douyin_primary"
                android:id="@+id/tv_batch_badge"
                android:background="@drawable/bg_download_status_chip"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="准备中"
                android:includeFontPadding="false"
                android:paddingStart="9dp"
                android:paddingEnd="9dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/dialog_item_text"
                android:id="@+id/tv_batch_current"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="正在准备任务"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:id="@+id/tv_batch_result"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="成功 0 · 失败 0"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/dialog_item_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="总进度"
                android:includeFontPadding="false"
                android:layout_weight="1"/>
            <TextView
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/douyin_primary"
                android:id="@+id/tv_batch_total_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <ProgressBar
            android:id="@+id/progress_batch_total"
            android:layout_width="match_parent"
            android:layout_height="7dp"
            android:layout_marginTop="9dp"
            android:max="1000"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/download_progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/secondary_text"
            android:id="@+id/tv_batch_total_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="已处理 0 / 0 个作品"
            android:includeFontPadding="false"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_download_info_card"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="当前作品"
                android:includeFontPadding="false"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/dialog_item_text"
                android:ellipsize="middle"
                android:id="@+id/tv_batch_file_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="等待开始"
                android:maxLines="1"
                android:includeFontPadding="false"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/dialog_item_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="单个进度"
                    android:includeFontPadding="false"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:id="@+id/tv_batch_item_percent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:includeFontPadding="false"/>
            </LinearLayout>
            <FrameLayout
                android:clipChildren="false"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp">
                <ProgressBar
                    android:id="@+id/progress_batch_item"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:max="1000"
                    android:progress="0"
                    android:indeterminate="true"
                    android:progressDrawable="@drawable/download_progress_bar"
                    style="@android:style/Widget.ProgressBar.Horizontal"/>
                <com.p000ss.android.ugc.awemes.p001ui.ProgressParticleView
                    android:id="@+id/progress_batch_item_particle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </FrameLayout>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:ellipsize="end"
                android:id="@+id/tv_batch_item_size"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="正在获取文件大小"
                android:maxLines="1"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_cancel_batch_download"
            android:background="@drawable/bg_download_cancel_button"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="16dp"
            android:text="取消批量下载"
            android:includeFontPadding="false"/>
    </LinearLayout>
</FrameLayout>
