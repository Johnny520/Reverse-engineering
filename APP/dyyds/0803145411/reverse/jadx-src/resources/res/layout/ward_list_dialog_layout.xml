<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_ward_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/bg_ward_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"/>
    </LinearLayout>
    <RelativeLayout
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:paddingStart="15dp"
        android:paddingEnd="16dp">
        <ImageView
            android:id="@+id/ivStats"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/m6r"
            android:tint="@color/douyin_primary"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <ImageView
            android:id="@+id/ivClearAll"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_width="27dp"
            android:layout_height="27dp"
            android:src="@drawable/remove"
            android:tint="@color/douyin_primary"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_toEndOf="@+id/ivStats"/>
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我的插眼"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"/>
        <ImageView
            android:id="@+id/ivCloseList"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/close"
            android:tint="@color/primary_text"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/bg_ward_search"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp">
        <ImageView
            android:id="@+id/ivSearch"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/search"
            android:tint="@color/secondary_text"/>
        <EditText
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:id="@+id/etSearch"
            android:background="@android:color/transparent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="搜索分类、备注、昵称、内容"
            android:maxLines="1"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"/>
        <ImageView
            android:id="@+id/ivClearSearch"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="7dp"
            android:visibility="gone"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/close"
            android:tint="@color/secondary_text"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/card_bg"
        android:paddingTop="10dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/douyin_primary"
            android:id="@+id/tvFilterAll"
            android:background="@drawable/bg_ward_filter_chip_selected"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="全部"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/secondary_text"
            android:id="@+id/tvFilterVideo"
            android:background="@drawable/bg_ward_filter_normal"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="视频"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/secondary_text"
            android:id="@+id/tvFilterComment"
            android:background="@drawable/bg_ward_filter_normal"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="评论"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="8dp"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/secondary_text"
            android:id="@+id/tvFilterUser"
            android:background="@drawable/bg_ward_filter_normal"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="主页"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/card_bg"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <HorizontalScrollView
            android:scrollbars="none"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:layout_weight="1"
            android:overScrollMode="never">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/layoutCategoryFilters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </HorizontalScrollView>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@color/card_bg"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/secondary_text"
            android:id="@+id/tvWardCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 条插眼"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/primary_text"
            android:gravity="center"
            android:id="@+id/tvSortBy"
            android:background="@drawable/bg_ward_filter_normal"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:minWidth="92dp"
            android:text="保存时间"
            android:drawablePadding="6dp"
            android:drawableStart="@drawable/ic_sort"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
    </LinearLayout>
    <View
        android:background="@color/surface_bg"
        android:layout_width="match_parent"
        android:layout_height="4dp"/>
    <com.android.app.CustomRecyclerView
        android:id="@+id/rvWardList"
        android:background="@color/surface_bg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/layoutEmpty"
        android:background="@color/surface_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="48sp"
            android:gravity="center"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="��"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/secondary_text"
            android:id="@+id/tvEmptyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="还没有插眼哦"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/hint_text"
            android:id="@+id/tvEmptySubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="长按评论可以插眼保存"/>
    </LinearLayout>
</LinearLayout>
