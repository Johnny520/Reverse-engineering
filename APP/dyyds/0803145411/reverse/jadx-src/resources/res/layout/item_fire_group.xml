<?xml version="1.0" encoding="utf-8"?>
<com.android.app.CustomCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:id="@+id/tv_group_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="分组名称"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/iv_edit"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/edit"
                android:layout_marginEnd="8dp"
                app:tint="@color/secondary_text"/>
            <ImageView
                android:id="@+id/iv_delete"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/remove"
                app:tint="@color/warning_red"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="延迟区间："/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:id="@+id/tv_delay_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2000-4000ms"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="随机消息："/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:id="@+id/tv_message_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="4条"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/douyin_primary"
                android:id="@+id/tv_expand"
                android:background="?android:attr/selectableItemBackground"
                android:padding="4dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="展开"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/secondary_text"
            android:id="@+id/tv_messages"
            android:background="@drawable/bg_douyin_edittext"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="[续火花吧]"
            android:maxLines="5"
            android:lineSpacingExtra="4dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="续火项："/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:id="@+id/tv_item_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0个"/>
        </LinearLayout>
    </LinearLayout>
</com.android.app.CustomCardView>
