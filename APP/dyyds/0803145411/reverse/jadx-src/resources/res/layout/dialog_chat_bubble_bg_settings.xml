<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingBottom="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/chatPreviewPanel"
        android:background="@drawable/bg_setting_group_card"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/secondary_text"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/round_edit_bg"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="下午 13:14"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"/>
        <LinearLayout
            android:gravity="top"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <ImageView
                android:background="@drawable/circle_background"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/msg_left"
                android:scaleType="centerCrop"
                android:clipToOutline="true"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/primary_text"
                android:gravity="center_vertical"
                android:id="@+id/previewOtherBubble"
                android:background="@drawable/round_edit_bg"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="220dp"
                android:minHeight="40dp"
                android:text="你知道你现在跟以前最大的区别是什么吗？"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="end|top"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/primary_text"
                android:gravity="center_vertical"
                android:id="@+id/previewSelfBubble"
                android:background="@drawable/round_edit_bg"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="220dp"
                android:minHeight="40dp"
                android:text="什么？"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:layout_marginEnd="10dp"/>
            <ImageView
                android:background="@drawable/circle_background"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginTop="2dp"
                android:src="@drawable/msg_right"
                android:scaleType="centerCrop"
                android:clipToOutline="true"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_setting_group_card"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="对方气泡"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="控制收到消息时的气泡样式"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_text"
                android:id="@+id/textOtherStatus"
                android:background="@drawable/bg_chat_status_badge_neutral"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </LinearLayout>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <Button
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:id="@+id/btnClearOtherBubble"
                android:background="@drawable/bg_douyin_button_secondary"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:text="清除"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <Button
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:id="@+id/btnPickOtherBubble"
                android:background="@drawable/bg_douyin_button_primary"
                android:layout_width="96dp"
                android:layout_height="36dp"
                android:text="选择文件"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_setting_group_card"
        android:padding="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="自己气泡"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="控制发送消息时的气泡样式"/>
            </LinearLayout>
            <TextView
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_text"
                android:id="@+id/textSelfStatus"
                android:background="@drawable/bg_chat_status_badge_neutral"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="默认"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"/>
        </LinearLayout>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"/>
        <LinearLayout
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <Button
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:id="@+id/btnClearSelfBubble"
                android:background="@drawable/bg_douyin_button_secondary"
                android:layout_width="88dp"
                android:layout_height="36dp"
                android:text="清除"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
            <Button
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:id="@+id/btnPickSelfBubble"
                android:background="@drawable/bg_douyin_button_primary"
                android:layout_width="96dp"
                android:layout_height="36dp"
                android:text="选择文件"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
