<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_douyin_dialog"
    android:padding="20dp"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/dialog_title_color"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="轩心云API设置"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/secondary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="接口选择"/>
    <RadioGroup
        android:orientation="vertical"
        android:id="@+id/rg_api_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">
        <RadioButton
            android:textSize="13sp"
            android:textColor="@color/primary_text"
            android:id="@+id/rb_api_normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="文字转语音"/>
        <RadioButton
            android:textSize="13sp"
            android:textColor="@color/primary_text"
            android:id="@+id/rb_api_pro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="新文字转语音（计费调用）"/>
    </RadioGroup>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/primary_text"
        android:textColorHint="@color/hint_text"
        android:gravity="start|top"
        android:id="@+id/et_api_key"
        android:background="@drawable/bg_douyin_edittext"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="12dp"
        android:hint="请输入API密钥"
        android:maxLines="5"
        android:inputType="textMultiLine"/>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/douyin_primary"
        android:gravity="center"
        android:id="@+id/btn_get_key"
        android:background="@drawable/bg_douyin_button_secondary"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="12dp"
        android:text="�� 获取密钥"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dialog_button_secondary_text"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/bg_douyin_button_secondary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="取消"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_save"
            android:background="@drawable/bg_douyin_button_primary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="保存"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
