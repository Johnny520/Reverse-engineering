<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/surface_bg"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/secondary_text"
            android:paddingBottom="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="非全屏画面背景"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@+id/videoBackgroundModeLayout"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="12dp"
                    android:layout_toStartOf="@+id/videoBackgroundModeText">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="背景模式"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="控制横屏视频及画面未铺满时的留白区域"
                        android:lineSpacingExtra="1dp"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/secondary_text"
                    android:gravity="center_vertical"
                    android:id="@+id/videoBackgroundModeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="跟随抖音"
                    android:drawablePadding="5dp"
                    android:layout_centerVertical="true"
                    android:drawableEnd="@drawable/ic_arrow_right"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/videoBackgroundColorPanel"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="10dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="背景颜色"
                    android:labelFor="@+id/videoBackgroundColorEditText"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="支持 #RRGGBB 或 #AARRGGBB，点击右侧色块选择"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center_vertical"
                        android:id="@+id/videoBackgroundColorEditText"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:minHeight="0dp"
                        android:hint="#FF000000"
                        android:maxLines="1"
                        android:selectAllOnFocus="true"
                        android:layout_weight="1"
                        android:inputType="textCapCharacters"
                        android:imeOptions="actionDone"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>
                    <View
                        android:id="@+id/videoBackgroundColorPreview"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="选择非全屏画面背景颜色"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/videoBackgroundImagePanel"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="10dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/videoBackgroundImagePreview"
                        android:background="@drawable/round_edit_bg"
                        android:layout_width="52dp"
                        android:layout_height="74dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="自定义视频背景预览"
                        android:clipToOutline="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="自定义背景图"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/secondary_text"
                            android:id="@+id/videoBackgroundImageStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="尚未选择图片"/>
                    </LinearLayout>
                </LinearLayout>
                <RelativeLayout
                    android:gravity="center_vertical"
                    android:id="@+id/videoBackgroundImageScaleModeLayout"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:minHeight="54dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="12dp"
                        android:layout_toStartOf="@+id/videoBackgroundImageScaleModeText">
                        <TextView
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/primary_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="显示方式"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/secondary_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="控制图片在留白背景中的缩放和裁剪位置"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:gravity="center_vertical"
                        android:id="@+id/videoBackgroundImageScaleModeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="裁剪铺满"
                        android:drawablePadding="5dp"
                        android:layout_centerVertical="true"
                        android:drawableEnd="@drawable/ic_arrow_right"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <LinearLayout
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <Button
                        android:textSize="13sp"
                        android:textColor="@color/primary_text"
                        android:id="@+id/clearVideoBackgroundImageButton"
                        android:background="@drawable/bg_douyin_button_secondary"
                        android:layout_width="80dp"
                        android:layout_height="36dp"
                        android:text="清除"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"/>
                    <Button
                        android:textSize="13sp"
                        android:textColor="@android:color/white"
                        android:id="@+id/pickVideoBackgroundImageButton"
                        android:background="@drawable/bg_douyin_button_primary"
                        android:layout_width="96dp"
                        android:layout_height="36dp"
                        android:text="选择图片"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/secondary_text"
            android:paddingBottom="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="发布时间"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">
            <RelativeLayout
                android:gravity="center_vertical"
                android:id="@+id/showPublishTimeLayout"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:importantForAccessibility="no"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:importantForAccessibility="noHideDescendants"
                    android:layout_marginEnd="12dp"
                    android:layout_toStartOf="@+id/showPublishTimeSwitch"
                    android:layout_alignParentStart="true">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="显示发布时间"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="在视频信息区域显示发布时间和发布地"
                        android:lineSpacingExtra="1dp"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/showPublishTimeSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:thumb="@drawable/switch_thumb"
                    android:layout_centerVertical="true"
                    android:contentDescription="显示发布时间，在视频信息区域显示发布时间和发布地"
                    android:track="@drawable/switch_track"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/timeFormatInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="10dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="时间格式"
                    android:labelFor="@+id/timeFormatEditText"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="使用 SimpleDateFormat 格式规则"/>
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center_vertical"
                    android:id="@+id/timeFormatEditText"
                    android:background="@drawable/round_edit_bg"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:minHeight="0dp"
                    android:hint="例如：yyyy-MM-dd HH:mm"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:inputType="text"
                    android:imeOptions="actionNext"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/displayTemplateInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp">
                <View
                    android:background="@color/divider_color"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"/>
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="显示模板"
                    android:labelFor="@+id/displayTemplateEditText"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="组合发布时间和发布地，可使用下方占位符"/>
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center_vertical"
                    android:id="@+id/displayTemplateEditText"
                    android:background="@drawable/round_edit_bg"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:minHeight="0dp"
                    android:hint="{time} 发布地：{location}"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="插入"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/insertTimePlaceholderText"
                        android:background="@drawable/bg_douyin_button_secondary_compact"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="{time}"
                        android:contentDescription="插入时间占位符"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/insertLocationPlaceholderText"
                        android:background="@drawable/bg_douyin_button_secondary_compact"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="{location}"
                        android:contentDescription="插入发布地占位符"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/secondary_text"
            android:paddingBottom="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="显示样式"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/colorfulDisplayLayout"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:importantForAccessibility="no"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="noHideDescendants"
                    android:layout_marginEnd="12dp">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="多彩显示"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="文字颜色留空时，为发布时间文字应用多彩效果"
                        android:lineSpacingExtra="1dp"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/colorfulDisplaySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:thumb="@drawable/switch_thumb"
                    android:contentDescription="多彩显示，文字颜色留空时为发布时间文字应用多彩效果"
                    android:track="@drawable/switch_track"/>
            </LinearLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/textSizeInputLayout"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="字体大小"
                        android:labelFor="@+id/textSizeEditText"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="设置发布时间文字大小，范围 1–100sp"/>
                </LinearLayout>
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center"
                    android:id="@+id/textSizeEditText"
                    android:background="@drawable/round_edit_bg"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:minHeight="0dp"
                    android:hint="14"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:maxLength="3"
                    android:inputType="number"
                    android:imeOptions="actionDone"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="sp"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="5dp"/>
            </LinearLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/textColorInputLayout"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <TextView
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="文字颜色"
                    android:labelFor="@+id/textColorEditText"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="输入十六进制颜色，留空使用默认值"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center_vertical"
                        android:id="@+id/textColorEditText"
                        android:background="@drawable/round_edit_bg"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:minHeight="0dp"
                        android:hint="例如：#FFFFFF"
                        android:maxLines="1"
                        android:selectAllOnFocus="true"
                        android:layout_weight="1"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>
                    <View
                        android:id="@+id/colorPreview"
                        android:background="@drawable/bg_color_preview"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="选择发布时间文字颜色"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/secondary_text"
            android:paddingBottom="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="插眼标签"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:importantForAccessibility="no"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:importantForAccessibility="noHideDescendants"
                    android:layout_marginEnd="12dp">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="显示插眼标签"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="仅在当前视频已插眼时显示在昵称旁"
                        android:lineSpacingExtra="1dp"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/wardLabelEnabledSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:thumb="@drawable/switch_thumb"
                    android:contentDescription="显示插眼标签，仅在当前视频已插眼时显示在昵称旁"
                    android:track="@drawable/switch_track"/>
            </LinearLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="显示模板"
                    android:labelFor="@+id/wardLabelTemplateEditText"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="设置昵称旁标签内容，可插入分类占位符"/>
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:textColorHint="@color/hint_text"
                    android:gravity="center_vertical"
                    android:id="@+id/wardLabelTemplateEditText"
                    android:background="@drawable/round_edit_bg"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:minHeight="0dp"
                    android:hint="${category}"
                    android:maxLines="1"
                    android:selectAllOnFocus="true"
                    android:inputType="text"
                    android:imeOptions="actionDone"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="插入"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/insertWardCategoryPlaceholderText"
                        android:background="@drawable/bg_douyin_button_secondary_compact"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="112dp"
                        android:minHeight="36dp"
                        android:text="视频插眼分类"
                        android:maxLines="2"
                        android:contentDescription="插入视频插眼分类占位符"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:layout_marginStart="8dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/primary_text"
                        android:gravity="center"
                        android:id="@+id/insertWardUserCategoryPlaceholderText"
                        android:background="@drawable/bg_douyin_button_secondary_compact"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxWidth="112dp"
                        android:minHeight="36dp"
                        android:text="主页插眼分类"
                        android:maxLines="2"
                        android:contentDescription="插入主页插眼分类占位符"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp"
                        android:layout_marginStart="6dp"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="文字颜色"
                    android:labelFor="@+id/wardLabelTextColorEditText"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="设置插眼标签文字颜色，支持透明度"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center_vertical"
                        android:id="@+id/wardLabelTextColorEditText"
                        android:background="@drawable/round_edit_bg"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:minHeight="0dp"
                        android:hint="例如：#FFFFFFFF"
                        android:maxLines="1"
                        android:selectAllOnFocus="true"
                        android:layout_weight="1"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>
                    <View
                        android:id="@+id/wardLabelTextColorPreview"
                        android:background="@drawable/bg_color_preview"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="选择插眼标签文字颜色"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </LinearLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="背景颜色"
                    android:labelFor="@+id/wardLabelBackgroundColorEditText"/>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="设置插眼标签背景颜色，支持透明度"/>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="center_vertical"
                        android:id="@+id/wardLabelBackgroundColorEditText"
                        android:background="@drawable/round_edit_bg"
                        android:paddingTop="0dp"
                        android:paddingBottom="0dp"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:minHeight="0dp"
                        android:hint="例如：#33FFFFFF"
                        android:maxLines="1"
                        android:selectAllOnFocus="true"
                        android:layout_weight="1"
                        android:inputType="text"
                        android:imeOptions="actionDone"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>
                    <View
                        android:id="@+id/wardLabelBackgroundColorPreview"
                        android:background="@drawable/bg_color_preview"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="选择插眼标签背景颜色"
                        android:layout_marginStart="10dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
