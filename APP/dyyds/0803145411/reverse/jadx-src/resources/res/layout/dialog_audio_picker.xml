<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_douyin_dialog"
    android:paddingTop="20dp"
    android:paddingBottom="16dp"
    android:layout_width="340dp"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_title_color"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择音频"
            android:layout_centerHorizontal="true"/>
        <ImageView
            android:id="@+id/iv_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/close"
            android:tint="@color/secondary_text"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/tv_mode_local"
            android:background="@drawable/bg_douyin_button_primary"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="本地文件"
            android:layout_weight="1"/>
        <View
            android:layout_width="8dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/dialog_button_secondary_text"
            android:gravity="center"
            android:id="@+id/tv_mode_tts"
            android:background="@drawable/bg_douyin_button_secondary"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:text="文本转语音"
            android:layout_weight="1"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_local_mode"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/folder"
                android:tint="@color/secondary_text"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:ellipsize="start"
                android:id="@+id/tv_directory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="6dp"/>
            <ImageView
                android:id="@+id/iv_sort"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_sort_descending"
                android:layout_marginEnd="8dp"/>
            <ImageView
                android:id="@+id/iv_refresh"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/refresh"
                android:tint="@color/secondary_text"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/douyin_primary"
                android:id="@+id/tv_file_count"
                android:background="@drawable/bg_opacity_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:background="@drawable/bg_douyin_edittext"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:paddingHorizontal="12dp">
            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_search"
                android:tint="@color/hint_text"/>
            <EditText
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:id="@+id/et_search"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:hint="搜索文件名..."
                android:maxLines="1"
                android:layout_weight="1"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:layout_marginStart="8dp"/>
            <ImageView
                android:id="@+id/iv_clear_search"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:visibility="gone"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/close"
                android:tint="@color/hint_text"/>
        </LinearLayout>
        <View
            android:background="@color/divider_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <com.android.app.CustomRecyclerView
            android:id="@+id/rv_audio_list"
            android:visibility="gone"
            android:scrollbars="vertical"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:maxHeight="400dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_loading"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ProgressBar
                android:id="@+id/progress_loading"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:indeterminate="true"
                android:indeterminateTint="@color/douyin_primary"
                style="?android:attr/progressBarStyle"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="正在加载..."/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_empty"
            android:padding="40dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/audio"
                android:tint="@color/hint_text"
                android:alpha="0.5"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/hint_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="暂无音频文件"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_tts_mode"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_tts_form"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="音色"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <Spinner
                            android:id="@+id/spinner_tts_voice"
                            android:background="@drawable/bg_douyin_edittext"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:paddingHorizontal="12dp"/>
                        <ImageView
                            android:id="@+id/iv_api_key_setting"
                            android:background="@drawable/bg_douyin_button_secondary"
                            android:padding="10dp"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_settings"
                            android:tint="@color/dialog_button_secondary_text"
                            android:layout_marginStart="8dp"/>
                        <ImageView
                            android:id="@+id/iv_tts_history"
                            android:background="@drawable/bg_douyin_button_secondary"
                            android:padding="10dp"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_history"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:id="@+id/tv_voice_loading"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="正在加载音色列表..."/>
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="文本内容"/>
                    <EditText
                        android:textSize="14sp"
                        android:textColor="@color/primary_text"
                        android:textColorHint="@color/hint_text"
                        android:gravity="start|top"
                        android:id="@+id/et_tts_text"
                        android:background="@drawable/bg_douyin_edittext"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="8dp"
                        android:hint="请输入要转换的文本内容"
                        android:maxLength="500"
                        android:inputType="textMultiLine"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:layout_gravity="end"
                        android:id="@+id/tv_text_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0/500"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/btn_generate_audio"
                        android:background="@drawable/bg_douyin_button_primary"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="16dp"
                        android:text="生成语音"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/layout_generating"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="60dp">
                    <ProgressBar
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/douyin_primary"
                        style="?android:attr/progressBarStyle"/>
                    <TextView
                        android:textSize="15sp"
                        android:textColor="@color/primary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="正在生成语音..."/>
                    <TextView
                        android:textSize="13sp"
                        android:textColor="@color/secondary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="请稍候片刻"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layout_audio_preview"
                    android:background="@drawable/bg_douyin_edittext"
                    android:padding="16dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="语音预览"/>
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">
                        <ImageView
                            android:id="@+id/iv_play_pause"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:padding="8dp"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/play"
                            android:tint="@color/douyin_primary"/>
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp">
                            <LinearLayout
                                android:orientation="horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">
                                <TextView
                                    android:textSize="12sp"
                                    android:textColor="@color/primary_text"
                                    android:id="@+id/tv_current_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="00:00"/>
                                <View
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1"/>
                                <TextView
                                    android:textSize="12sp"
                                    android:textColor="@color/secondary_text"
                                    android:id="@+id/tv_total_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="00:00"/>
                            </LinearLayout>
                            <SeekBar
                                android:id="@+id/seek_bar_audio"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:max="100"
                                android:progressTint="@color/douyin_primary"
                                android:thumbTint="@color/douyin_primary"/>
                        </LinearLayout>
                    </LinearLayout>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/dialog_button_secondary_text"
                        android:gravity="center"
                        android:id="@+id/btn_regenerate"
                        android:background="@drawable/bg_douyin_button_secondary"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="16dp"
                        android:text="重新生成"/>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/dialog_button_secondary_text"
            android:gravity="center"
            android:id="@+id/btn_cancel"
            android:background="@drawable/bg_douyin_button_secondary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="关闭"
            android:layout_weight="1"/>
        <View
            android:layout_width="12dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="15sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btn_confirm"
            android:background="@drawable/bg_douyin_button_primary"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="确定"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
