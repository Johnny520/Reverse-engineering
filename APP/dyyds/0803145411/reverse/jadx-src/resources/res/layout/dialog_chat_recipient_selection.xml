<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_ward_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/bg_ward_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:id="@+id/tv_recipient_dialog_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择接收对象"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_recipient_dialog_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/close"
            android:tint="@color/primary_text"
            android:layout_centerVertical="true"
            android:contentDescription="关闭"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:background="@drawable/bg_douyin_edittext"
        android:padding="4dp"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="7dp"
        android:layout_marginHorizontal="16dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/douyin_white"
            android:gravity="center"
            android:id="@+id/tab_recipient_recent"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="最近 0"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/douyin_white"
            android:gravity="center"
            android:id="@+id/tab_recipient_friend"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="好友 0"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:id="@+id/tab_recipient_group"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="群聊 0"
            android:layout_weight="1"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="16dp">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:id="@+id/et_recipient_search"
            android:background="@drawable/bg_douyin_edittext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:hint="搜索昵称、抖音号或会话"
            android:singleLine="true"
            android:layout_weight="1"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:paddingHorizontal="12dp"/>
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/douyin_primary"
            android:gravity="center"
            android:id="@+id/tv_recipient_refresh"
            android:background="@drawable/bg_douyin_edittext"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:text="刷新"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/secondary_text"
        android:id="@+id/tv_recipient_state"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginBottom="3dp"
        android:text="正在读取接收对象…"
        android:layout_marginHorizontal="18dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.android.app.CustomRecyclerView
            android:id="@+id/rv_recipient_list"
            android:paddingTop="3dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layout_recipient_empty"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_text"
                android:gravity="center"
                android:background="@drawable/bg_douyin_edittext"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:text="聊"
                android:alpha="0.55"/>
            <TextView
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:id="@+id/tv_recipient_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="暂无最近会话"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/hint_text"
                android:id="@+id/tv_recipient_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="打开一次消息页后再点刷新"/>
        </LinearLayout>
    </FrameLayout>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/secondary_text"
            android:id="@+id/tv_recipient_selected_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="已选择 0 个"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:gravity="center"
                android:id="@+id/btn_recipient_cancel"
                android:background="@drawable/douyin_button_secondary2"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="取消"
                android:layout_weight="1"/>
            <Space
                android:layout_width="10dp"
                android:layout_height="match_parent"/>
            <TextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/douyin_white"
                android:gravity="center"
                android:id="@+id/btn_recipient_confirm"
                android:background="@drawable/douyin_button_primary2"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="确定"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
