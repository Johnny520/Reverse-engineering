<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/download_dialog_root"
    android:background="@drawable/bg_download_panel"
    android:paddingTop="18dp"
    android:paddingBottom="18dp"
    android:clipChildren="false"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_title_color"
            android:id="@+id/tv_download_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="文件下载"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/douyin_primary"
            android:id="@+id/tv_download_badge"
            android:background="@drawable/bg_download_status_chip"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="准备中"
            android:includeFontPadding="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:id="@+id/btn_minimize_download"
            android:background="@drawable/bg_download_close_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_minimize"
            android:scaleType="center"
            android:contentDescription="最小化"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="22sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:id="@+id/btn_close_download"
            android:background="@drawable/bg_download_close_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="×"
            android:includeFontPadding="false"
            android:contentDescription="取消下载"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_download_file_card"
        android:background="@drawable/bg_download_info_card"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="12sp"
            android:textColor="@color/secondary_text"
            android:id="@+id/tv_download_file_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="保存文件"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_item_text"
            android:ellipsize="middle"
            android:id="@+id/tv_download_file_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/dialog_message_color"
            android:ellipsize="middle"
            android:id="@+id/tv_download_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_item_text"
            android:id="@+id/tv_download_progress_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="下载进度"
            android:includeFontPadding="false"
            android:layout_weight="1"/>
        <TextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/douyin_primary"
            android:id="@+id/tv_download_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <FrameLayout
        android:clipChildren="false"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:layout_marginTop="10dp">
        <ProgressBar
            android:id="@+id/progress_download"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="1000"
            android:progress="0"
            android:indeterminate="false"
            android:progressDrawable="@drawable/download_progress_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"/>
        <com.p000ss.android.ugc.awemes.p001ui.ProgressParticleView
            android:id="@+id/progress_particle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/bg_download_info_card"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/dialog_item_text"
            android:ellipsize="end"
            android:id="@+id/tv_download_size_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="已下载 0 B / 未知"
            android:maxLines="1"
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/secondary_text"
            android:ellipsize="end"
            android:id="@+id/tv_download_meta_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="速度 -- /s · 剩余 --"
            android:maxLines="1"
            android:includeFontPadding="false"/>
    </LinearLayout>
    <TextView
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/btn_cancel_download"
        android:background="@drawable/bg_download_cancel_button"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:text="取消下载"
        android:includeFontPadding="false"/>
</LinearLayout>
