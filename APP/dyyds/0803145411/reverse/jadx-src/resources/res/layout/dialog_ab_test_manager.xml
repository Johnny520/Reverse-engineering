<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_setting_group_card"
    android:paddingTop="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="10dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <TextView
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/primary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A/B 实验管理器"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/secondary_text"
                android:id="@+id/abStatsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"/>
        </LinearLayout>
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/douyin_primary"
            android:gravity="center"
            android:id="@+id/abAddButton"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:text="添加"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:id="@+id/abRefreshButton"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="48dp"
            android:layout_height="42dp"
            android:text="刷新"/>
        <TextView
            android:textSize="24sp"
            android:textColor="@color/secondary_text"
            android:gravity="center"
            android:id="@+id/abCloseButton"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="×"
            android:contentDescription="关闭"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/status_warning"
        android:background="@color/status_warning_bg"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="覆盖发生在 ABManager 返回之后。大多数实验会被 Lazy 或静态字段缓存，保存后建议强制停止并重新打开抖音。JSON 类型修改错误可能导致对应功能异常。"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="12dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:id="@+id/abSearchInput"
            android:background="@drawable/bg_setting_search"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="搜索 Key、类型或当前值"
            android:maxLines="1"
            android:drawablePadding="8dp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:drawableStart="@drawable/ic_search_input"
            android:paddingStart="14dp"
            android:paddingEnd="42dp"
            android:importantForAutofill="no"/>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/hint_text"
            android:gravity="center"
            android:layout_gravity="end"
            android:id="@+id/abSearchClear"
            android:visibility="gone"
            android:layout_width="42dp"
            android:layout_height="match_parent"
            android:text="×"/>
    </FrameLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/secondary_text"
        android:gravity="center"
        android:id="@+id/abEmptyText"
        android:padding="24dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="还没有捕获到实验\10浏览抖音后点“刷新”，或手动添加 Key"
        android:layout_weight="1"/>
    <com.android.app.CustomRecyclerView
        android:id="@+id/abEntryList"
        android:paddingBottom="14dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"/>
</LinearLayout>
