<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_setting_group_card"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:paddingStart="14dp"
    android:paddingEnd="10dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:ellipsize="middle"
            android:id="@+id/abEntryKey"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:layout_weight="1"
            android:textIsSelectable="true"/>
        <TextView
            android:textSize="11sp"
            android:textColor="@color/secondary_text"
            android:id="@+id/abEntryType"
            android:background="@color/status_neutral_bg"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="8dp"/>
        <Switch
            android:id="@+id/abEntryEnabled"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            android:minWidth="0dp"
            android:thumb="@drawable/switch_thumb"
            android:track="@drawable/switch_track"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/secondary_text"
        android:ellipsize="end"
        android:id="@+id/abEntryOriginal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:maxLines="2"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/douyin_primary"
        android:ellipsize="end"
        android:id="@+id/abEntryOverride"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="3"/>
    <TextView
        android:textSize="10sp"
        android:textColor="@color/hint_text"
        android:ellipsize="middle"
        android:id="@+id/abEntryMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"/>
    <TextView
        android:textSize="11sp"
        android:textColor="@color/warning_red"
        android:id="@+id/abEntryError"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"/>
</LinearLayout>
