<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/round_edit_bg"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <TextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="备份状态"
                    android:layout_weight="1"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/selectable_item_background_rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="模块配置"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/secondary_text"
                    android:id="@+id/backupInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:text="正在加载..."
                    android:lineSpacingMultiplier="1.4"
                    android:paddingEnd="0dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/selectable_item_background_rounded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="插眼数据"/>
                </LinearLayout>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/secondary_text"
                    android:id="@+id/wardBackupInfoText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="50dp"
                    android:text="正在加载..."
                    android:lineSpacingMultiplier="1.4"
                    android:paddingEnd="0dp"/>
            </LinearLayout>
        </LinearLayout>
        <RelativeLayout
            android:background="@drawable/round_edit_bg"
            android:padding="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp">
                    <TextView
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="自动备份"/>
                </LinearLayout>
                <TextView
                    android:textSize="12sp"
                    android:textColor="@color/secondary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="修改配置或添加插眼后自动备份"/>
            </LinearLayout>
            <Switch
                android:id="@+id/autoBackupSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/switch_thumb"
                android:layout_centerVertical="true"
                android:track="@drawable/switch_track"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="模块配置"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <Button
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_white"
                    android:id="@+id/restoreBtn"
                    android:background="@drawable/douyin_button_secondary"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:text="恢复配置"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"/>
                <Button
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_white"
                    android:id="@+id/backupBtn"
                    android:background="@drawable/douyin_button_primary"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:text="备份配置"
                    android:layout_weight="1"/>
            </LinearLayout>
            <TextView
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/secondary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="插眼数据"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp">
                <Button
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_white"
                    android:id="@+id/restoreWardBtn"
                    android:background="@drawable/douyin_button_secondary"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:text="恢复插眼数据"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"/>
                <Button
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_white"
                    android:id="@+id/backupWardBtn"
                    android:background="@drawable/douyin_button_primary"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:text="备份插眼数据"
                    android:layout_weight="1"/>
            </LinearLayout>
            <Button
                android:textSize="16sp"
                android:textColor="@color/douyin_primary"
                android:id="@+id/configWebDavBtn"
                android:background="@drawable/selectable_item_background_rounded"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="配置WebDav"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
