<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_douyin_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <View
            android:background="@drawable/bg_douyin_dialog_indicator"
            android:layout_width="3dp"
            android:layout_height="20dp"/>
        <TextView
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:id="@+id/tvCategoryActionTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="编辑分类"
            android:includeFontPadding="false"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textColor="@color/secondary_text"
        android:id="@+id/tvCategoryActionMessage"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:includeFontPadding="false"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <EditText
        android:textSize="15sp"
        android:textColor="@color/primary_text"
        android:id="@+id/etCategoryActionName"
        android:background="@drawable/bg_category_input"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="20dp"
        android:maxLines="1"
        android:maxLength="20"
        android:inputType="textCapSentences"
        android:imeOptions="actionDone"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"/>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/primary_text"
            android:gravity="center"
            android:id="@+id/btnCategoryActionCancel"
            android:background="@drawable/bg_douyin_choice_button_secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="取消"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btnCategoryActionConfirm"
            android:background="@drawable/douyin_button_primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="保存"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
