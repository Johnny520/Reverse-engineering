<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginLeft="15dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="15dp">
    <LinearLayout
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <EditText
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/hint_text"
            android:id="@+id/et_search"
            android:background="@drawable/bg_douyin_edittext"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:hint="搜索昵称或UID"
            android:inputType="text"
            android:paddingHorizontal="12dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">
            <TextView
                android:textSize="13sp"
                android:textColor="@color/primary_text"
                android:gravity="center"
                android:id="@+id/btn_filter_type"
                android:background="@drawable/bg_douyin_edittext"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:text="全部类型"
                android:drawablePadding="4dp"
                android:layout_weight="1"
                android:drawableEnd="@drawable/ic_arrow_right"
                android:layout_marginEnd="8dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/primary_text"
                android:gravity="center"
                android:id="@+id/btn_filter_group"
                android:background="@drawable/bg_douyin_edittext"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:text="全部分组"
                android:drawablePadding="4dp"
                android:layout_weight="1"
                android:drawableEnd="@drawable/ic_arrow_right"/>
        </LinearLayout>
    </LinearLayout>
    <com.android.app.CustomRecyclerView
        android:id="@+id/recycler_fire_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="8dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/empty_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂无续火项"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/hint_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="点击下方添加好友或群聊"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:textSize="14sp"
            android:textColor="@color/douyin_white"
            android:id="@+id/btn_add_recipient"
            android:background="@drawable/douyin_button_primary2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="添加"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:id="@+id/btn_group_settings"
            android:background="@drawable/douyin_button_secondary2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="分组设置"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/douyin_white"
            android:id="@+id/btn_close"
            android:background="@drawable/douyin_button_primary2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="关闭"
            android:layout_weight="1"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
