<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_toast_bg"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:minWidth="120dp"
    android:minHeight="120dp">
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/header_drag_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#f4f6f8"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:text="首页控件透明度"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/iv_window_list_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_close"/>
    </FrameLayout>
    <View
        android:background="#20ffffff"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="430dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:orientation="vertical"
            android:padding="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/bg_video_preview_panel"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="播放时透明度"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#f4f6f8"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="顶部菜单"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/douyin_primary"
                            android:id="@+id/top_text"
                            android:background="@drawable/bg_video_preview_button"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"/>
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekbar_top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/douyin_primary"
                        android:progressBackgroundTint="#24ffffff"
                        android:thumbTint="@color/douyin_primary"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#f4f6f8"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="左侧文案区域"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/douyin_primary"
                            android:id="@+id/video_text"
                            android:background="@drawable/bg_video_preview_button"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"/>
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/video_seek_bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/douyin_primary"
                        android:progressBackgroundTint="#24ffffff"
                        android:thumbTint="@color/douyin_primary"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#f4f6f8"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="视频右侧"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/douyin_primary"
                            android:id="@+id/video_right_text"
                            android:background="@drawable/bg_video_preview_button"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"/>
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekbar_video_right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/douyin_primary"
                        android:progressBackgroundTint="#24ffffff"
                        android:thumbTint="@color/douyin_primary"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#f4f6f8"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="底部菜单"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/douyin_primary"
                            android:id="@+id/bottom_text"
                            android:background="@drawable/bg_video_preview_button"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"/>
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekbar_bottom_navigation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/douyin_primary"
                        android:progressBackgroundTint="#24ffffff"
                        android:thumbTint="@color/douyin_primary"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/layout_pause_opacity_controls"
                android:background="@drawable/bg_video_preview_panel"
                android:padding="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <TextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="暂停时透明度"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#f4f6f8"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="顶部菜单"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/douyin_primary"
                            android:id="@+id/pause_top_text"
                            android:background="@drawable/bg_video_preview_button"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"/>
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekbar_pause_top"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/douyin_primary"
                        android:progressBackgroundTint="#24ffffff"
                        android:thumbTint="@color/douyin_primary"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#f4f6f8"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="左侧文案区域"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/douyin_primary"
                            android:id="@+id/pause_video_text"
                            android:background="@drawable/bg_video_preview_button"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"/>
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekbar_pause_video"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/douyin_primary"
                        android:progressBackgroundTint="#24ffffff"
                        android:thumbTint="@color/douyin_primary"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#f4f6f8"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="视频右侧"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/douyin_primary"
                            android:id="@+id/pause_video_right_text"
                            android:background="@drawable/bg_video_preview_button"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"/>
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekbar_pause_video_right"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/douyin_primary"
                        android:progressBackgroundTint="#24ffffff"
                        android:thumbTint="@color/douyin_primary"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:textSize="13sp"
                            android:textColor="#f4f6f8"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="底部菜单"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/douyin_primary"
                            android:id="@+id/pause_bottom_text"
                            android:background="@drawable/bg_video_preview_button"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100%"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"/>
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekbar_pause_bottom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="100"
                        android:progressTint="@color/douyin_primary"
                        android:progressBackgroundTint="#24ffffff"
                        android:thumbTint="@color/douyin_primary"/>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:id="@+id/switch_transparent_clickable_layout"
                android:background="@drawable/bg_video_preview_panel"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="4dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/switch_transparent_clickable"
                    android:layout_alignParentStart="true">
                    <TextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#f4f6f8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="完全透明时不可点击"/>
                    <TextView
                        android:textSize="11sp"
                        android:textColor="#a6d7dce3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="透明度为 0 时，控件将不响应点击事件"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_transparent_clickable"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:thumb="@drawable/switch_thumb"
                    android:layout_centerVertical="true"
                    android:track="@drawable/switch_track"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
