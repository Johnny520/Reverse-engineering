<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_ward_dialog_modern"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:paddingStart="20dp"
        android:paddingEnd="12dp">
        <View
            android:id="@+id/wardTitleIndicator"
            android:background="@drawable/bg_ward_title_indicator"
            android:layout_width="3dp"
            android:layout_height="20dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"/>
        <TextView
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:id="@+id/tvWardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="插眼"
            android:includeFontPadding="false"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/wardTitleIndicator"/>
        <ImageView
            android:id="@+id/ivClose"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/close"
            android:tint="@color/secondary_text"
            android:layout_centerVertical="true"
            android:contentDescription="关闭"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="480dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">
        <LinearLayout
            android:orientation="vertical"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/userHistoryCard"
                android:background="@drawable/bg_ward_history_card"
                android:padding="14dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/ivUserAvatar"
                        android:background="@drawable/bg_ward_avatar"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:src="@drawable/dihua"
                        android:scaleType="centerCrop"
                        android:contentDescription="用户头像"
                        android:clipToOutline="true"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp">
                        <TextView
                            android:textSize="15sp"
                            android:textColor="@color/primary_text"
                            android:ellipsize="end"
                            android:id="@+id/tvUserName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="用户昵称"
                            android:maxLines="1"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium"/>
                        <TextView
                            android:textSize="12sp"
                            android:textColor="@color/secondary_text"
                            android:id="@+id/tvUserStats"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="首次插眼此用户"
                            android:includeFontPadding="false"
                            android:lineSpacingExtra="2dp"/>
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/layoutHistoryCategories"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp">
                    <View
                        android:background="@color/divider_color"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="10dp"/>
                    <HorizontalScrollView
                        android:scrollbars="none"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:overScrollMode="never">
                        <LinearLayout
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:id="@+id/layoutHistoryCategoryTags"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </HorizontalScrollView>
                </LinearLayout>
            </LinearLayout>
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="8dp">
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/primary_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="分类"
                    android:includeFontPadding="false"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:layout_alignParentStart="true"/>
                <TextView
                    android:textSize="13sp"
                    android:textColor="@color/douyin_primary"
                    android:gravity="center"
                    android:id="@+id/btnManageCategory"
                    android:background="@drawable/bg_ward_manage_action"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="56dp"
                    android:text="管理"
                    android:layout_centerVertical="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/spinnerCategory"
                android:background="@drawable/bg_ward_field"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="20dp"
                android:hint="请选择分类"
                android:maxLines="1"
                android:drawablePadding="12dp"
                android:drawableEnd="@drawable/ic_ward_chevron_down"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="备注"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"/>
            <EditText
                android:textSize="15sp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/hint_text"
                android:gravity="start|top"
                android:id="@+id/etRemark"
                android:background="@drawable/bg_ward_field"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:scrollbars="vertical"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:hint="写下备注"
                android:maxLength="100"
                android:lineSpacingExtra="3dp"
                android:inputType="textMultiLine"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"/>
        </LinearLayout>
    </ScrollView>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/primary_text"
            android:gravity="center"
            android:id="@+id/btnWardCancel"
            android:background="@drawable/bg_ward_button_secondary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="取消"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/btnWardSave"
            android:background="@drawable/douyin_button_primary"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="保存"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
