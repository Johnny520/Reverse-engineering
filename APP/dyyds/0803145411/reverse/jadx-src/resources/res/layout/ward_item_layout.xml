<?xml version="1.0" encoding="utf-8"?>
<com.android.app.CustomCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutAuthorInfo"
            android:paddingBottom="10dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp">
                <ImageView
                    android:id="@+id/ivAuthorAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="作者头像"/>
            </FrameLayout>
            <TextView
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:ellipsize="end"
                android:id="@+id/tvAuthorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="200dp"
                android:text="作者昵称"
                android:maxLines="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:id="@+id/tvType"
                    android:background="@drawable/bg_ward_type_video"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="视频"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"/>
                <TextView
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/douyin_primary"
                    android:ellipsize="end"
                    android:id="@+id/tvCategory"
                    android:background="@drawable/bg_ward_category"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxWidth="140dp"
                    android:text="�� 重要内容"
                    android:singleLine="true"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/hint_text"
                android:id="@+id/tvSaveTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2025-11-24 12:48:42"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="15sp"
            android:textColor="@color/primary_text"
            android:ellipsize="end"
            android:id="@+id/tvCommentText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="这是评论的内容文字..."
            android:maxLines="4"
            android:lineSpacingExtra="4dp"
            android:textIsSelectable="true"
            android:letterSpacing="0.01"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/layoutRemark"
            android:background="@drawable/bg_ward_remark_modern"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">
            <TextView
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="��"
                android:layout_marginEnd="6dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/secondary_text"
                android:ellipsize="end"
                android:id="@+id/tvRemark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="这是我的备注内容"
                android:maxLines="2"
                android:layout_weight="1"
                android:lineSpacingExtra="2dp"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp">
            <TextView
                android:textSize="11sp"
                android:textColor="@color/hint_text"
                android:ellipsize="end"
                android:id="@+id/tvCreateTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="评论: 2025-11-24 12:48:49"
                android:maxLines="1"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:layout_toStartOf="@+id/actionButtonsLayout"
                android:layout_alignParentStart="true"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/actionButtonsLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/btnEdit"
                    android:background="@drawable/bg_ward_action_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp">
                    <TextView
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✏️"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/btnDelete"
                    android:background="@drawable/bg_ward_action_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="��️"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:id="@+id/btnShare"
                    android:background="@drawable/bg_ward_action_button"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp">
                    <TextView
                        android:textSize="14sp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="��"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:id="@+id/btnJump"
                    android:background="@drawable/bg_ward_jump_button_modern"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:minWidth="68dp"
                    android:text="查看"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</com.android.app.CustomCardView>
