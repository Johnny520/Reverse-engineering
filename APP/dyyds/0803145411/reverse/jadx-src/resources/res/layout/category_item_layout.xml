<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:background="@drawable/bg_category_item"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:paddingStart="12dp"
    android:paddingEnd="6dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp">
    <ImageView
        android:background="@drawable/bg_category_icon"
        android:padding="8dp"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/folder"
        android:tint="@color/douyin_primary"
        android:contentDescription="分类"/>
    <TextView
        android:textSize="15sp"
        android:textColor="@color/primary_text"
        android:ellipsize="end"
        android:id="@+id/tvCategoryName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="重要内容"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:layout_marginStart="12dp"/>
    <ImageView
        android:id="@+id/btnEditCategory"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_category_edit"
        android:tint="@color/secondary_text"
        android:contentDescription="编辑分类"/>
    <ImageView
        android:id="@+id/btnDeleteCategory"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_category_delete"
        android:tint="@color/warning_red"
        android:contentDescription="删除分类"/>
    <ImageView
        android:id="@+id/btnDragCategory"
        android:padding="9dp"
        android:layout_width="36dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_category_drag"
        android:tint="@color/hint_text"
        android:contentDescription="拖动排序"/>
</LinearLayout>
