<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_ward_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/bg_ward_handle"
            android:layout_width="36dp"
            android:layout_height="4dp"/>
    </LinearLayout>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:id="@+id/tv_emoji_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择我的收藏表情"
            android:layout_centerInParent="true"
            android:fontFamily="sans-serif-medium"/>
        <ImageView
            android:id="@+id/iv_emoji_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/close"
            android:tint="@color/primary_text"
            android:layout_centerVertical="true"
            android:contentDescription="关闭"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <TextView
        android:textSize="13sp"
        android:textColor="@color/hint_text"
        android:ellipsize="end"
        android:id="@+id/tv_emoji_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="8dp"
        android:text="读取当前账号聊天表情面板的爱心收藏"
        android:maxLines="2"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="13sp"
            android:textColor="@color/hint_text"
            android:id="@+id/tv_emoji_load_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="正在读取收藏表情…"
            android:layout_weight="1"/>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/douyin_primary"
            android:id="@+id/tv_emoji_selected_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已选 0 个"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/layout_emoji_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.android.app.CustomRecyclerView
            android:id="@+id/rv_emojis"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/hint_text"
            android:gravity="center"
            android:id="@+id/tv_emoji_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="正在读取收藏表情…"/>
    </FrameLayout>
    <View
        android:background="@color/divider_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_emoji_actions"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/primary_text"
            android:gravity="center"
            android:id="@+id/btn_emoji_cancel"
            android:background="@drawable/douyin_button_secondary2"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="取消"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"/>
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btn_emoji_confirm"
            android:background="@drawable/douyin_button_primary2"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="确定"
            android:layout_weight="1"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
