<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/dialog_root"
    android:background="@drawable/bg_douyin_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipToOutline="true">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="14dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <View
                android:background="@drawable/bg_douyin_dialog_indicator"
                android:layout_width="3dp"
                android:layout_height="20dp"/>
            <TextView
                android:textSize="19sp"
                android:textStyle="bold"
                android:textColor="@color/dialog_title_color"
                android:id="@+id/dialog_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="10dp"/>
        </LinearLayout>
        <TextView
            android:textSize="13sp"
            android:textColor="@color/dialog_message_color"
            android:id="@+id/dialog_message"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:includeFontPadding="false"
            android:lineSpacingExtra="3dp"
            android:layout_marginStart="13dp"/>
    </LinearLayout>
    <ScrollView
        android:scrollbarStyle="insideInset"
        android:id="@+id/scroll_view"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fadeScrollbars="true"
        android:overScrollMode="ifContentScrolls">
        <FrameLayout
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <RadioGroup
                android:orientation="vertical"
                android:id="@+id/radio_group"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/checkbox_layout"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </FrameLayout>
    </ScrollView>
    <View
        android:id="@+id/button_section_divider"
        android:background="@color/divider_color"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/button_container"
        android:paddingTop="16dp"
        android:paddingBottom="20dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/primary_text"
            android:gravity="center"
            android:id="@+id/button_left"
            android:background="@drawable/bg_douyin_choice_button_secondary"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
        <View
            android:id="@+id/button_divider"
            android:visibility="gone"
            android:layout_width="12dp"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:id="@+id/button_right"
            android:background="@drawable/douyin_button_primary"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>
</LinearLayout>
