<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_toast_bg"
    android:layout_width="330dp"
    android:layout_height="wrap_content"
    android:minWidth="120dp"
    android:minHeight="120dp">
    <FrameLayout
        android:gravity="center_vertical"
        android:id="@+id/header_drag_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp">
        <TextView
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#f4f6f8"
            android:ellipsize="end"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="25dp"
            android:layout_marginRight="25dp"
            android:text="视频右侧控件位置设置"/>
        <ImageView
            android:layout_gravity="end|center_vertical"
            android:id="@+id/btn_close"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_close"/>
    </FrameLayout>
    <View
        android:background="#20ffffff"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="vertical"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:background="?android:attr/selectableItemBackground"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/switch_music_follow"
                    android:layout_alignParentStart="true">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#f4f6f8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="音乐控件跟随设置"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/switch_music_follow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#f4f6f8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="水平偏移"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#eef2f6"
                    android:id="@+id/btn_x_minus"
                    android:background="@drawable/bg_video_preview_button"
                    android:padding="0dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="-"
                    android:layout_marginEnd="10dp"/>
                <EditText
                    android:textSize="12sp"
                    android:textColor="#eef2f6"
                    android:textColorHint="#99d3d7dd"
                    android:gravity="center"
                    android:id="@+id/et_translation_x"
                    android:background="@drawable/bg_video_preview_panel"
                    android:layout_width="78dp"
                    android:layout_height="30dp"
                    android:hint="0"
                    android:inputType="numberDecimal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"/>
                <Button
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#eef2f6"
                    android:id="@+id/btn_x_plus"
                    android:background="@drawable/bg_video_preview_button"
                    android:padding="0dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekbar_translation_x"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#f4f6f8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="垂直偏移"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#eef2f6"
                    android:id="@+id/btn_y_minus"
                    android:background="@drawable/bg_video_preview_button"
                    android:padding="0dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="-"
                    android:layout_marginEnd="10dp"/>
                <EditText
                    android:textSize="12sp"
                    android:textColor="#eef2f6"
                    android:textColorHint="#99d3d7dd"
                    android:gravity="center"
                    android:id="@+id/et_translation_y"
                    android:background="@drawable/bg_video_preview_panel"
                    android:layout_width="78dp"
                    android:layout_height="30dp"
                    android:hint="0"
                    android:inputType="numberDecimal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"/>
                <Button
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#eef2f6"
                    android:id="@+id/btn_y_plus"
                    android:background="@drawable/bg_video_preview_button"
                    android:padding="0dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekbar_translation_y"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="6dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="#f4f6f8"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="缩放比例"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#eef2f6"
                    android:id="@+id/btn_scale_minus"
                    android:background="@drawable/bg_video_preview_button"
                    android:padding="0dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="-"
                    android:layout_marginEnd="10dp"/>
                <EditText
                    android:textSize="12sp"
                    android:textColor="#eef2f6"
                    android:textColorHint="#99d3d7dd"
                    android:gravity="center"
                    android:id="@+id/et_scale"
                    android:background="@drawable/bg_video_preview_panel"
                    android:layout_width="78dp"
                    android:layout_height="30dp"
                    android:hint="1.0"
                    android:inputType="numberDecimal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"/>
                <Button
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#eef2f6"
                    android:id="@+id/btn_scale_plus"
                    android:background="@drawable/bg_video_preview_button"
                    android:padding="0dp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="+"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>
            <SeekBar
                android:id="@+id/seekbar_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <Button
                    android:textSize="12sp"
                    android:textColor="#eef2f6"
                    android:id="@+id/btn_preview"
                    android:background="@drawable/bg_video_preview_button"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="预览"
                    android:layout_weight="1"/>
                <Button
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#eef2f6"
                    android:id="@+id/btn_save"
                    android:background="@drawable/bg_video_preview_button"
                    android:layout_width="0dp"
                    android:layout_height="30dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="保存"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
