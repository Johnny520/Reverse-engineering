<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_ward_bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/bg_ward_handle"
            android:layout_width="40dp"
            android:layout_height="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary_text"
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="插眼统计"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"/>
        <ImageView
            android:id="@+id/ivCloseStats"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/close"
            android:tint="@color/primary_text"/>
    </LinearLayout>
    <LinearLayout
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">
        <LinearLayout
            android:orientation="horizontal"
            android:background="@drawable/bg_stats_card"
            android:padding="4dp"
            android:layout_width="match_parent"
            android:layout_height="48dp">
            <TextView
                android:textSize="15sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tabCategory"
                android:background="@drawable/bg_ward_filter_selected"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="分类统计"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginEnd="3dp"/>
            <TextView
                android:textSize="15sp"
                android:textColor="@color/secondary_text"
                android:gravity="center"
                android:id="@+id/tabUser"
                android:background="@drawable/bg_ward_filter_normal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="用户统计"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="3dp"/>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:background="@color/surface_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <com.android.app.CustomRecyclerView
            android:id="@+id/rvCategoryStats"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:visibility="visible"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <com.android.app.CustomRecyclerView
            android:id="@+id/rvUserStats"
            android:paddingTop="8dp"
            android:paddingBottom="20dp"
            android:visibility="gone"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/layoutEmptyStats"
            android:paddingBottom="40dp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="56sp"
                android:gravity="center"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:text="��"
                android:alpha="0.6"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="暂无统计数据"
                android:fontFamily="sans-serif-medium"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/secondary_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="开始插眼后将显示统计信息"
                android:alpha="0.7"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
