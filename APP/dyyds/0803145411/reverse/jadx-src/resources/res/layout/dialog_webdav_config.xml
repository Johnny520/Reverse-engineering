<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="服务器地址"/>
        <EditText
            android:textSize="16sp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:id="@+id/serverUrlEditText"
            android:background="@drawable/round_edit_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:hint="https://dav.example.com"
            android:inputType="textUri"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="用户名"/>
        <EditText
            android:textSize="16sp"
            android:textColor="@color/primary_text"
            android:textColorHint="@color/secondary_text"
            android:id="@+id/usernameEditText"
            android:background="@drawable/round_edit_bg"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:hint="请输入用户名"
            android:inputType="text"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"/>
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="密码"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="24dp">
            <EditText
                android:textSize="16sp"
                android:textColor="@color/primary_text"
                android:textColorHint="@color/secondary_text"
                android:id="@+id/passwordEditText"
                android:background="@drawable/round_edit_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="请输入密码"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="64dp"/>
            <ImageButton
                android:layout_gravity="end|center_vertical"
                android:id="@+id/passwordVisibilityToggle"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="14dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:src="@drawable/ic_visibility"
                android:scaleType="center"
                android:contentDescription="显示密码"/>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">
            <Button
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/douyin_white"
                android:id="@+id/testConnectionBtn"
                android:background="@drawable/douyin_button_secondary"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:text="测试连接"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"/>
            <Button
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/douyin_white"
                android:id="@+id/saveConfigBtn"
                android:background="@drawable/douyin_button_primary"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:text="保存配置"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
