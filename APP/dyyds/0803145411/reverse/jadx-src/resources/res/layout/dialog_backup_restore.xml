<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/surface_bg"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:overScrollMode="never">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/secondary_text"
            android:paddingBottom="7dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="本地备份"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_setting_group_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToOutline="true">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="9dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/secondary_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="数据范围"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/secondary_text"
                    android:gravity="center"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:text="恢复"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/secondary_text"
                    android:gravity="center"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:text="备份"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="68dp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="完整数据"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="配置 + 插眼 · ZIP"
                        android:maxLines="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/btn_import"
                    android:background="@drawable/bg_douyin_button_secondary_filled"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:text="导入"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/btn_export"
                    android:background="@drawable/bg_douyin_button_primary"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:text="导出"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="68dp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="模块配置"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="设置项 · JSON"
                        android:maxLines="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/btn_import_config"
                    android:background="@drawable/bg_douyin_button_secondary_filled"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:text="导入"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/btn_export_config"
                    android:background="@drawable/bg_douyin_button_primary"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:text="导出"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <View
                android:background="@color/divider_color"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="9dp"
                android:paddingBottom="9dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="68dp"
                android:paddingStart="16dp"
                android:paddingEnd="12dp">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_text"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="插眼数据"
                        android:maxLines="1"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="@color/secondary_text"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="记录与备注 · JSON"
                        android:maxLines="1"/>
                </LinearLayout>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/btn_import_ward"
                    android:background="@drawable/bg_douyin_button_secondary_filled"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:text="导入"
                    android:layout_marginStart="8dp"/>
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:id="@+id/btn_export_ward"
                    android:background="@drawable/bg_douyin_button_primary"
                    android:focusable="true"
                    android:clickable="true"
                    android:layout_width="58dp"
                    android:layout_height="36dp"
                    android:text="导出"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
