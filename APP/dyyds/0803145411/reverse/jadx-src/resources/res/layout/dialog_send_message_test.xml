<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_douyin_dialog"
    android:padding="20dp"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="发送消息测试"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="接收对象"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/message_type_layout"
        android:background="@drawable/bg_douyin_edittext"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/hint_text"
            android:ellipsize="end"
            android:id="@+id/tv_message_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="点击选择最近会话、好友或群聊"
            android:maxLines="1"
            android:layout_weight="1"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_right"
            android:tint="@color/hint_text"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="内容类型"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/content_type_layout"
        android:background="@drawable/bg_douyin_edittext"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="12dp">
        <TextView
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:id="@+id/tv_content_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="文本"
            android:layout_weight="1"/>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_right"
            android:tint="@color/hint_text"/>
    </LinearLayout>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="接收者ID（可长按复制）"/>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/primary_text"
        android:textColorHint="@color/hint_text"
        android:id="@+id/et_receiver_id"
        android:background="@drawable/bg_douyin_edittext"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:hint="请输入好友或群聊ID"
        android:inputType="text"
        android:paddingHorizontal="12dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/primary_text"
        android:id="@+id/tv_message_content_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="消息内容"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/layout_emoji_content"
        android:background="@drawable/bg_douyin_edittext"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="10dp">
        <ImageView
            android:id="@+id/iv_selected_emoji"
            android:visibility="gone"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:scaleType="fitCenter"
            android:contentDescription="已选表情"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp">
            <TextView
                android:textSize="14sp"
                android:textColor="@color/primary_text"
                android:id="@+id/tv_selected_emoji"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="点击选择我的收藏表情"/>
            <TextView
                android:textSize="11sp"
                android:textColor="@color/hint_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="仅收藏 / 大图表情"/>
        </LinearLayout>
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_right"
            android:tint="@color/hint_text"/>
    </LinearLayout>
    <EditText
        android:textSize="14sp"
        android:textColor="@color/primary_text"
        android:textColorHint="@color/hint_text"
        android:gravity="start|top"
        android:id="@+id/et_message_content"
        android:background="@drawable/bg_douyin_edittext"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_marginTop="8dp"
        android:hint="请输入要发送的消息内容"
        android:maxLines="5"
        android:inputType="textMultiLine"
        android:paddingHorizontal="12dp"
        android:paddingVertical="12dp"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <Button
            android:textSize="14sp"
            android:textColor="@color/primary_text"
            android:id="@+id/btn_cancel"
            android:background="@drawable/douyin_button_secondary2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="取消"
            android:layout_weight="1"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
        <Space
            android:layout_width="10dp"
            android:layout_height="wrap_content"/>
        <Button
            android:textSize="14sp"
            android:textColor="@color/douyin_white"
            android:id="@+id/btn_send"
            android:background="@drawable/douyin_button_primary2"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:text="发送"
            android:layout_weight="1"
            android:translationZ="0dp"
            android:elevation="0dp"
            android:stateListAnimator="@null"/>
    </LinearLayout>
</LinearLayout>
