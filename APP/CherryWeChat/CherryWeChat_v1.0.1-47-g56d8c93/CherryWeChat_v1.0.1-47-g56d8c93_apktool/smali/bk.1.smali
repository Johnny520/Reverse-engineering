.class public final Lbk;
.super Lqv;
.source ""


# instance fields
.field public e:I

.field public f:I


# direct methods
.method public constructor <init>(II)V
    .locals 0

    invoke-direct {p0, p1, p2}, Lqv;-><init>(II)V

    const/4 p1, -0x1

    iput p1, p0, Lbk;->e:I

    const/4 p1, 0x0

    iput p1, p0, Lbk;->f:I

    return-void
.end method
