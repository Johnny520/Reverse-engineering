<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/colorBackground"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="24dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="start|center_vertical"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">
            <TextView
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/textTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:singleLine="true"
                android:layout_weight="1"/>
            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@mipmap/ic_github"
                android:tint="@color/textSecondary"
                android:alpha="0.8"
                android:layout_marginEnd="4dp"
                style="?android:attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/module_state"
            android:background="@drawable/bg_status_card"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="2dp">
            <androidx.constraintlayout.utils.widget.ImageFilterView
                android:id="@+id/main_img_status"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@mipmap/ic_warn"
                android:tint="@color/white"
                android:layout_marginEnd="12dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/main_text_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/module_not_activated"
                    android:singleLine="true"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/main_text_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/module_version"
                    android:singleLine="true"
                    android:alpha="0.9"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_card_modern"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:elevation="1dp">
            <LinearLayout
                android:gravity="start|center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/textTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/display_settings"
                    android:singleLine="true"
                    android:layout_weight="1"/>
            </LinearLayout>
            <io.github.cherrywechat.p002ui.MaterialSwitch
                android:textSize="15sp"
                android:textColor="@color/textTitle"
                android:id="@+id/hide_icon_in_launcher_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/hide_app_icon_on_launcher"
                android:textAllCaps="false"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/textSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/hide_app_icon_on_launcher_tip"
                android:lineSpacingExtra="4dp"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/colorError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hide_app_icon_on_launcher_notice"
                android:lineSpacingExtra="4dp"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <Button
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/buttonTextPrimary"
                android:id="@+id/btn2"
                android:background="@drawable/bg_button_modern"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginBottom="12dp"
                android:text="重启微信"/>
            <Button
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/buttonTextPrimary"
                android:id="@+id/btn3"
                android:background="@drawable/bg_button_modern"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="进入测试页面"/>
        </LinearLayout>
        <TextView
            android:id="@+id/test_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
