<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_width="350dp"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="17dp"
        android:textStyle="bold"
        android:textColor="@color/______res_0x4006033a"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="提示"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <EditText
            android:textColor="@color/______res_0x4006033a"
            android:textColorHint="@color/______res_0x4006033d"
            android:id="@+id/_____res_0x400901f6"
            android:background="#00000000"
            android:padding="5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="输入Json格式消息内容"
            android:maxLines="16"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="right"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">
        <android.widget.Button
            android:textColor="@color/______res_0x4006033a"
            android:id="@+id/______res_0x400901f5"
            android:background="@drawable/_____res_0x4008007b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="发送"/>
    </LinearLayout>
</LinearLayout>
