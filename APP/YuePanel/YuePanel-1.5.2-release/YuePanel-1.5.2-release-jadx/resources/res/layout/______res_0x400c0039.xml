<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/______res_0x4006033a"
        android:gravity="center"
        android:id="@+id/______res_0x40090278"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请输入内容"/>
    <EditText
        android:textSize="16sp"
        android:textColor="@color/______res_0x4006033a"
        android:textColorHint="@color/______res_0x4006033b"
        android:id="@+id/______res_0x400900e8"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:hint="请输入"
        android:singleLine="true"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp">
        <TextView
            android:textSize="16sp"
            android:textColor="@color/______res_0x4006033a"
            android:gravity="center"
            android:id="@+id/______res_0x40090077"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:text="取消"
            android:layout_weight="1"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/______res_0x4006033a"
            android:gravity="center"
            android:id="@+id/______res_0x40090078"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:text="确定"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>
