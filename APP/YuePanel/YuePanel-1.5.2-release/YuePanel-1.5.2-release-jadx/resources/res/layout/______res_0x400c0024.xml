<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/______res_0x4006033a"
            android:id="@+id/______res_0x400900a5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="文字消息"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/______res_0x4006033a"
            android:id="@+id/______res_0x40090097"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:text="评论内容"
            android:maxLines="7"/>
        <LinearLayout
            android:gravity="right"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1">
                <TextView
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/______res_0x40060327"
                    android:id="@+id/______res_0x400900a6"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="评论账号:YueXin"
                    android:singleLine="true"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="0">
                <TextView
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/______res_0x4006004e"
                    android:id="@+id/______res_0x400900a3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="5dp"
                    android:text="检测中"/>
                <TextView
                    android:textSize="10dp"
                    android:textStyle="bold"
                    android:textColor="@color/______res_0x4006008a"
                    android:id="@+id/_____res_0x400900a4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="发送时间"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:background="@color/______res_0x4006033b"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"/>
</LinearLayout>
