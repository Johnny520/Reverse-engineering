<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="10dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/______res_0x4009009a"
            android:layout_width="160px"
            android:layout_height="160px"/>
        <TextView
            android:textSize="18dp"
            android:textStyle="bold"
            android:textColor="@color/______res_0x4006033a"
            android:id="@+id/______res_0x4009009f"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="名字"/>
    </LinearLayout>
    <View
        android:background="@color/______res_0x4006033d"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="5dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/______res_0x4006033a"
            android:gravity="center"
            android:id="@+id/______res_0x4009009d"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="点赞\109999"
            android:layout_weight="1"/>
        <TextView
            android:textSize="15dp"
            android:textStyle="bold"
            android:textColor="@color/______res_0x4006033a"
            android:gravity="center"
            android:id="@+id/______res_0x400900a0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="回复\109999"
            android:layout_weight="1"/>
    </LinearLayout>
    <View
        android:background="@color/______res_0x4006033d"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"/>
    <TextView
        android:textSize="13dp"
        android:textStyle="bold"
        android:textColor="@color/______res_0x4006033a"
        android:id="@+id/______res_0x4009009c"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="评论内容"
        android:maxLines="10"/>
    <View
        android:background="@color/______res_0x4006033d"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="10dp"/>
    <LinearLayout
        android:gravity="right"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <android.widget.Button
            android:id="@+id/_____res_0x40090099"
            android:background="@drawable/_____res_0x4008007b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="保存图片"/>
        <android.widget.Button
            android:id="@+id/______res_0x400900a1"
            android:background="@drawable/_____res_0x4008007b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="保存语音"/>
        <android.widget.Button
            android:id="@+id/______res_0x400900a2"
            android:background="@drawable/_____res_0x4008007b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="保存XX"/>
        <android.widget.Button
            android:id="@+id/______res_0x4009009b"
            android:background="@drawable/_____res_0x4008007b"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:text="更多信息"/>
    </LinearLayout>
</LinearLayout>
