<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="right"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <NumberPicker
                android:textColor="@color/______res_0x4006033a"
                android:id="@+id/_____res_0x40090192"
                android:layout_width="80dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/______res_0x4006033a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="小时"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="15dp">
            <NumberPicker
                android:textColor="@color/______res_0x4006033a"
                android:id="@+id/______res_0x40090193"
                android:layout_width="80dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/______res_0x4006033a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分钟"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <NumberPicker
                android:textColor="@color/______res_0x4006033a"
                android:id="@+id/______res_0x40090194"
                android:layout_width="80dp"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/______res_0x4006033a"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="秒"/>
        </LinearLayout>
    </LinearLayout>
    <android.widget.Button
        android:id="@+id/______res_0x400900da"
        android:background="@drawable/_____res_0x4008007b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="确认"/>
</LinearLayout>
