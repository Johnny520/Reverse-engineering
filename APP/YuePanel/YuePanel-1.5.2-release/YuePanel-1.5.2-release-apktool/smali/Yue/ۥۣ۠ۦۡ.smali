.class public LYue/ۥۣ۠ۦۡ;
.super LYue/ۥ۟ۡۨۥ;
.source "SourceFile"


# direct methods
.method public constructor <init>(LYue/ۥۣ۟ۥۨ;)V
    .locals 0

    invoke-direct {p0, p1}, LYue/ۥ۟ۡۨۥ;-><init>(LYue/ۥۣ۟ۥۨ;)V

    return-void
.end method


# virtual methods
.method public ۥ۟۟(LYue/ۥۣۣۢ۟;)V
    .locals 1

    invoke-super {p0, p1}, LYue/ۥ۟ۡۨۥ;->ۥ۟۟(LYue/ۥۣۣۢ۟;)V

    iget v0, p1, LYue/ۥۣۣۢ۟;->ۥ۟۟۟ۧ:I

    add-int/lit8 v0, v0, -0x1

    iput v0, p1, LYue/ۥۣۣۢ۟;->ۥ۟۟۟ۧ:I

    return-void
.end method
